module dios.core.diskutil;

/**
 * Disk preparation for an installer: partition tables and FAT32 volumes. Shell commands
 * (the handlers at the end of this file):
 *
 *   ptable DISK gpt|mbr yes     new, empty partition table (everything on the disk is lost)
 *   padd DISK SIZE [esp|data]   new partition in the first free space that is big enough
 *                               (SIZE: MiB, or "rest" for the biggest free area)
 *   pdel N yes                  delete partition N (the number in brackets in 'disk')
 *   mkfs N [LABEL] yes          format partition N as FAT32
 *
 * Partitions start on 1 MiB boundaries. GPT (128 entries of 128 bytes, primary and backup
 * copy, CRC32 checked) and classic MBR (four primary partitions) are written; for GPT a
 * protective MBR is kept in sector 0. The commands that destroy data only run when the
 * word "yes" ends the command line, and never touch a mounted volume.
 *
 * The FAT32 layout is the usual one: 32 reserved sectors with the FSInfo sector at 1 and a
 * backup of both at 6 and 7, two FAT copies, the root directory in cluster 2, and the
 * cluster size picked by volume size like Windows does. The boot sector is written last,
 * so an interrupted format never leaves a volume that looks valid.
 *
 *   biosinstall DISK [N] yes    Limine BIOS boot code (what "limine bios-install" does): boot
 *                               sector in sector 0, stage 1.5 in the BIOS boot partition (GPT) or
 *                               in the gap after the MBR. The code is the boot module
 *                               limine-bios-hdd.bin (the file Limine embeds in its own tool).
 */
import dios.bootloader.limine;
import dios.core.blockdev;
import dios.core.clock;
import dios.core.cpu;
import dios.core.csprng;
import dios.core.exfat;
import dios.core.fat32;
import dios.core.fs;
import dios.core.mem;
import dios.core.stdio;

enum int DU_OK = 0;
enum int DU_ERR_NO_DISK = -1;           // no such disk
enum int DU_ERR_READONLY = -2;          // the driver cannot write to it
enum int DU_ERR_IO = -3;
enum int DU_ERR_MOUNTED = -4;           // a volume of that disk is mounted
enum int DU_ERR_NO_TABLE = -5;          // the disk has no partition table (or none of the kind needed)
enum int DU_ERR_GPT_BAD = -6;           // GPT damaged or in a layout this code does not edit
enum int DU_ERR_FULL = -7;              // no free partition table entry
enum int DU_ERR_NO_SPACE = -8;          // no free area that big
enum int DU_ERR_TOO_SMALL = -9;
enum int DU_ERR_TOO_BIG = -10;
enum int DU_ERR_BAD_ARG = -11;
enum int DU_ERR_NO_PART = -12;          // no such partition
enum int DU_ERR_VERIFY = -13;           // the new volume does not mount
enum int DU_ERR_BAD_LABEL = -14;
enum int DU_ERR_LIST_FULL = -15;        // the kernel's partition list is full
enum int DU_ERR_BAD_BLOB = -16;         // the boot code image is not what it should be
enum int DU_ERR_NO_BIOS_PART = -17;     // GPT without a (suitable) BIOS boot partition
enum int DU_ERR_HAS_FS = -18;           // the target area holds a file system
enum int DU_ERR_MBR_LOW = -19;          // an MBR partition starts below LBA 63
enum int DU_ERR_NO_ROOM = -20;          // the boot code does not fit where it has to go

enum uint DU_ALIGN_BYTES = 1024 * 1024;
enum uint DU_GPT_ENTRIES = 128;
enum uint DU_GPT_ENTRY_SIZE = 128;
enum uint DU_GPT_BYTES = DU_GPT_ENTRIES * DU_GPT_ENTRY_SIZE;    // 16 KiB: 32 sectors of 512, 4 of 4096
enum ulong DU_MIN_FAT32_CLUSTERS = 65525;

enum uint DU_TABLE_NONE = 0;
enum uint DU_TABLE_MBR = 1;
enum uint DU_TABLE_GPT = 2;

struct DuRange
{
    ulong first;
    ulong last;
}

__gshared ubyte[4096] duSector;         // one sector of the disk
__gshared ubyte[DU_GPT_BYTES] duEntries;    // the GPT entry array
__gshared ubyte[4096] duBoot;            // sector 0 as found
__gshared ubyte[4096] duProbe;
__gshared ubyte[65536] duZero;          // stays all zero
__gshared DuRange[DU_GPT_ENTRIES + 2] duRanges;
__gshared uint[256] duCrcTable;
__gshared bool duCrcReady;
__gshared ulong duRngState;
__gshared ExfatVolume duVerify;         // scratch volume for checking a new file system


const(char)* duErrorText(int err) @nogc nothrow
{
    switch (err)
    {
        case DU_ERR_NO_DISK: return "no such disk";
        case DU_ERR_READONLY: return "this disk cannot be written to";
        case DU_ERR_IO: return "disk I/O error";
        case DU_ERR_MOUNTED: return "a volume on that disk is mounted ('umount' it first; it must not be the root)";
        case DU_ERR_NO_TABLE: return "the disk has no suitable partition table ('ptable DISK gpt yes' makes one)";
        case DU_ERR_GPT_BAD: return "the GPT is damaged or uses an unsupported layout (needs 128 entries of 128 bytes)";
        case DU_ERR_FULL: return "the partition table has no free entry";
        case DU_ERR_NO_SPACE: return "no free area that big on the disk";
        case DU_ERR_TOO_SMALL: return "too small (FAT32 needs at least 65525 clusters: about 33 MiB on 512-byte-sector disks, 256 MiB on 4096-byte ones)";
        case DU_ERR_TOO_BIG: return "too big for this tool (FAT32 volumes are limited to 2 TiB here)";
        case DU_ERR_BAD_ARG: return "bad argument";
        case DU_ERR_NO_PART: return "no such partition";
        case DU_ERR_VERIFY: return "the new volume does not mount: something is wrong with the layout written";
        case DU_ERR_BAD_LABEL: return "bad label: up to 11 characters of A-Z 0-9 space - _";
        case DU_ERR_LIST_FULL: return "the kernel's partition list is full";
        case DU_ERR_BAD_BLOB: return "no usable limine-bios-hdd.bin boot module (add 'module_path: boot():/limine-bios-hdd.bin' to limine.conf)";
        case DU_ERR_NO_BIOS_PART: return "no BIOS boot partition on this GPT disk ('padd DISK bios' makes one)";
        case DU_ERR_HAS_FS: return "the place for the boot code looks like a file system, not touching it";
        case DU_ERR_MBR_LOW: return "an MBR partition starts below sector 63: no room for the boot code";
        case DU_ERR_NO_ROOM: return "the boot code does not fit in the BIOS boot partition / the MBR gap";
        default: return "unknown error";
    }
}

// ---------------------------------------------------------------------------
// small helpers
// ---------------------------------------------------------------------------

void duPut16(ubyte* p, uint v) @nogc nothrow
{
    p[0] = cast(ubyte)v;
    p[1] = cast(ubyte)(v >> 8);
}

void duPut32(ubyte* p, uint v) @nogc nothrow
{
    p[0] = cast(ubyte)v;
    p[1] = cast(ubyte)(v >> 8);
    p[2] = cast(ubyte)(v >> 16);
    p[3] = cast(ubyte)(v >> 24);
}

void duPut64(ubyte* p, ulong v) @nogc nothrow
{
    duPut32(p, cast(uint)v);
    duPut32(p + 4, cast(uint)(v >> 32));
}

ulong duAlignUp(ulong x, ulong a) @nogc nothrow
{
    return (x + a - 1) / a * a;
}

ulong duAlignSectors(uint sectorSize) @nogc nothrow
{
    ulong a = DU_ALIGN_BYTES / sectorSize;
    return a == 0 ? 1 : a;
}

/// 64 random bits: RDRAND when the CPU has it, else a time-seeded xorshift.
ulong duRandom64() @nogc nothrow
{
    ulong v;
    if (cpuHasRdrand() && rdrand64(&v))
        return v;
    if (duRngState == 0)
        duRngState = clockNowNs() | 1;
    duRngState ^= clockNowNs();
    duRngState ^= duRngState << 13;
    duRngState ^= duRngState >> 7;
    duRngState ^= duRngState << 17;
    return duRngState * 0x2545F4914F6CDD1DUL;
}

void duRandomGuid(ubyte* g) @nogc nothrow
{
    duPut64(g, duRandom64());
    duPut64(g + 8, duRandom64());
    g[7] = (g[7] & 0x0F) | 0x40;        // version 4 (random)
    g[8] = (g[8] & 0x3F) | 0x80;        // RFC 4122 variant
}

uint duCrc32(const(ubyte)* p, size_t n) @nogc nothrow
{
    if (!duCrcReady)
    {
        for (uint i = 0; i < 256; i++)
        {
            uint c = i;
            for (uint k = 0; k < 8; k++)
                c = (c & 1) ? (0xEDB88320u ^ (c >> 1)) : (c >> 1);
            duCrcTable[i] = c;
        }
        duCrcReady = true;
    }
    uint crc = 0xFFFFFFFFu;
    for (size_t i = 0; i < n; i++)
        crc = duCrcTable[(crc ^ p[i]) & 0xFF] ^ (crc >> 8);
    return ~crc;
}

bool duZeroRange(BlockDev* b, ulong lba, ulong count) @nogc nothrow
{
    uint chunk = cast(uint)(duZero.length / b.sectorSize);
    while (count != 0)
    {
        uint n = count < chunk ? cast(uint)count : chunk;
        if (!blockWrite(b, lba, n, duZero.ptr))
            return false;
        lba += n;
        count -= n;
    }
    return true;
}

bool duDiskHasMounts(BlockDev* b) @nogc nothrow
{
    uint idx = blockDevIndex(b);
    for (uint i = 0; i < partitionCount; i++)
        if (partitions[i].valid && partitions[i].dev == idx && fsMountOfPartition(i) >= 0)
            return true;
    return false;
}

bool duDiskIsWhole(BlockDev* b) @nogc nothrow
{
    uint idx = blockDevIndex(b);
    for (uint i = 0; i < partitionCount; i++)
        if (partitions[i].valid && partitions[i].dev == idx && partitions[i].whole)
            return true;
    return false;
}

// ---------------------------------------------------------------------------
// free space
// ---------------------------------------------------------------------------

/// Find free space among the `n` used ranges in duRanges, inside [lo, hi]. `want` sectors
/// (first fit), or with want == 0 the biggest free area. Starts are aligned; with want == 0
/// the end is aligned down too.
bool duFindGap(uint n, ulong lo, ulong hi, ulong want, ulong alignTo, ulong* outFirst, ulong* outLast) @nogc nothrow
{
    // sort by start (n is small)
    for (uint i = 1; i < n; i++)
    {
        DuRange r = duRanges[i];
        uint j = i;
        while (j > 0 && duRanges[j - 1].first > r.first)
        {
            duRanges[j] = duRanges[j - 1];
            j--;
        }
        duRanges[j] = r;
    }

    bool found = false;
    ulong bestFirst = 0;
    ulong bestLast = 0;
    ulong cursor = duAlignUp(lo, alignTo);
    for (uint i = 0; i <= n; i++)
    {
        ulong gapEnd = (i < n) ? (duRanges[i].first == 0 ? 0 : duRanges[i].first - 1) : hi;
        bool hasGap = (i == n) ? (hi >= cursor) : (duRanges[i].first > cursor);
        if (hasGap && gapEnd >= cursor)
        {
            if (want != 0)
            {
                if (gapEnd - cursor + 1 >= want)
                {
                    *outFirst = cursor;
                    *outLast = cursor + want - 1;
                    return true;
                }
            }
            else
            {
                ulong end = gapEnd;
                ulong endAligned = (end + 1) / alignTo * alignTo;       // first sector after the last whole unit
                if (endAligned > cursor)
                    end = endAligned - 1;
                if (end >= cursor && end - cursor + 1 >= alignTo &&
                    (!found || end - cursor > bestLast - bestFirst))
                {
                    found = true;
                    bestFirst = cursor;
                    bestLast = end;
                }
            }
        }
        if (i < n)
        {
            ulong next = duAlignUp(duRanges[i].last + 1, alignTo);
            if (next > cursor)
                cursor = next;
        }
    }
    if (found)
    {
        *outFirst = bestFirst;
        *outLast = bestLast;
    }
    return found;
}

// ---------------------------------------------------------------------------
// GPT
// ---------------------------------------------------------------------------

/// Fill duSector with a GPT header.
void duBuildGptHeader(BlockDev* b, ulong current, ulong other, ulong entriesLba, const(ubyte)* guid, uint entriesCrc) @nogc nothrow
{
    uint ss = b.sectorSize;
    uint entSectors = DU_GPT_BYTES / ss;
    ulong last = b.sectors - 1;

    memset(duSector.ptr, 0, ss);
    const(char)* sig = "EFI PART";
    for (uint i = 0; i < 8; i++)
        duSector[i] = cast(ubyte)sig[i];
    duPut32(duSector.ptr + 8, 0x00010000);                  // revision 1.0
    duPut32(duSector.ptr + 12, 92);                         // header size
    duPut64(duSector.ptr + 24, current);
    duPut64(duSector.ptr + 32, other);
    duPut64(duSector.ptr + 40, 2 + entSectors);             // first usable LBA
    duPut64(duSector.ptr + 48, last - entSectors - 1);      // last usable LBA
    memcpy(duSector.ptr + 56, guid, 16);
    duPut64(duSector.ptr + 72, entriesLba);
    duPut32(duSector.ptr + 80, DU_GPT_ENTRIES);
    duPut32(duSector.ptr + 84, DU_GPT_ENTRY_SIZE);
    duPut32(duSector.ptr + 88, entriesCrc);
    duPut32(duSector.ptr + 16, duCrc32(duSector.ptr, 92));  // CRC of the header, computed with this field zero
}

/// Write duEntries and both headers (backup first, so the primary stays the last word).
int duWriteGpt(BlockDev* b, const(ubyte)* guid) @nogc nothrow
{
    uint ss = b.sectorSize;
    uint entSectors = DU_GPT_BYTES / ss;
    ulong last = b.sectors - 1;
    uint entriesCrc = duCrc32(duEntries.ptr, DU_GPT_BYTES);

    if (!blockWrite(b, last - entSectors, entSectors, duEntries.ptr))
        return DU_ERR_IO;
    duBuildGptHeader(b, last, 1, last - entSectors, guid, entriesCrc);
    if (!blockWrite(b, last, 1, duSector.ptr))
        return DU_ERR_IO;
    if (!blockWrite(b, 2, entSectors, duEntries.ptr))
        return DU_ERR_IO;
    duBuildGptHeader(b, 1, last, 2, guid, entriesCrc);
    if (!blockWrite(b, 1, 1, duSector.ptr))
        return DU_ERR_IO;
    return DU_OK;
}

/// Read and check the primary GPT: duEntries gets the entry array, `guid` the disk GUID.
int duReadGpt(BlockDev* b, ulong* firstUsable, ulong* lastUsable, ubyte* guid) @nogc nothrow
{
    uint ss = b.sectorSize;
    if (!blockRead(b, 1, 1, duSector.ptr))
        return DU_ERR_IO;
    const(char)* sig = "EFI PART";
    for (uint i = 0; i < 8; i++)
        if (duSector[i] != cast(ubyte)sig[i])
            return DU_ERR_NO_TABLE;

    uint headerSize = blkLe32(duSector.ptr + 12);
    if (headerSize < 92 || headerSize > ss)
        return DU_ERR_GPT_BAD;
    uint storedCrc = blkLe32(duSector.ptr + 16);
    duPut32(duSector.ptr + 16, 0);
    uint crc = duCrc32(duSector.ptr, headerSize);
    duPut32(duSector.ptr + 16, storedCrc);
    if (crc != storedCrc)
        return DU_ERR_GPT_BAD;

    ulong entriesLba = blkLe64(duSector.ptr + 72);
    if (blkLe32(duSector.ptr + 80) != DU_GPT_ENTRIES || blkLe32(duSector.ptr + 84) != DU_GPT_ENTRY_SIZE)
        return DU_ERR_GPT_BAD;
    *firstUsable = blkLe64(duSector.ptr + 40);
    *lastUsable = blkLe64(duSector.ptr + 48);
    uint entriesCrc = blkLe32(duSector.ptr + 88);
    memcpy(guid, duSector.ptr + 56, 16);

    if (!blockRead(b, entriesLba, DU_GPT_BYTES / ss, duEntries.ptr))
        return DU_ERR_IO;
    if (duCrc32(duEntries.ptr, DU_GPT_BYTES) != entriesCrc)
        return DU_ERR_GPT_BAD;
    return DU_OK;
}

bool duEntryEmpty(const(ubyte)* e) @nogc nothrow
{
    for (uint k = 0; k < 16; k++)
        if (e[k] != 0)
            return false;
    return true;
}

// ---------------------------------------------------------------------------
// partition tables
// ---------------------------------------------------------------------------

/// What kind of table does the disk carry? (Not meaningful for a disk that is one volume.)
uint duTableKind(BlockDev* b) @nogc nothrow
{
    if (!blockRead(b, 0, 1, duSector.ptr))
        return DU_TABLE_NONE;
    if (duSector[510] != 0x55 || duSector[511] != 0xAA)
        return DU_TABLE_NONE;
    for (uint i = 0; i < 4; i++)
        if (duSector[446 + i * 16 + 4] == 0xEE)
            return DU_TABLE_GPT;
    return DU_TABLE_MBR;
}

BlockDev* duFindDisk(const(char)* name) @nogc nothrow
{
    for (uint i = 0; i < blockDevCount; i++)
    {
        if (!blockDevs[i].present)
            continue;
        const(char)* n = blockDevs[i].name.ptr;
        uint k = 0;
        while (n[k] != 0 && n[k] == name[k])
            k++;
        if (n[k] == 0 && name[k] == 0)
            return &blockDevs[i];
    }
    return null;
}

/// Forget the partitions of a disk and read its table again. Nothing on it may be mounted
/// (mounts refer to partitions by number).
void duRescan(BlockDev* b) @nogc nothrow
{
    uint idx = blockDevIndex(b);
    for (uint i = 0; i < partitionCount; i++)
        if (partitions[i].valid && partitions[i].dev == idx)
            partitions[i].valid = false;
    blockCacheInvalidate(idx);
    blockScanPartitions(b);
}

/// A new, empty partition table. type: DU_TABLE_GPT or DU_TABLE_MBR.
int duCreateTable(BlockDev* b, uint type) @nogc nothrow
{
    if (b is null || !b.present)
        return DU_ERR_NO_DISK;
    if (b.write is null)
        return DU_ERR_READONLY;
    if (duDiskHasMounts(b))
        return DU_ERR_MOUNTED;
    uint ss = b.sectorSize;
    if (ss < 512 || ss > 4096 || b.sectors < 4096)
        return DU_ERR_TOO_SMALL;

    ulong last = b.sectors - 1;
    if (type == DU_TABLE_GPT)
    {
        ubyte[16] guid;
        duRandomGuid(guid.ptr);
        memset(duEntries.ptr, 0, DU_GPT_BYTES);
        int r = duWriteGpt(b, guid.ptr);
        if (r != DU_OK)
            return r;

        // protective MBR, last: one 0xEE partition over the whole disk
        memset(duSector.ptr, 0, ss);
        ubyte* e = duSector.ptr + 446;
        e[1] = 0x00; e[2] = 0x02; e[3] = 0x00;              // CHS of LBA 1
        e[4] = 0xEE;
        e[5] = 0xFF; e[6] = 0xFF; e[7] = 0xFF;
        duPut32(e + 8, 1);
        duPut32(e + 12, last > 0xFFFFFFFFUL ? 0xFFFFFFFFu : cast(uint)last);
        duSector[510] = 0x55;
        duSector[511] = 0xAA;
        if (!blockWrite(b, 0, 1, duSector.ptr))
            return DU_ERR_IO;
    }
    else if (type == DU_TABLE_MBR)
    {
        // remove what an earlier GPT left behind: its header and the backup at the end
        if (!duZeroRange(b, 1, 1) || !duZeroRange(b, last, 1))
            return DU_ERR_IO;
        memset(duSector.ptr, 0, ss);
        duPut32(duSector.ptr + 440, cast(uint)duRandom64());   // disk signature
        duSector[510] = 0x55;
        duSector[511] = 0xAA;
        if (!blockWrite(b, 0, 1, duSector.ptr))
            return DU_ERR_IO;
    }
    else
        return DU_ERR_BAD_ARG;

    blockFlush(b);
    duRescan(b);
    return DU_OK;
}

/// BIOS boot partition GUID (21686148-6449-6E6F-744E-656564454649), for Limine/GRUB stage 2 on GPT.
immutable ubyte[16] DU_GUID_BIOS_BOOT = [0x48, 0x61, 0x68, 0x21, 0x49, 0x64, 0x6F, 0x6E, 0x74, 0x4E, 0x65, 0x65, 0x64, 0x45, 0x46, 0x49];

/// Add a partition of `sizeMiB` MiB (0 = the biggest free area). `esp`: EFI system partition,
/// else a data partition (what FAT32 lives in). Returns the new partition's number
/// (index in `partitions`) or an error.
int duAddPartition(BlockDev* b, ulong sizeMiB, bool esp, bool bios = false) @nogc nothrow
{
    if (b is null || !b.present)
        return DU_ERR_NO_DISK;
    if (b.write is null)
        return DU_ERR_READONLY;
    uint ss = b.sectorSize;
    if (ss < 512 || ss > 4096)
        return DU_ERR_BAD_ARG;
    if (duDiskIsWhole(b))
        return DU_ERR_NO_TABLE;

    ulong alignTo = duAlignSectors(ss);
    ulong want = sizeMiB * (DU_ALIGN_BYTES / ss);
    if (sizeMiB != 0 && want / (DU_ALIGN_BYTES / ss) != sizeMiB)
        return DU_ERR_BAD_ARG;

    uint kind = duTableKind(b);
    ulong start;
    ulong end;
    string kindName;
    ubyte mbrType = 0;
    bool gpt = false;

    if (kind == DU_TABLE_GPT)
    {
        ulong firstUsable, lastUsable;
        ubyte[16] guid;
        int r = duReadGpt(b, &firstUsable, &lastUsable, guid.ptr);
        if (r != DU_OK)
            return r;

        uint n = 0;
        int freeSlot = -1;
        for (uint i = 0; i < DU_GPT_ENTRIES; i++)
        {
            const(ubyte)* e = duEntries.ptr + i * DU_GPT_ENTRY_SIZE;
            if (duEntryEmpty(e))
            {
                if (freeSlot < 0)
                    freeSlot = cast(int)i;
                continue;
            }
            duRanges[n].first = blkLe64(e + 32);
            duRanges[n].last = blkLe64(e + 40);
            n++;
        }
        if (freeSlot < 0)
            return DU_ERR_FULL;
        if (bios)
        {
            // the gap in front of the first 1 MiB boundary: LBA 34 .. 2047 on 512-byte sectors
            start = firstUsable;
            end = alignTo - 1;
            if (end <= start)
                return DU_ERR_NO_SPACE;
            for (uint i = 0; i < n; i++)
                if (duRanges[i].first <= end && duRanges[i].last >= start)
                    return DU_ERR_NO_SPACE;
        }
        else if (!duFindGap(n, firstUsable, lastUsable, want, alignTo, &start, &end))
            return DU_ERR_NO_SPACE;

        ubyte* e = duEntries.ptr + cast(uint)freeSlot * DU_GPT_ENTRY_SIZE;
        memset(e, 0, DU_GPT_ENTRY_SIZE);
        memcpy(e, bios ? DU_GUID_BIOS_BOOT.ptr : (esp ? GUID_EFI_SYSTEM.ptr : GUID_BASIC_DATA.ptr), 16);
        duRandomGuid(e + 16);
        duPut64(e + 32, start);
        duPut64(e + 40, end);
        const(char)* name = bios ? "BOOT" : (esp ? "EFI System" : "DIOS");
        for (uint i = 0; name[i] != 0; i++)
            e[56 + i * 2] = cast(ubyte)name[i];             // UTF-16LE, ASCII only
        r = duWriteGpt(b, guid.ptr);
        if (r != DU_OK)
            return r;
        gpt = true;
        kindName = bios ? "BIOS boot\0" : (esp ? "EFI system\0" : "basic data (FAT/exFAT/NTFS)\0");
    }
    else if (kind == DU_TABLE_MBR)
    {
        if (bios)
            return DU_ERR_BAD_ARG;          // a BIOS boot partition is a GPT thing
        if (duSector[510] != 0x55)      // (duTableKind left sector 0 in duSector)
            return DU_ERR_NO_TABLE;
        int freeSlot = -1;
        uint n = 0;
        for (uint i = 0; i < 4; i++)
        {
            const(ubyte)* e = duSector.ptr + 446 + i * 16;
            uint cnt = blkLe32(e + 12);
            if (e[4] == 0 || cnt == 0)
            {
                if (freeSlot < 0)
                    freeSlot = cast(int)i;
                continue;
            }
            duRanges[n].first = blkLe32(e + 8);
            duRanges[n].last = cast(ulong)blkLe32(e + 8) + cnt - 1;
            n++;
        }
        if (freeSlot < 0)
            return DU_ERR_FULL;
        ulong hi = b.sectors - 1;
        if (hi > 0xFFFFFFFFUL)
            hi = 0xFFFFFFFFUL;
        if (!duFindGap(n, alignTo, hi, want, alignTo, &start, &end))
            return DU_ERR_NO_SPACE;
        if (end - start + 1 > 0xFFFFFFFFUL)
            return DU_ERR_TOO_BIG;

        mbrType = esp ? 0xEF : 0x0C;
        ubyte* e = duSector.ptr + 446 + cast(uint)freeSlot * 16;
        memset(e, 0, 16);
        e[1] = 0xFE; e[2] = 0xFF; e[3] = 0xFF;              // CHS: not used, "beyond the CHS limit"
        e[4] = mbrType;
        e[5] = 0xFE; e[6] = 0xFF; e[7] = 0xFF;
        duPut32(e + 8, cast(uint)start);
        duPut32(e + 12, cast(uint)(end - start + 1));
        if (!blockWrite(b, 0, 1, duSector.ptr))
            return DU_ERR_IO;
        kindName = mbrTypeName(mbrType);
    }
    else
        return DU_ERR_NO_TABLE;

    blockFlush(b);
    Partition* p = partAdd(b, start, end - start + 1, gpt, mbrType, false, kindName);
    if (p is null)
        return DU_ERR_LIST_FULL;        // the table on disk is right; 'disk' shows it after a rescan
    return cast(int)(p - partitions.ptr);
}

/// Remove partition `index` from its disk's table.
int duDeletePartition(uint index) @nogc nothrow
{
    if (index >= partitionCount || !partitions[index].valid)
        return DU_ERR_NO_PART;
    Partition* p = &partitions[index];
    if (p.whole)
        return DU_ERR_NO_TABLE;
    if (fsMountOfPartition(index) >= 0)
        return DU_ERR_MOUNTED;
    BlockDev* b = &blockDevs[p.dev];
    if (b.write is null)
        return DU_ERR_READONLY;

    uint kind = duTableKind(b);
    if (kind == DU_TABLE_GPT)
    {
        ulong firstUsable, lastUsable;
        ubyte[16] guid;
        int r = duReadGpt(b, &firstUsable, &lastUsable, guid.ptr);
        if (r != DU_OK)
            return r;
        bool done = false;
        for (uint i = 0; i < DU_GPT_ENTRIES && !done; i++)
        {
            ubyte* e = duEntries.ptr + i * DU_GPT_ENTRY_SIZE;
            if (!duEntryEmpty(e) && blkLe64(e + 32) == p.startLba)
            {
                memset(e, 0, DU_GPT_ENTRY_SIZE);
                done = true;
            }
        }
        if (!done)
            return DU_ERR_NO_PART;
        r = duWriteGpt(b, guid.ptr);
        if (r != DU_OK)
            return r;
    }
    else if (kind == DU_TABLE_MBR)
    {
        bool done = false;
        for (uint i = 0; i < 4 && !done; i++)
        {
            ubyte* e = duSector.ptr + 446 + i * 16;
            if (e[4] != 0 && blkLe32(e + 8) == p.startLba)
            {
                memset(e, 0, 16);
                done = true;
            }
        }
        if (!done)
            return DU_ERR_NO_PART;
        if (!blockWrite(b, 0, 1, duSector.ptr))
            return DU_ERR_IO;
    }
    else
        return DU_ERR_NO_TABLE;

    blockFlush(b);
    p.valid = false;
    return DU_OK;
}

// ---------------------------------------------------------------------------
// FAT32
// ---------------------------------------------------------------------------

/// "dios" -> "DIOS       ". No label (null or empty) gives "NO NAME    " and haveLabel = false.
bool duMakeLabel(const(char)* label, ubyte* out_, bool* haveLabel) @nogc nothrow
{
    for (uint i = 0; i < 11; i++)
        out_[i] = ' ';
    *haveLabel = false;
    if (label is null || label[0] == 0)
    {
        const(char)* d = "NO NAME";
        for (uint i = 0; d[i] != 0; i++)
            out_[i] = cast(ubyte)d[i];
        return true;
    }
    uint n = 0;
    for (; label[n] != 0; n++)
    {
        char c = label[n];
        if (n >= 11)
            return false;
        if (c >= 'a' && c <= 'z')
            c = cast(char)(c - 32);
        if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == ' ' || c == '-' || c == '_'))
            return false;
        out_[n] = cast(ubyte)c;
    }
    *haveLabel = true;
    return true;
}

/// Format partition `index` as FAT32 (all data in it is lost).
/// On success `clustersOut` / `clusterBytesOut` / `volumeIdOut` describe the result.
int duFormatFat32(uint index, const(char)* label, uint* clustersOut, uint* clusterBytesOut, uint* volumeIdOut) @nogc nothrow
{
    if (index >= partitionCount || !partitions[index].valid)
        return DU_ERR_NO_PART;
    if (fsMountOfPartition(index) >= 0)
        return DU_ERR_MOUNTED;
    Partition* p = &partitions[index];
    BlockDev* b = &blockDevs[p.dev];
    if (b.write is null)
        return DU_ERR_READONLY;
    uint ss = b.sectorSize;
    if (ss < 512 || ss > 4096)
        return DU_ERR_BAD_ARG;

    ubyte[11] lab;
    bool haveLabel;
    if (!duMakeLabel(label, lab.ptr, &haveLabel))
        return DU_ERR_BAD_LABEL;

    ulong total = p.sectors;
    if (total > 0xFFFFFFFFUL)
        return DU_ERR_TOO_BIG;

    // cluster size by volume size, like Windows
    ulong bytes = total * ss;
    uint clusterBytes;
    if (bytes <= (64UL << 20)) clusterBytes = 512;
    else if (bytes <= (128UL << 20)) clusterBytes = 1024;
    else if (bytes <= (256UL << 20)) clusterBytes = 2048;
    else if (bytes <= (8UL << 30)) clusterBytes = 4096;
    else if (bytes <= (16UL << 30)) clusterBytes = 8192;
    else if (bytes <= (32UL << 30)) clusterBytes = 16384;
    else clusterBytes = 32768;
    uint spc = clusterBytes / ss;
    if (spc == 0)
        spc = 1;
    clusterBytes = spc * ss;

    enum uint reserved = 32;
    uint fat = 1;
    for (uint iter = 0; iter < 8; iter++)
    {
        if (total <= reserved + 2UL * fat)
            return DU_ERR_TOO_SMALL;
        ulong cl = (total - reserved - 2UL * fat) / spc;
        ulong need = ((cl + 2) * 4 + ss - 1) / ss;
        if (need <= fat)
            break;
        fat = cast(uint)need;
    }
    if (total <= reserved + 2UL * fat)
        return DU_ERR_TOO_SMALL;
    ulong dataStart = reserved + 2UL * fat;
    ulong clusters = (total - dataStart) / spc;
    if (clusters < DU_MIN_FAT32_CLUSTERS)
        return DU_ERR_TOO_SMALL;
    if (clusters > 0x0FFFFFF5UL)
        return DU_ERR_TOO_BIG;

    uint volId = cast(uint)duRandom64();
    if (volId == 0)
        volId = 0x44494F53;             // "DIOS"
    ulong base = p.startLba;

    // 1. clear the reserved area (this also destroys the old boot sector first), the FATs and the root cluster
    if (!duZeroRange(b, base, reserved) ||
        !duZeroRange(b, base + reserved, 2UL * fat) ||
        !duZeroRange(b, base + dataStart, spc))
        return DU_ERR_IO;

    // 2. first sector of each FAT: media byte, "clean" mark, end of the root directory chain
    memset(duSector.ptr, 0, ss);
    duPut32(duSector.ptr, 0x0FFFFFF8);
    duPut32(duSector.ptr + 4, 0x0FFFFFFF);
    duPut32(duSector.ptr + 8, 0x0FFFFFFF);
    if (!blockWrite(b, base + reserved, 1, duSector.ptr) ||
        !blockWrite(b, base + reserved + fat, 1, duSector.ptr))
        return DU_ERR_IO;

    // 3. the volume label entry in the root directory
    if (haveLabel)
    {
        memset(duSector.ptr, 0, ss);
        for (uint i = 0; i < 11; i++)
            duSector[i] = lab[i];
        duSector[11] = 0x08;            // attribute: volume label
        if (!blockWrite(b, base + dataStart, 1, duSector.ptr))
            return DU_ERR_IO;
    }

    // 4. FSInfo (and its backup)
    memset(duSector.ptr, 0, ss);
    duPut32(duSector.ptr + 0, 0x41615252);          // "RRaA"
    duPut32(duSector.ptr + 484, 0x61417272);        // "rrAa"
    duPut32(duSector.ptr + 488, cast(uint)(clusters - 1));  // free clusters (the root uses one)
    duPut32(duSector.ptr + 492, 3);                 // where to look for the next free one
    duPut32(duSector.ptr + 508, 0xAA550000);
    if (!blockWrite(b, base + 1, 1, duSector.ptr) || !blockWrite(b, base + 7, 1, duSector.ptr))
        return DU_ERR_IO;

    // 5. boot sector, backup first and the real one last
    memset(duSector.ptr, 0, ss);
    duSector[0] = 0xEB; duSector[1] = 0x58; duSector[2] = 0x90;
    const(char)* oem = "DIOS    ";
    for (uint i = 0; i < 8; i++)
        duSector[3 + i] = cast(ubyte)oem[i];
    duPut16(duSector.ptr + 11, ss);
    duSector[13] = cast(ubyte)spc;
    duPut16(duSector.ptr + 14, reserved);
    duSector[16] = 2;                               // two FATs
    duSector[21] = 0xF8;                            // fixed disk
    duPut16(duSector.ptr + 24, 63);
    duPut16(duSector.ptr + 26, 255);
    duPut32(duSector.ptr + 28, cast(uint)base);     // hidden sectors
    duPut32(duSector.ptr + 32, cast(uint)total);
    duPut32(duSector.ptr + 36, fat);
    duPut32(duSector.ptr + 44, 2);                  // root directory cluster
    duPut16(duSector.ptr + 48, 1);                  // FSInfo sector
    duPut16(duSector.ptr + 50, 6);                  // backup boot sector
    duSector[64] = 0x80;
    duSector[66] = 0x29;
    duPut32(duSector.ptr + 67, volId);
    for (uint i = 0; i < 11; i++)
        duSector[71 + i] = lab[i];
    const(char)* fsName = "FAT32   ";
    for (uint i = 0; i < 8; i++)
        duSector[82 + i] = cast(ubyte)fsName[i];
    duSector[510] = 0x55;
    duSector[511] = 0xAA;
    if (ss > 512)
    {
        duSector[ss - 2] = 0x55;
        duSector[ss - 1] = 0xAA;
    }
    if (!blockWrite(b, base + 6, 1, duSector.ptr) || !blockWrite(b, base, 1, duSector.ptr))
        return DU_ERR_IO;

    blockFlush(b);
    blockCacheInvalidate(p.dev);

    // 6. does the kernel's own FAT32 code accept what was written?
    if (!fat32Mount(&duVerify, b, p.startLba, p.sectors) || duVerify.clusterCount != cast(uint)clusters ||
        duVerify.serial != volId)
        return DU_ERR_VERIFY;

    *clustersOut = cast(uint)clusters;
    *clusterBytesOut = clusterBytes;
    *volumeIdOut = volId;
    return DU_OK;
}

// ---------------------------------------------------------------------------
// Limine BIOS boot code
// ---------------------------------------------------------------------------

bool duMemEq(const(ubyte)* a, const(ubyte)* b, uint n) @nogc nothrow
{
    for (uint i = 0; i < n; i++)
        if (a[i] != b[i])
            return false;
    return true;
}

/// The boot code image among the boot modules: limine-bios-hdd.bin = 512-byte boot sector
/// followed by stage 1.5.
const(ubyte)* duFindBiosBlob(ulong* size) @nogc nothrow
{
    if (moduleRequest.response is null)
        return null;
    ulong n = moduleRequest.response.module_count;
    for (ulong i = 0; i < n; i++)
    {
        LimineFile* f = moduleRequest.response.modules[i];
        if (f is null || f.address is null || f.path is null || !limineIsBiosBlobPath(f.path))
            continue;
        *size = f.size;
        return cast(const(ubyte)*)f.address;
    }
    return null;
}

/// 1: the sector at `lba` starts like a file system, 0: no, -1: read error.
int duLooksLikeFs(BlockDev* b, ulong lba) @nogc nothrow
{
    uint ss = b.sectorSize;
    uint n = (1082 + ss - 1) / ss;
    if (!blockRead(b, lba, n, duProbe.ptr))
        return -1;
    const(ubyte)* s = duProbe.ptr;
    if (duMemEq(s + 3, cast(const(ubyte)*)"NTFS".ptr, 4) || duMemEq(s + 3, cast(const(ubyte)*)"EXFAT".ptr, 5) ||
        duMemEq(s + 54, cast(const(ubyte)*)"FAT".ptr, 3) || duMemEq(s + 82, cast(const(ubyte)*)"FAT".ptr, 3))
        return 1;
    if (s[1080] == 0x53 && s[1081] == 0xEF)             // ext2/3/4 magic 0xEF53
        return 1;
    return 0;
}

/// Install Limine's BIOS boot code, like "limine bios-install". `img` is limine-bios-hdd.bin.
/// GPT: stage 1.5 goes to the start of the BIOS boot partition (`partIndex`: its number in
/// 'disk', or -1 to take the first one). MBR: to byte 4096, in the gap before the first
/// partition. The boot sector is written last, with the partition table and disk ID of the
/// disk kept; *locOut gets the byte offset of stage 1.5.
int duInstallBiosBoot(BlockDev* b, int partIndex, const(ubyte)* img, ulong imgSize, ulong* locOut) @nogc nothrow
{
    if (b is null || !b.present)
        return DU_ERR_NO_DISK;
    if (b.write is null)
        return DU_ERR_READONLY;
    uint ss = b.sectorSize;
    if (ss < 512 || ss > 4096)
        return DU_ERR_BAD_ARG;
    if (img is null || imgSize <= 512 || imgSize > 1024UL * 1024 || img[510] != 0x55 || img[511] != 0xAA)
        return DU_ERR_BAD_BLOB;
    if (duDiskIsWhole(b))
        return DU_ERR_NO_TABLE;

    uint kind = duTableKind(b);
    if (kind == DU_TABLE_NONE)
        return DU_ERR_NO_TABLE;
    if (!blockRead(b, 0, 1, duBoot.ptr))
        return DU_ERR_IO;

    ulong loc;
    ulong room;
    if (kind == DU_TABLE_GPT)
    {
        ulong firstUsable, lastUsable;
        ubyte[16] guid;
        int r = duReadGpt(b, &firstUsable, &lastUsable, guid.ptr);
        if (r != DU_OK)
            return r;
        if (partIndex >= 0)
        {
            if (cast(uint)partIndex >= partitionCount || !partitions[partIndex].valid ||
                partitions[partIndex].dev != blockDevIndex(b))
                return DU_ERR_NO_PART;
        }
        bool found = false;
        ulong first = 0;
        ulong last = 0;
        for (uint i = 0; i < DU_GPT_ENTRIES && !found; i++)
        {
            const(ubyte)* e = duEntries.ptr + i * DU_GPT_ENTRY_SIZE;
            if (!duMemEq(e, DU_GUID_BIOS_BOOT.ptr, 16))
                continue;
            first = blkLe64(e + 32);
            last = blkLe64(e + 40);
            if (partIndex < 0 || partitions[partIndex].startLba == first)
                found = true;
        }
        if (!found)
            return DU_ERR_NO_BIOS_PART;
        if (last < first || first < firstUsable || last > lastUsable || first < 2 + DU_GPT_BYTES / ss)
            return DU_ERR_GPT_BAD;
        room = (last - first + 1) * ss;
        if (room < 32768)
            return DU_ERR_NO_ROOM;
        loc = first * ss;
    }
    else
    {
        bool anyActive = false;
        int firstUsed = -1;
        for (uint i = 0; i < 4; i++)
        {
            const(ubyte)* e = duBoot.ptr + 446 + i * 16;
            if (e[0] & 0x80)
                anyActive = true;
            if (e[4] != 0)
            {
                if (blkLe32(e + 8) < 63)
                    return DU_ERR_MBR_LOW;
                if (firstUsed < 0)
                    firstUsed = cast(int)i;
            }
        }
        if (!anyActive && firstUsed >= 0)
            duBoot[446 + cast(uint)firstUsed * 16] = 0x80;      // some BIOSes refuse to boot a disk without one
        loc = 4096;
        room = 63 * 512 - 4096;
    }

    if (imgSize - 512 > room)
        return DU_ERR_NO_ROOM;
    int hasFs = duLooksLikeFs(b, loc / ss);
    if (hasFs < 0)
        return DU_ERR_IO;
    if (hasFs > 0)
        return DU_ERR_HAS_FS;

    // stage 1.5 first, padded to whole sectors
    ulong left = imgSize - 512;
    const(ubyte)* src = img + 512;
    ulong lba = loc / ss;
    while (left != 0)
    {
        uint n = left < DU_GPT_BYTES ? cast(uint)left : DU_GPT_BYTES;
        uint sectors = (n + ss - 1) / ss;
        memcpy(duEntries.ptr, src, n);
        if (n < sectors * ss)
            memset(duEntries.ptr + n, 0, sectors * ss - n);
        if (!blockWrite(b, lba, sectors, duEntries.ptr))
            return DU_ERR_IO;
        src += n;
        left -= n;
        lba += sectors;
    }

    // then sector 0: the boot code over the old one, keeping the timestamp (218..223) and
    // disk ID / partition table (440..509) of the disk; the location of stage 1.5 goes in at 0x1A4
    memcpy(duSector.ptr, duBoot.ptr, ss);
    memcpy(duSector.ptr, img, 512);
    memcpy(duSector.ptr + 218, duBoot.ptr + 218, 6);
    memcpy(duSector.ptr + 440, duBoot.ptr + 440, 70);
    duPut64(duSector.ptr + 0x1A4, loc);
    if (!blockWrite(b, 0, 1, duSector.ptr))
        return DU_ERR_IO;
    blockFlush(b);
    *locOut = loc;
    return DU_OK;
}

// ---------------------------------------------------------------------------
// shell commands
// ---------------------------------------------------------------------------

__gshared char[160] duArgs;             // private copy of a command line: the tokenizer writes into it

char* duCopyArgs(const(char)* args) @nogc nothrow
{
    size_t n = 0;
    if (args !is null)
        while (args[n] != 0 && n < duArgs.length - 1)
        {
            duArgs[n] = args[n];
            n++;
        }
    duArgs[n] = 0;
    return duArgs.ptr;
}

char* duNextWord(char** p) @nogc nothrow
{
    char* s = *p;
    while (*s == ' ' || *s == '\t')
        s++;
    if (*s == 0)
    {
        *p = s;
        return null;
    }
    char* word = s;
    while (*s != 0 && *s != ' ' && *s != '\t')
        s++;
    if (*s != 0)
        *s++ = 0;
    *p = s;
    return word;
}

bool duWordIs(const(char)* w, string text) @nogc nothrow
{
    if (w is null)
        return false;
    for (size_t i = 0; i < text.length; i++)
        if (w[i] != text[i])
            return false;
    return w[text.length] == 0;
}

bool duParseDecimal(const(char)* s, ulong* out_) @nogc nothrow
{
    if (s is null || *s == 0)
        return false;
    ulong v = 0;
    for (; *s != 0; s++)
    {
        if (*s < '0' || *s > '9' || v > 0x0FFFFFFFFFFFFFFUL)
            return false;
        v = v * 10 + (*s - '0');
    }
    *out_ = v;
    return true;
}

// ptable DISK gpt|mbr yes
void duPtable(const(char)* args) @nogc nothrow
{
    char* rest = duCopyArgs(args);
    char* disk = duNextWord(&rest);
    char* type = duNextWord(&rest);
    char* confirm = duNextWord(&rest);
    bool gpt = duWordIs(type, "gpt");
    if (disk is null || !(gpt || duWordIs(type, "mbr")) || (confirm !is null && (!duWordIs(confirm, "yes") || duNextWord(&rest) !is null)))
    {
        cprintf("Usage: ptable DISK gpt|mbr yes   (DISK: a name from 'disk', e.g. sata0)\n");
        return;
    }
    BlockDev* b = duFindDisk(disk);
    if (b is null)
    {
        cprintf("No such disk: %s ('disk' lists them)\n", disk);
        return;
    }
    if (confirm is null)
    {
        cprintf("This erases the partition table of %s (%s, %llu MiB): every partition on it is lost.\n",
                b.name.ptr, b.model.ptr, (b.sectors * b.sectorSize) >> 20);
        cprintf("Run the command again with 'yes' at the end to do it.\n");
        return;
    }
    int r = duCreateTable(b, gpt ? DU_TABLE_GPT : DU_TABLE_MBR);
    if (r != DU_OK)
        cprintf("ptable: %s\n", duErrorText(r));
    else
        cprintf("New %s partition table on %s. 'padd %s SIZE' adds partitions.\n", gpt ? "GPT".ptr : "MBR".ptr, b.name.ptr, b.name.ptr);
}

// padd DISK SIZE [esp|data]   or   padd DISK bios
void duPadd(const(char)* args) @nogc nothrow
{
    char* rest = duCopyArgs(args);
    char* disk = duNextWord(&rest);
    char* size = duNextWord(&rest);
    char* type = duNextWord(&rest);
    ulong mib = 0;
    bool bios = duWordIs(size, "bios");
    bool ok = disk !is null && size !is null && duNextWord(&rest) is null;
    if (ok && bios)
        ok = type is null;
    else if (ok && !duWordIs(size, "rest"))
        ok = duParseDecimal(size, &mib) && mib != 0;
    bool esp = duWordIs(type, "esp");
    if (ok && type !is null && !esp && !duWordIs(type, "data"))
        ok = false;
    if (!ok)
    {
        cprintf("Usage: padd DISK SIZE [esp|data]   (SIZE: MiB, or 'rest' for the biggest free area)\n       padd DISK bios            (1 MiB BIOS boot partition in front of the others, GPT only)\n");
        return;
    }
    BlockDev* b = duFindDisk(disk);
    if (b is null)
    {
        cprintf("No such disk: %s ('disk' lists them)\n", disk);
        return;
    }
    int r = duAddPartition(b, mib, esp, bios);
    if (r < 0)
    {
        cprintf("padd: %s\n", duErrorText(r));
        return;
    }
    Partition* p = &partitions[cast(uint)r];
    ulong bytes = p.sectors * b.sectorSize;
    if (bytes < (1UL << 20))
        cprintf("Created partition [%d] on %s: start %llu, %llu KiB, %s.\n", r, b.name.ptr, p.startLba, bytes >> 10, p.kind.ptr);
    else
        cprintf("Created partition [%d] on %s: start %llu, %llu MiB, %s. 'mkfs %d' formats it.\n", r, b.name.ptr, p.startLba,
                bytes >> 20, p.kind.ptr, r);
}

// pdel N yes
void duPdel(const(char)* args) @nogc nothrow
{
    char* rest = duCopyArgs(args);
    char* num = duNextWord(&rest);
    char* confirm = duNextWord(&rest);
    ulong n;
    if (!duParseDecimal(num, &n) || (confirm !is null && (!duWordIs(confirm, "yes") || duNextWord(&rest) !is null)))
    {
        cprintf("Usage: pdel N yes   (N: the number in brackets in 'disk')\n");
        return;
    }
    if (n >= partitionCount || !partitions[cast(uint)n].valid)
    {
        cprintf("pdel: %s\n", duErrorText(DU_ERR_NO_PART));
        return;
    }
    if (confirm is null)
    {
        Partition* p = &partitions[cast(uint)n];
        BlockDev* b = &blockDevs[p.dev];
        cprintf("This removes partition [%llu] of %s (%llu MiB, %s) from the partition table.\n", n, b.name.ptr,
                (p.sectors * b.sectorSize) >> 20, p.kind.ptr);
        cprintf("Run the command again with 'yes' at the end to do it.\n");
        return;
    }
    int r = duDeletePartition(cast(uint)n);
    if (r != DU_OK)
        cprintf("pdel: %s\n", duErrorText(r));
    else
        cprintf("Partition [%llu] deleted.\n", n);
}

// mkfs N [LABEL] yes
void duMkfs(const(char)* args) @nogc nothrow
{
    char* rest = duCopyArgs(args);
    char* num = duNextWord(&rest);
    char* second = duNextWord(&rest);
    char* third = duNextWord(&rest);
    char* label = null;
    bool confirmed = false;
    bool ok = true;
    if (second !is null && third is null && duWordIs(second, "yes"))
        confirmed = true;
    else if (second !is null)
    {
        label = second;
        if (third !is null)
        {
            confirmed = duWordIs(third, "yes");
            ok = confirmed && duNextWord(&rest) is null;
        }
    }
    ulong n;
    if (!ok || !duParseDecimal(num, &n))
    {
        cprintf("Usage: mkfs N [LABEL] yes   (N: the number in brackets in 'disk'; formats it as FAT32)\n");
        return;
    }
    if (n >= partitionCount || !partitions[cast(uint)n].valid)
    {
        cprintf("mkfs: %s\n", duErrorText(DU_ERR_NO_PART));
        return;
    }
    Partition* p = &partitions[cast(uint)n];
    BlockDev* b = &blockDevs[p.dev];
    if (!confirmed)
    {
        cprintf("This erases partition [%llu] of %s (%llu MiB, %s) and makes a FAT32 volume in it.\n", n, b.name.ptr,
                (p.sectors * b.sectorSize) >> 20, p.kind.ptr);
        cprintf("Run the command again with 'yes' at the end to do it.\n");
        return;
    }
    cprintf("Formatting partition [%llu] of %s...\n", n, b.name.ptr);
    uint clusters, clusterBytes, volId;
    int r = duFormatFat32(cast(uint)n, label, &clusters, &clusterBytes, &volId);
    if (r != DU_OK)
    {
        cprintf("mkfs: %s\n", duErrorText(r));
        return;
    }
    char[10] idText;
    fsFormatVolumeId(volId, idText.ptr);
    cprintf("FAT32 volume ready: %u clusters of %u bytes, ID %s. 'mount %llu rw' or 'rmount id=%s rw' uses it.\n", clusters,
            clusterBytes, idText.ptr, n, idText.ptr);
}

// biosinstall DISK [N] yes
void duBiosInstall(const(char)* args) @nogc nothrow
{
    char* rest = duCopyArgs(args);
    char* disk = duNextWord(&rest);
    char* second = duNextWord(&rest);
    char* third = duNextWord(&rest);
    int part = -1;
    bool confirmed = false;
    bool ok = disk !is null;
    if (ok && second !is null)
    {
        if (duWordIs(second, "yes") && third is null)
            confirmed = true;
        else
        {
            ulong n;
            ok = duParseDecimal(second, &n) && n < BLK_MAX_PARTS;
            part = cast(int)n;
            if (ok && third !is null)
            {
                confirmed = duWordIs(third, "yes");
                ok = confirmed && duNextWord(&rest) is null;
            }
        }
    }
    if (!ok)
    {
        cprintf("Usage: biosinstall DISK [N] yes   (N: the BIOS boot partition from 'disk'; default: the first one)\n");
        return;
    }
    BlockDev* b = duFindDisk(disk);
    if (b is null)
    {
        cprintf("No such disk: %s ('disk' lists them)\n", disk);
        return;
    }
    ulong size;
    const(ubyte)* img = duFindBiosBlob(&size);
    if (img is null)
    {
        cprintf("biosinstall: %s\n", duErrorText(DU_ERR_BAD_BLOB));
        return;
    }
    if (!confirmed)
    {
        cprintf("This replaces the boot code of %s (%s) with Limine's (%llu bytes), keeping its partitions.\n", b.name.ptr,
                b.model.ptr, size);
        cprintf("Run the command again with 'yes' at the end to do it.\n");
        return;
    }
    ulong loc;
    int r = duInstallBiosBoot(b, part, img, size, &loc);
    if (r != DU_OK)
    {
        cprintf("biosinstall: %s\n", duErrorText(r));
        return;
    }
    cprintf("Limine BIOS boot code installed on %s, stage 1.5 at byte offset %llu.\n", b.name.ptr, loc);
    cprintf("Boot still needs limine-bios.sys and limine.conf on a partition of the disk.\n");
}
