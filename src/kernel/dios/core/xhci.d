module dios.core.xhci;

/**
 * xHCI (USB 3.x host controller) driver + USB HID boot-protocol mouse and keyboard.
 *
 * Scope: polling only (no interrupts). Devices on root ports and behind hubs
 * (hubs are driven with control transfers only), hot-plug by polling port status. The flow is the textbook one from the xHCI spec (rev 1.2):
 *
 *   reset controller -> DCBAA + command ring + event ring -> run
 *   -> per connected port: reset port -> Enable Slot -> Address Device
 *   -> control transfers (descriptors) -> Set Configuration / Set Protocol
 *   -> Configure Endpoint -> queue Normal TRBs on the interrupt-IN endpoint
 *   -> every completed TRB is one mouse report -> mouseMove()
 *      (or one keyboard report -> usbkbd.d -> key events, see XhciKbd)
 *
 * All DMA memory comes from the PMM below 4 GiB, so it works whether or not
 * the controller supports 64-bit addressing. Memory shared with the
 * controller is only touched through volatileLoad/volatileStore.
 */
import core.volatile;
import dios.core.mem;
import dios.core.paging;
import dios.core.clock;
import dios.core.stdio;
import dios.core.mouse;
import dios.core.usbkbd;

// constants

enum uint XHCI_MAX_SLOTS = 32;      // we only enable this many device slots (hubs take one each)
enum uint XHCI_RING_TRBS = 256;     // one 4 KiB page per ring
enum uint XHCI_RPT_BUFS = 16;       // report buffers kept queued on the mouse endpoint
enum uint XHCI_RPT_STRIDE = 64;
enum uint XHCI_MAX_EP_ERRORS = 5;   // consecutive transfer errors an interrupt endpoint may recover from
// Scratch page layout: [0,1024) control data, [1024,2048) mouse reports, [2048,3072) keyboard reports
enum uint XHCI_KBD_BUF_OFF = 2048;

enum : uint
{
    // Operational register offsets
    OP_USBCMD = 0x00, OP_USBSTS = 0x04, OP_PAGESIZE = 0x08,
    OP_CRCR = 0x18, OP_DCBAAP = 0x30, OP_CONFIG = 0x38, OP_PORTS = 0x400,

    CMD_RUN = 1 << 0, CMD_HCRST = 1 << 1,
    STS_HCH = 1 << 0, STS_HSE = 1 << 2, STS_CNR = 1 << 11,

    // PORTSC bits
    PORT_CCS = 1 << 0, PORT_PED = 1 << 1, PORT_PR = 1 << 4, PORT_PP = 1 << 9,
    PORT_CSC = 1 << 17, PORT_PRC = 1 << 21,
    // Bits that must be preserved when we write PORTSC (PP, PIC, wake enables).
    // PED and the *change* bits are write-1-to-clear: writing back what we read
    // would DISABLE the port / clear events by accident.
    PORT_PRESERVE = (1 << 9) | (3 << 14) | (7 << 25),
    PORT_CHANGE_BITS = 0x00FE0000,

    // TRB types
    TRB_NORMAL = 1, TRB_SETUP = 2, TRB_DATA = 3, TRB_STATUS = 4, TRB_LINK = 6,
    TRB_CMD_ENABLE_SLOT = 9, TRB_CMD_ADDRESS_DEVICE = 11,
    TRB_CMD_CONFIGURE_EP = 12, TRB_CMD_EVALUATE_CTX = 13, TRB_CMD_NOOP = 23,
    TRB_EV_TRANSFER = 32, TRB_EV_CMD_COMPLETE = 33, TRB_EV_PORT_STATUS = 34,

    // TRB control flags
    TRB_TC = 1 << 1,        // link: toggle cycle
    TRB_ISP = 1 << 2,       // interrupt on short packet
    TRB_IOC = 1 << 5,       // interrupt on completion (=> generate event)
    TRB_IDT = 1 << 6,       // immediate data (setup stage)
    TRB_DIR_IN = 1 << 16,

    CC_SUCCESS = 1, CC_SHORT_PACKET = 13, CC_STALL = 6, CC_BABBLE = 3, CC_TRANSACTION_ERROR = 4
}

enum : uint
{
    TRB_CMD_STOP_EP = 15, TRB_CMD_RESET_EP = 14, TRB_CMD_SET_TR_DEQ = 16,
    TRB_CMD_DISABLE_SLOT = 10
}

enum uint XHCI_MAX_CONTROLLERS = 4;
enum uint XHCI_MAX_HUB_DEPTH = 5;          // route strings have room for five tiers
enum ubyte XHCI_PORT_FAILED = 0xFF;        // marks a port whose device could not be brought up
enum uint XHCI_MSC_BOUNCE_PAGES = 16;      // 64 KiB data buffer per storage device
enum uint XHCI_MSC_CBW_OFF = 2048;         // CBW/CSW live in the device's scratch page
enum uint XHCI_MSC_CSW_OFF = 2560;

// Result of xhciBulkXfer
enum : int
{
    BULK_OK = 0, BULK_STALL = 1, BULK_ERROR = 2, BULK_TIMEOUT = 3
}

// structures

struct XhciTrb
{
    ulong param;
    uint status;
    uint control;
}

struct XhciRing
{
    XhciTrb* trbs;      // virtual
    ulong phys;
    uint enq;
    uint cycle;         // producer cycle state, 0 or 1
}

struct XhciEventRing
{
    XhciTrb* trbs;
    ulong phys;
    uint deq;
    uint cycle;         // consumer cycle state
}

// Where the fields of a mouse report live (from the HID report descriptor).
struct HidField
{
    bool valid;
    uint off;           // bit offset inside the report (after the report id byte, if any)
    uint size;          // size in bits
    bool isSigned;
    bool absolute;      // a position (tablet) rather than a movement (mouse)
    int logMin;         // range of the values (what an absolute field is scaled from)
    int logMax;
}

struct HidMouseLayout
{
    bool valid;         // X and Y were found
    bool isPointerApp;  // the top level collection is a Mouse or a Pointer (and not, say, a gamepad)
    bool hasId;         // reports start with a report-id byte
    ubyte reportId;
    HidField x, y, wheel;
    uint btnOff;
    uint btnCount;
}

// A HID boot keyboard interface. Separate from the mouse fields in
// XhciUsbDevice so that a composite device (keyboard + mouse behind one
// receiver) can run both, each with its own interrupt endpoint and ring.
struct XhciKbd
{
    bool found;                 // a boot keyboard interface was seen in the configuration
    bool active;                // endpoint configured and transfers queued
    ubyte ifaceNum;
    ubyte intEpAddr;
    uint  intMps;
    ubyte intInterval;
    ubyte intDci;
    uint reportLen;
    uint rptHead;               // reports completed so far (selects the buffer)
    bool recover;               // endpoint halted by a transfer error, to be reset by xhciRecoverInputs()
    ubyte errs;                 // consecutive transfer errors
    XhciRing intRing;
    UsbKbdState state;          // previous report, for press detection
}

// A USB Mass Storage interface (Bulk-Only Transport): one bulk IN and one bulk OUT endpoint.
struct XhciMsc
{
    bool found;                 // interface + both endpoints seen in the configuration
    bool active;                // endpoints configured
    ubyte ifaceNum;
    ubyte inAddr, outAddr;
    ubyte inDci, outDci;
    uint inMps, outMps;
    XhciRing inRing, outRing;

    // completion of the last bulk transfer (set by the event handler)
    bool xferDone;
    uint xferCode;
    uint xferResidual;
    ulong xferWait;

    ubyte* bounce;              // 64 KiB, 64 KiB aligned: a TRB must not cross a 64 KiB boundary
    ulong bouncePhys;
}

struct XhciUsbDevice
{
    bool present;
    ubyte slotId;
    ubyte port;                 // 1-based root hub port
    ubyte speed;                // PORTSC speed id: 1 FS, 2 LS, 3 HS, 4 SS
    uint ep0Mps;
    uint serial;                // unique per device instance (a slot number is reused)
    ushort vid, pid;
    ubyte devClass;

    // topology: where the device hangs
    uint route;                 // route string: 4 bits per hub tier, nearest the root first
    ubyte depth;                // number of hubs between it and the root port
    ubyte parentSlot;           // slot of the hub it is plugged into (0: a root port)
    ubyte parentPort;           // port number on that hub
    ubyte ttSlot, ttPort;       // transaction translator for a LS/FS device below a HS hub (0: none)

    // hub
    bool isHub;
    bool hubDead;               // stopped answering: no longer polled
    ubyte hubPorts;
    ubyte hubTtt;               // TT think time field of a HS hub
    ubyte hubPowerGood;         // bPwrOn2PwrGood, in 2 ms units
    ubyte[16] hubChild;         // per port (1..15): slot of the attached device, 0 none, XHCI_PORT_FAILED

    ubyte* devCtx;  ulong devCtxPhys;
    ubyte* inCtx;   ulong inCtxPhys;
    ubyte* dma;     ulong dmaPhys;   // scratch page: [0,1024) control data, [1024,..) HID report

    XhciRing ep0Ring;
    XhciRing intRing;

    // control transfer completion (set by the event handler)
    bool ep0Done;
    uint ep0Code;
    ulong ep0Wait;

    // configuration descriptor findings
    bool configured;            // Set Configuration has been sent
    XhciKbd kbd;
    XhciMsc msc;
    ubyte cfgValue;
    ubyte ifaceNum;
    ubyte intEpAddr;
    uint  intMps;
    ubyte intInterval;
    bool  hasMouse;
    bool  mouseNeedsDesc;       // the pointer is not a boot protocol mouse: only usable if its report descriptor says so

    // running mouse
    bool mouseActive;
    ubyte intDci;
    uint reportLen;
    bool gotFirstReport;
    ushort hidReportLen;        // size of the HID report descriptor (from the HID descriptor)
    HidMouseLayout layout;
    uint rptHead;               // number of reports completed so far (selects the buffer)
    uint rptsDumped;
    bool mouseRecover;          // endpoint halted by a transfer error, to be reset by xhciRecoverInputs()
    ubyte mouseErrs;            // consecutive transfer errors
}

struct XhciController
{
    ubyte index;                // position in xhciControllers
    ubyte* cap;
    ubyte* op;
    ubyte* rt;
    ubyte* db;

    uint hcs1, hcs2, hcc1;
    uint maxSlots, maxPorts;
    uint ctxSize;               // 32 or 64 bytes per context

    ulong* dcbaa;
    ulong dcbaaPhys;

    XhciRing cmdRing;
    XhciEventRing evRing;

    // command completion (set by the event handler)
    bool cmdDone;
    uint cmdCode;
    uint cmdSlot;
    ulong cmdWait;

    XhciUsbDevice[XHCI_MAX_SLOTS + 1] devs;   // indexed by slot id (0 unused)

    // hot-plug bookkeeping
    ubyte[256] rootChild;       // per root port: slot of the attached device, 0 none, XHCI_PORT_FAILED
    ulong nextRootScan;         // clock (ns) of the next look at the root ports
    ulong nextHubScan;          // ... and at the hubs

    bool running;
}

// Several controllers can run at the same time (keyboard on one, the USB stick on
// another). `xhci` always points at the one the code is working on right now:
// xhciInit() selects the controller it brings up, usbPoll() visits all of them,
// and anything that talks to a specific device calls xhciSelect() first.
__gshared XhciController[XHCI_MAX_CONTROLLERS] xhciControllers;
__gshared XhciController* xhci = &xhciControllers[0];
__gshared uint xhciCount;
__gshared uint xhciTopologyGen;      // bumped whenever a device appears or goes away
__gshared uint xhciDeviceSerial;

// Print the raw bytes of the first mouse reports and a "first report" note.
// Handy when a new mouse misbehaves, but those lines show up whenever the mouse
// first moves - in the middle of the shell - so they are off by default.
__gshared bool xhciDebugReports = false;

extern(C):

// helpers

uint xhciRd32(ubyte* base, size_t off) @nogc nothrow
{
    return volatileLoad(cast(uint*)(base + off));
}

void xhciWr32(ubyte* base, size_t off, uint v) @nogc nothrow
{
    volatileStore(cast(uint*)(base + off), v);
}

// 64-bit registers are written as two 32-bit stores, low dword first.
void xhciWr64(ubyte* base, size_t off, ulong v) @nogc nothrow
{
    xhciWr32(base, off, cast(uint)v);
    xhciWr32(base, off + 4, cast(uint)(v >> 32));
}

void xhciFence() @nogc nothrow
{
    asm @nogc nothrow { mfence; }
}

ulong xhciDeadline(uint ms) @nogc nothrow
{
    return clockDeadlineMs(ms);
}

bool xhciWaitReg(ubyte* base, size_t off, uint mask, uint value, uint ms) @nogc nothrow
{
    ulong dl = xhciDeadline(ms);
    while ((xhciRd32(base, off) & mask) != value)
    {
        if (clockNowNs() > dl)
            return false;
    }
    return true;
}

// Zeroed, physically contiguous DMA memory below 4 GiB.
void* xhciDmaAlloc(ulong pages, ulong* phys) @nogc nothrow
{
    ulong p = pmmAllocContiguousZeroed(pages, 1, PMM_LIMIT_4G);
    if (p == 0)
        return null;
    *phys = p;
    return pmmPhysToVirt(p);
}

// rings

bool xhciRingInit(XhciRing* r) @nogc nothrow
{
    ulong phys;
    void* v = xhciDmaAlloc(1, &phys);
    if (v is null)
        return false;
    r.trbs = cast(XhciTrb*)v;
    r.phys = phys;
    r.enq = 0;
    r.cycle = 1;
    // Last slot is a Link TRB back to the start. Its cycle bit stays 0 (not
    // yet valid) until the producer reaches it.
    XhciTrb* link = &r.trbs[XHCI_RING_TRBS - 1];
    volatileStore(&link.param, phys);
    volatileStore(&link.status, 0u);
    volatileStore(&link.control, (TRB_LINK << 10) | TRB_TC);
    return true;
}

// Queue one TRB. Returns its physical address (that is what completion events
// refer to). The cycle bit is written last so the controller never sees a
// half-written TRB.
ulong xhciRingPush(XhciRing* r, ulong param, uint status, uint control) @nogc nothrow
{
    uint idx = r.enq;
    XhciTrb* t = &r.trbs[idx];
    volatileStore(&t.param, param);
    volatileStore(&t.status, status);
    volatileStore(&t.control, (control & ~1u) | r.cycle);
    ulong phys = r.phys + cast(ulong)idx * XhciTrb.sizeof;

    r.enq++;
    if (r.enq == XHCI_RING_TRBS - 1)
    {
        // Hand the Link TRB to the controller with the current cycle bit,
        // then wrap and flip our cycle state.
        XhciTrb* link = &r.trbs[r.enq];
        volatileStore(&link.control, (TRB_LINK << 10) | TRB_TC | r.cycle);
        r.enq = 0;
        r.cycle ^= 1;
    }
    return phys;
}

void xhciRingDoorbell(uint slot, uint target) @nogc nothrow
{
    xhciFence();
    xhciWr32(xhci.db, slot * 4, target);
}

// events

// Minimal HID report descriptor parser: finds where X, Y, wheel and the
// buttons live inside an input report. This replaces the old assumption that
// every mouse sends the 3-byte boot layout (many mice send 16-bit X/Y, so
// "byte 2" was the high byte of X: the cursor only moved sideways).
void hidParseReportDescriptor(HidMouseLayout* L, ubyte* buf, uint len) @nogc nothrow
{
    *L = HidMouseLayout.init;

    uint usagePage = 0;
    int logMin = 0;
    int logMax = 0;
    uint logMaxRaw = 0;                     // same, unsigned (when the range does not start below 0)
    bool haveTop = false;                   // the first top level collection: what is this device?
    uint topPage = 0, topUsage = 0;
    uint repSize = 0, repCount = 0, repId = 0;
    bool anyId = false;
    uint[16] usages;
    uint nUsages = 0, usMin = 0, usMax = 0;
    bool haveRange = false;
    uint offBits = 0;                       // within the current report id
    bool btnSeen = false;
    uint btnRid = 0, btnOff = 0, btnCount = 0;
    bool ridChosen = false;
    uint chosenRid = 0;

    uint i = 0;
    while (i < len)
    {
        ubyte b = volatileLoad(buf + i);
        if (b == 0xFE)                      // long item: skip
        {
            uint l = (i + 1 < len) ? volatileLoad(buf + i + 1) : 0;
            i += 3 + l;
            continue;
        }
        uint sz = b & 3;
        if (sz == 3) sz = 4;
        uint type = (b >> 2) & 3;
        uint tag = b >> 4;
        if (i + 1 + sz > len)
            break;

        uint val = 0;
        for (uint k = 0; k < sz; k++)
            val |= cast(uint)volatileLoad(buf + i + 1 + k) << (8 * k);
        int sval = cast(int)val;
        if (sz == 1) sval = cast(byte)val;
        else if (sz == 2) sval = cast(short)val;
        i += 1 + sz;

        if (type == 1)                      // global
        {
            if (tag == 0) usagePage = val;
            else if (tag == 1) logMin = sval;
            else if (tag == 2) { logMax = sval; logMaxRaw = val; }
            else if (tag == 7) repSize = val;
            else if (tag == 8) { repId = val; anyId = true; offBits = 0; }
            else if (tag == 9) repCount = val;
        }
        else if (type == 2)                 // local
        {
            if (tag == 0) { if (nUsages < 16) usages[nUsages++] = val; }
            else if (tag == 1) { usMin = val; haveRange = true; }
            else if (tag == 2) { usMax = val; haveRange = true; }
        }
        else if (type == 0)                 // main
        {
            if (tag == 8)                   // Input
            {
                bool constant = (val & 1) != 0;
                bool variable = (val & 2) != 0;

                if (!constant && variable)
                {
                    if (usagePage == 9 && !btnSeen && repSize == 1)
                    {
                        btnSeen = true;
                        btnRid = repId;
                        btnOff = offBits;
                        btnCount = repCount;
                    }

                    for (uint n = 0; n < repCount; n++)
                    {
                        uint usage = 0;
                        bool haveUsage = false;
                        if (nUsages > 0)
                        {
                            usage = usages[n < nUsages ? n : nUsages - 1];
                            haveUsage = true;
                        }
                        else if (haveRange)
                        {
                            usage = usMin + n;
                            if (usage > usMax) usage = usMax;
                            haveUsage = true;
                        }
                        if (!haveUsage || usagePage != 1)
                            continue;

                        HidField f;
                        f.valid = true;
                        f.off = offBits + n * repSize;
                        f.size = repSize;
                        f.isSigned = logMin < 0;
                        f.absolute = (val & 4) == 0;        // Input item bit 2: 1 = relative, 0 = absolute
                        f.logMin = logMin;
                        f.logMax = (logMin >= 0) ? cast(int)logMaxRaw : logMax;

                        if (usage == 0x30 && !ridChosen)
                        {
                            ridChosen = true;
                            chosenRid = repId;
                        }
                        if (ridChosen && repId == chosenRid)
                        {
                            if (usage == 0x30 && !L.x.valid) L.x = f;
                            else if (usage == 0x31 && !L.y.valid) L.y = f;
                            else if (usage == 0x38 && !L.wheel.valid) L.wheel = f;
                        }
                    }
                }
                offBits += repSize * repCount;
            }
            else if (tag == 10 && val == 1 && !haveTop)     // Collection (Application)
            {
                haveTop = true;
                topPage = usagePage;
                topUsage = (nUsages > 0) ? usages[0] : 0;
            }
            // every main item clears the local state
            nUsages = 0;
            usMin = 0;
            usMax = 0;
            haveRange = false;
        }
    }

    if (L.x.valid && L.y.valid)
    {
        L.valid = true;
        L.isPointerApp = haveTop && topPage == 1 && (topUsage == 1 || topUsage == 2);   // Generic Desktop: Pointer, Mouse
        L.hasId = anyId;
        L.reportId = cast(ubyte)chosenRid;
        if (btnSeen && btnRid == chosenRid)
        {
            L.btnOff = btnOff;
            L.btnCount = btnCount > 8 ? 8 : btnCount;
        }
    }
}

int hidGetField(ubyte* rpt, uint lenBytes, uint baseBits, HidField* f) @nogc nothrow
{
    if (!f.valid || f.size == 0 || f.size > 32)
        return 0;
    uint start = baseBits + f.off;
    if (start + f.size > lenBytes * 8)
        return 0;
    uint v = 0;
    for (uint i = 0; i < f.size; i++)
    {
        uint bit = start + i;
        uint byteV = volatileLoad(rpt + (bit >> 3));
        v |= ((byteV >> (bit & 7)) & 1) << i;
    }
    if (f.isSigned && f.size < 32 && (v & (1u << (f.size - 1))))
        v |= ~0u << f.size;
    return cast(int)v;
}

void xhciProcessReport(XhciUsbDevice* d, ubyte* rpt, uint got) @nogc nothrow
{
    // Show the first few raw reports: invaluable when a new mouse misbehaves.
    if (xhciDebugReports && d.rptsDumped < 4 && got > 0)
    {
        d.rptsDumped++;
        kprintf("  report (%u bytes):", got);
        for (uint i = 0; i < got && i < 12; i++)
            kprintf(" %X", cast(uint)volatileLoad(rpt + i));
        kprintf("\n");
    }

    if (d.layout.valid)
    {
        uint base = 0;
        if (d.layout.hasId)
        {
            if (got < 1 || volatileLoad(rpt) != d.layout.reportId)
                return;
            base = 8;
        }
        int dx = hidGetField(rpt, got, base, &d.layout.x);
        int dy = hidGetField(rpt, got, base, &d.layout.y);
        int wh = hidGetField(rpt, got, base, &d.layout.wheel);
        ubyte btn = 0;
        for (uint i = 0; i < d.layout.btnCount; i++)
        {
            uint bit = base + d.layout.btnOff + i;
            if (bit < got * 8 && ((volatileLoad(rpt + (bit >> 3)) >> (bit & 7)) & 1))
                btn |= cast(ubyte)(1 << i);
        }
        if (d.layout.x.absolute && d.layout.y.absolute)
        {
            // A tablet (VirtualBox, QEMU "usb-tablet"): the values are a position within a range,
            // scaled to the screen. The host and the guest cursors are then always in the same place.
            long rx = cast(long)d.layout.x.logMax - d.layout.x.logMin;
            long ry = cast(long)d.layout.y.logMax - d.layout.y.logMin;
            if (rx > 0 && ry > 0)
            {
                long px = (cast(long)dx - d.layout.x.logMin) * mouse.xBound / rx;
                long py = (cast(long)dy - d.layout.y.logMin) * mouse.yBound / ry;
                mouseMoveTo(cast(int)px, cast(int)py, btn & 0x07);
            }
        }
        else
            mouseMove(dx, dy, btn & 0x07);
        mouse.wheel += wh;
    }
    else if (got >= 3)
    {
        // Boot protocol: buttons, dx, dy[, wheel]
        byte dx = cast(byte)volatileLoad(rpt + 1);
        byte dy = cast(byte)volatileLoad(rpt + 2);
        mouseMove(dx, dy, volatileLoad(rpt) & 0x07);
    }
}

// Completion codes that leave the endpoint halted but the device usable.
bool xhciRecoverableCode(uint code) @nogc nothrow
{
    return code == CC_TRANSACTION_ERROR || code == CC_BABBLE || code == CC_STALL;
}

void xhciHandleMouseEvent(XhciUsbDevice* d, uint code, uint residual) @nogc nothrow
{
    if (d.mouseRecover)
        return;                     // halted: nothing more is expected until the endpoint is reset
    if (code != CC_SUCCESS && code != CC_SHORT_PACKET)
    {
        // A transaction error, babble or stall halts the endpoint. Glitches like these are
        // common on real hardware, so try to reset it (xhciRecoverInputs, from the main loop).
        if (xhciRecoverableCode(code) && d.mouseErrs < XHCI_MAX_EP_ERRORS)
        {
            d.mouseErrs++;
            d.mouseRecover = true;
            return;
        }
        kprintf("USB mouse: transfer error %u, stopping\n", code);
        d.mouseActive = false;
        return;
    }
    d.mouseErrs = 0;

    uint buf = d.rptHead % XHCI_RPT_BUFS;
    ulong bufOff = 1024 + cast(ulong)buf * XHCI_RPT_STRIDE;
    uint len = d.reportLen;
    uint got = residual <= len ? len - residual : 0;

    if (got > 0 && !d.gotFirstReport)
    {
        d.gotFirstReport = true;
        if (xhciDebugReports)
            kprintf("USB mouse: first report received\n");
    }
    xhciProcessReport(d, d.dma + bufOff, got);

    // Completions arrive in queue order, so this buffer is free again: re-queue it.
    d.rptHead++;
    xhciRingPush(&d.intRing, d.dmaPhys + bufOff, d.reportLen, (TRB_NORMAL << 10) | TRB_IOC | TRB_ISP);
    xhciRingDoorbell(d.slotId, d.intDci);
}

void xhciHandleKeyboardEvent(XhciUsbDevice* d, uint code, uint residual) @nogc nothrow
{
    XhciKbd* k = &d.kbd;
    if (k.recover)
        return;
    if (code != CC_SUCCESS && code != CC_SHORT_PACKET)
    {
        usbKbdStop(&k.state);       // also ends any auto-repeat
        if (xhciRecoverableCode(code) && k.errs < XHCI_MAX_EP_ERRORS)
        {
            k.errs++;
            k.recover = true;
            return;
        }
        kprintf("USB keyboard: transfer error %u, stopping\n", code);
        k.active = false;
        return;
    }
    k.errs = 0;

    uint buf = k.rptHead % XHCI_RPT_BUFS;
    ulong bufOff = XHCI_KBD_BUF_OFF + cast(ulong)buf * XHCI_RPT_STRIDE;
    uint len = k.reportLen;
    uint got = residual <= len ? len - residual : 0;

    // Copy out of DMA memory (volatile reads), then decode.
    ubyte[8] rpt;
    uint n = got > 8 ? 8 : got;
    for (uint i = 0; i < n; i++)
        rpt[i] = volatileLoad(d.dma + bufOff + i);
    usbKbdProcessReport(&k.state, rpt.ptr, n);

    // Completions arrive in queue order, so this buffer is free again: re-queue it.
    k.rptHead++;
    xhciRingPush(&k.intRing, d.dmaPhys + bufOff, k.reportLen, (TRB_NORMAL << 10) | TRB_IOC | TRB_ISP);
    xhciRingDoorbell(d.slotId, k.intDci);
}

void xhciHandleEvent(ulong param, uint status, uint control) @nogc nothrow
{
    uint type = (control >> 10) & 0x3F;
    uint code = status >> 24;

    if (type == TRB_EV_CMD_COMPLETE)
    {
        if (param == xhci.cmdWait)
        {
            xhci.cmdCode = code;
            xhci.cmdSlot = control >> 24;
            xhci.cmdDone = true;
        }
    }
    else if (type == TRB_EV_TRANSFER)
    {
        uint slot = control >> 24;
        uint epId = (control >> 16) & 0x1F;
        if (slot == 0 || slot > XHCI_MAX_SLOTS)
            return;
        XhciUsbDevice* d = &xhci.devs[slot];
        if (epId == 1)
        {
            if (param == d.ep0Wait || (code != CC_SUCCESS && code != CC_SHORT_PACKET))
            {
                d.ep0Code = code;
                d.ep0Done = true;
            }
        }
        else if (d.mouseActive && epId == d.intDci)
        {
            xhciHandleMouseEvent(d, code, status & 0xFFFFFF);
        }
        else if (d.kbd.active && epId == d.kbd.intDci)
        {
            xhciHandleKeyboardEvent(d, code, status & 0xFFFFFF);
        }
        else if (d.msc.active && (epId == d.msc.inDci || epId == d.msc.outDci))
        {
            if (param == d.msc.xferWait || (code != CC_SUCCESS && code != CC_SHORT_PACKET))
            {
                d.msc.xferCode = code;
                d.msc.xferResidual = status & 0xFFFFFF;
                d.msc.xferDone = true;
            }
        }
    }
    // Port status change and everything else: ignored (no hot-plug yet).
}

// Drain the event ring. Cheap when empty (one memory read), so main() can
// call it every loop iteration.
void xhciPollEvents() @nogc nothrow
{
    if (!xhci.running)
        return;

    bool any = false;
    for (;;)
    {
        XhciTrb* t = &xhci.evRing.trbs[xhci.evRing.deq];
        uint control = volatileLoad(&t.control);
        if ((control & 1) != xhci.evRing.cycle)
            break;
        ulong param = volatileLoad(&t.param);
        uint status = volatileLoad(&t.status);

        xhciHandleEvent(param, status, control);

        any = true;
        xhci.evRing.deq++;
        if (xhci.evRing.deq == XHCI_RING_TRBS)
        {
            xhci.evRing.deq = 0;
            xhci.evRing.cycle ^= 1;
        }
    }

    if (any)
    {
        // Tell the controller how far we got; bit 3 (EHB) is write-1-to-clear.
        ulong erdp = xhci.evRing.phys + cast(ulong)xhci.evRing.deq * XhciTrb.sizeof;
        xhciWr64(xhci.rt, 0x20 + 0x18, erdp | 8);
    }
}

public void usbPoll() @nogc nothrow
{
    for (uint i = 0; i < xhciCount; i++)
    {
        xhci = &xhciControllers[i];
        xhciPollEvents();
        xhciRecoverInputs();
    }
    usbKbdRepeatTick();     // USB keyboards do not auto-repeat by themselves
}

// commands

// Run one command synchronously. Returns true if it completed with success.
bool xhciCommand(ulong param, uint control, uint* outSlot) @nogc nothrow
{
    xhci.cmdDone = false;
    xhci.cmdWait = xhciRingPush(&xhci.cmdRing, param, 0, control);
    xhciRingDoorbell(0, 0);

    ulong dl = xhciDeadline(1000);
    while (!xhci.cmdDone)
    {
        xhciPollEvents();
        if (clockNowNs() > dl)
        {
            kprintf("xHCI: command timed out\n");
            return false;
        }
    }
    if (xhci.cmdCode != CC_SUCCESS)
    {
        kprintf("xHCI: command failed, completion code %u\n", xhci.cmdCode);
        return false;
    }
    if (outSlot)
        *outSlot = xhci.cmdSlot;
    return true;
}

// control transfers

// EP0 control transfer. bufPhys must point to DMA memory when length != 0.
bool xhciControl(XhciUsbDevice* d, ubyte reqType, ubyte req, ushort value,
                 ushort index, ushort length, ulong bufPhys) @nogc nothrow
{
    bool dirIn = (reqType & 0x80) != 0;
    ulong setup = cast(ulong)reqType
                | (cast(ulong)req << 8)
                | (cast(ulong)value << 16)
                | (cast(ulong)index << 32)
                | (cast(ulong)length << 48);
    uint trt = length == 0 ? 0 : (dirIn ? 3 : 2);

    xhciRingPush(&d.ep0Ring, setup, 8, (TRB_SETUP << 10) | TRB_IDT | (trt << 16));
    if (length != 0)
        xhciRingPush(&d.ep0Ring, bufPhys, length, (TRB_DATA << 10) | (dirIn ? TRB_DIR_IN : 0));
    // Status stage goes the opposite way of the data stage (IN if no data).
    uint statusDir = (length != 0 && dirIn) ? 0 : TRB_DIR_IN;
    d.ep0Done = false;
    d.ep0Wait = xhciRingPush(&d.ep0Ring, 0, 0, (TRB_STATUS << 10) | TRB_IOC | statusDir);
    xhciRingDoorbell(d.slotId, 1);

    ulong dl = xhciDeadline(1000);
    while (!d.ep0Done)
    {
        xhciPollEvents();
        if (clockNowNs() > dl)
        {
            kprintf("USB: control transfer timed out\n");
            return false;
        }
    }
    if (d.ep0Code != CC_SUCCESS && d.ep0Code != CC_SHORT_PACKET)
    {
        kprintf("USB: control transfer failed, code %u\n", d.ep0Code);
        return false;
    }
    return true;
}

// input context

void xhciCtxW32(ubyte* ctx, uint contextIndex, uint dword, uint v) @nogc nothrow
{
    volatileStore(cast(uint*)(ctx + contextIndex * xhci.ctxSize + dword * 4), v);
}

// Slot context of the input context: speed, where the device is (route string, root
// port, hub and transaction translator) and, for a hub, its port count.
void xhciWriteSlotCtx(XhciUsbDevice* d, uint entries) @nogc nothrow
{
    uint dw0 = (d.route & 0xFFFFF) | (cast(uint)d.speed << 20) | (entries << 27);
    uint dw1 = cast(uint)d.port << 16;
    uint dw2 = cast(uint)d.ttSlot | (cast(uint)d.ttPort << 8);
    if (d.isHub)
    {
        dw0 |= 1u << 25;
        dw1 |= cast(uint)d.hubPorts << 24;
        dw2 |= cast(uint)d.hubTtt << 16;
    }
    xhciCtxW32(d.inCtx, 1, 0, dw0);
    xhciCtxW32(d.inCtx, 1, 1, dw1);
    xhciCtxW32(d.inCtx, 1, 2, dw2);
}

// Fill an endpoint context. Index in the input context is dci + 1.
void xhciFillEpCtx(XhciUsbDevice* d, uint dci, uint epType, uint mps,
                   uint interval, XhciRing* ring, uint avgLen) @nogc nothrow
{
    uint ci = dci + 1;
    xhciCtxW32(d.inCtx, ci, 0, interval << 16);
    xhciCtxW32(d.inCtx, ci, 1, (3 << 1) | (epType << 3) | (mps << 16));    // CErr=3
    xhciCtxW32(d.inCtx, ci, 2, cast(uint)(ring.phys) | 1);                 // DCS=1
    xhciCtxW32(d.inCtx, ci, 3, cast(uint)(ring.phys >> 32));
    xhciCtxW32(d.inCtx, ci, 4, avgLen | (avgLen << 16));                   // avg TRB len | max ESIT
}

uint xhciDefaultEp0Mps(uint speed) @nogc nothrow
{
    if (speed == 4 || speed == 5) return 512;   // SuperSpeed
    if (speed == 3) return 64;                  // High speed
    return 8;                                   // Low/Full: learn it from the descriptor
}

// descriptors

// Walk a configuration descriptor looking for a HID boot mouse.
void xhciParseConfig(XhciUsbDevice* d, ubyte* buf, uint len) @nogc nothrow
{
    d.cfgValue = volatileLoad(buf + 5);
    bool inMouse = false;
    bool inKbd = false;
    bool inMsc = false;
    uint i = 0;
    while (i + 2 <= len)
    {
        uint dlen = volatileLoad(buf + i);
        uint dtype = volatileLoad(buf + i + 1);
        if (dlen < 2 || i + dlen > len)
            break;

        if (dtype == 4 && dlen >= 9)            // interface
        {
            ubyte alt = volatileLoad(buf + i + 3);
            ubyte cls = volatileLoad(buf + i + 5);
            ubyte sub = volatileLoad(buf + i + 6);
            ubyte prot = volatileLoad(buf + i + 7);
            kprintf("  iface %u alt %u: class %u sub %u proto %u\n",
                    cast(uint)volatileLoad(buf + i + 2), cast(uint)alt,
                    cast(uint)cls, cast(uint)sub, cast(uint)prot);
            // A boot protocol mouse is preferred. Any other HID interface (a tablet reports
            // as sub 0, proto 0) is only a candidate: xhciSetupMouse() reads its report descriptor
            // and gives up on it if it is not a pointer.
            bool bootMouse = (alt == 0 && cls == 3 && sub == 1 && prot == 2);
            bool otherHid = (alt == 0 && cls == 3 && sub == 0 && prot == 0);
            inMouse = false;
            if (bootMouse && (!d.hasMouse || d.mouseNeedsDesc))
            {
                inMouse = true;
                d.mouseNeedsDesc = false;
                d.hasMouse = false;         // replaces a candidate found earlier
                d.hidReportLen = 0;
            }
            else if (otherHid && !d.hasMouse)
            {
                inMouse = true;
                d.mouseNeedsDesc = true;
                d.hidReportLen = 0;
            }
            if (inMouse)
                d.ifaceNum = volatileLoad(buf + i + 2);
            inKbd = (alt == 0 && cls == 3 && sub == 1 && prot == 1 && !d.kbd.found);
            if (inKbd)
                d.kbd.ifaceNum = volatileLoad(buf + i + 2);
            // Mass storage, SCSI transparent command set, Bulk-Only Transport
            inMsc = (alt == 0 && cls == 8 && sub == 6 && prot == 0x50 && !d.msc.found);
            if (inMsc)
            {
                d.msc.ifaceNum = volatileLoad(buf + i + 2);
                d.msc.inAddr = 0;
                d.msc.outAddr = 0;
            }
        }
        else if (dtype == 5 && dlen >= 7 && inMsc)     // endpoint of the storage interface
        {
            ubyte addr = volatileLoad(buf + i + 2);
            ubyte attr = volatileLoad(buf + i + 3);
            uint mps = (volatileLoad(buf + i + 4) | (volatileLoad(buf + i + 5) << 8)) & 0x7FF;
            if ((attr & 3) == 2)                        // bulk
            {
                if (addr & 0x80)
                {
                    d.msc.inAddr = addr;
                    d.msc.inMps = mps;
                }
                else
                {
                    d.msc.outAddr = addr;
                    d.msc.outMps = mps;
                }
                if (d.msc.inAddr != 0 && d.msc.outAddr != 0)
                {
                    d.msc.found = true;
                    inMsc = false;
                }
            }
        }
        else if (dtype == 0x21 && dlen >= 9 && inMouse)   // HID descriptor
        {
            d.hidReportLen = cast(ushort)(volatileLoad(buf + i + 7) | (volatileLoad(buf + i + 8) << 8));
        }
        else if (dtype == 5 && dlen >= 7 && inMouse)   // endpoint
        {
            ubyte addr = volatileLoad(buf + i + 2);
            ubyte attr = volatileLoad(buf + i + 3);
            if ((addr & 0x80) && (attr & 3) == 3)       // interrupt IN
            {
                d.intEpAddr = addr;
                d.intMps = volatileLoad(buf + i + 4) | (volatileLoad(buf + i + 5) << 8);
                d.intMps &= 0x7FF;
                d.intInterval = volatileLoad(buf + i + 6);
                d.hasMouse = true;
                inMouse = false;
            }
        }
        else if (dtype == 5 && dlen >= 7 && inKbd)     // endpoint of the keyboard interface
        {
            ubyte addr = volatileLoad(buf + i + 2);
            ubyte attr = volatileLoad(buf + i + 3);
            if ((addr & 0x80) && (attr & 3) == 3)       // interrupt IN
            {
                d.kbd.intEpAddr = addr;
                d.kbd.intMps = (volatileLoad(buf + i + 4) | (volatileLoad(buf + i + 5) << 8)) & 0x7FF;
                d.kbd.intInterval = volatileLoad(buf + i + 6);
                d.kbd.found = true;
                inKbd = false;
            }
        }
        i += dlen;
    }
}

uint xhciFloorLog2(uint v) @nogc nothrow
{
    uint r = 0;
    while (v > 1) { v >>= 1; r++; }
    return r;
}

// xHCI "Interval" is an exponent: period = 125us * 2^interval.
uint xhciEncodeInterval(uint speed, uint bInterval) @nogc nothrow
{
    if (bInterval == 0) bInterval = 1;
    if (speed == 1 || speed == 2)               // FS/LS: bInterval is in ms
    {
        uint v = xhciFloorLog2(bInterval * 8);
        if (v < 3) v = 3;
        if (v > 10) v = 10;
        return v;
    }
    uint v = bInterval - 1;                     // HS/SS: already 2^(n-1) microframes
    return v > 15 ? 15 : v;
}

// enumeration

// Set Configuration, once per device (a composite device sets up several HID interfaces).
bool xhciEnsureConfigured(XhciUsbDevice* d) @nogc nothrow
{
    if (d.configured)
        return true;
    if (!xhciControl(d, 0x00, 9, d.cfgValue, 0, 0, 0))
        return false;
    d.configured = true;
    return true;
}

bool xhciSetupMouse(XhciUsbDevice* d) @nogc nothrow
{
    if (!xhciEnsureConfigured(d))
        return false;

    // Preferred: read the HID report descriptor and decode reports with it.
    // Fallback: force the BOOT protocol (fixed 3-byte layout).
    bool parsed = false;
    if (d.hidReportLen > 0)
    {
        uint rl = d.hidReportLen > 1000 ? 1000 : d.hidReportLen;
        if (xhciControl(d, 0x81, 6, 0x2200, d.ifaceNum, cast(ushort)rl, d.dmaPhys))
        {
            hidParseReportDescriptor(&d.layout, d.dma, rl);
            parsed = d.layout.valid;
        }
    }
    if (d.mouseNeedsDesc && !(parsed && d.layout.isPointerApp))
    {
        // Some other kind of HID interface (media keys, a gamepad...): not ours
        kprintf("  HID interface %u is not a mouse or tablet, ignoring\n", cast(uint)d.ifaceNum);
        d.hasMouse = false;
        return true;
    }
    if (parsed)
    {
        kprintf("  HID layout: id %u%s, X %u@%u Y %u@%u wheel %u, %u buttons\n",
                cast(uint)d.layout.reportId, d.layout.hasId ? "".ptr : " (none)".ptr,
                d.layout.x.size, d.layout.x.off, d.layout.y.size, d.layout.y.off,
                d.layout.wheel.valid ? d.layout.wheel.size : 0u, d.layout.btnCount);
        if (d.layout.x.absolute && d.layout.y.absolute)
            kprintf("  absolute pointer (tablet): X %u..%u, Y %u..%u\n",
                    cast(uint)d.layout.x.logMin, cast(uint)d.layout.x.logMax,
                    cast(uint)d.layout.y.logMin, cast(uint)d.layout.y.logMax);
    }
    else
    {
        kprintf("  no usable report descriptor, using boot protocol\n");
        if (!xhciControl(d, 0x21, 0x0B, 0, d.ifaceNum, 0, 0))
            return false;
    }

    if (!xhciRingInit(&d.intRing))
        return false;

    uint dci = (d.intEpAddr & 0x0F) * 2 + 1;     // IN endpoint
    d.intDci = cast(ubyte)dci;
    d.reportLen = d.intMps > XHCI_RPT_STRIDE ? XHCI_RPT_STRIDE : d.intMps;

    // Configure Endpoint: add slot context (A0) and the new endpoint.
    memset(d.inCtx, 0, 4096);
    xhciCtxW32(d.inCtx, 0, 1, 1 | (1u << dci));
    xhciWriteSlotCtx(d, dci);
    xhciFillEpCtx(d, dci, 7 /* interrupt IN */, d.intMps,
                  xhciEncodeInterval(d.speed, d.intInterval), &d.intRing, d.intMps);

    if (!xhciCommand(d.inCtxPhys, (TRB_CMD_CONFIGURE_EP << 10) | (cast(uint)d.slotId << 24), null))
        return false;

    // Keep several report buffers queued: with only one, the mouse could
    // deliver at most one report per main-loop iteration.
    d.mouseActive = true;
    d.mouseRecover = false;
    d.mouseErrs = 0;
    d.rptHead = 0;
    for (uint i = 0; i < XHCI_RPT_BUFS; i++)
        xhciRingPush(&d.intRing, d.dmaPhys + 1024 + cast(ulong)i * XHCI_RPT_STRIDE,
                     d.reportLen, (TRB_NORMAL << 10) | TRB_IOC | TRB_ISP);
    xhciRingDoorbell(d.slotId, dci);
    return true;
}

// Bring up a HID boot keyboard: force the boot protocol (fixed 8-byte reports, no
// report descriptor to parse), add its interrupt endpoint, queue report buffers.
bool xhciSetupKeyboard(XhciUsbDevice* d) @nogc nothrow
{
    XhciKbd* k = &d.kbd;

    if (!xhciEnsureConfigured(d))
        return false;

    // Devices start in report protocol; boot protocol guarantees the layout
    // usbkbd.d decodes. Not fatal if refused: most keyboards use that layout anyway.
    if (!xhciControl(d, 0x21, 0x0B, 0, k.ifaceNum, 0, 0))
        kprintf("  keyboard: Set Protocol (boot) refused, assuming the boot layout\n");

    if (!xhciRingInit(&k.intRing))
        return false;

    uint dci = (k.intEpAddr & 0x0F) * 2 + 1;     // IN endpoint
    k.intDci = cast(ubyte)dci;
    k.reportLen = k.intMps > XHCI_RPT_STRIDE ? XHCI_RPT_STRIDE : k.intMps;

    // Configure Endpoint: add the keyboard endpoint. If the mouse endpoint of the
    // same device is already running, the slot's context-entry count must still cover it.
    uint maxDci = dci;
    if (d.mouseActive && d.intDci > maxDci)
        maxDci = d.intDci;

    memset(d.inCtx, 0, 4096);
    xhciCtxW32(d.inCtx, 0, 1, 1 | (1u << dci));
    xhciWriteSlotCtx(d, maxDci);
    xhciFillEpCtx(d, dci, 7 /* interrupt IN */, k.intMps,
                  xhciEncodeInterval(d.speed, k.intInterval), &k.intRing, k.intMps);

    if (!xhciCommand(d.inCtxPhys, (TRB_CMD_CONFIGURE_EP << 10) | (cast(uint)d.slotId << 24), null))
        return false;

    usbKbdStop(&k.state);
    k.active = true;
    k.recover = false;
    k.errs = 0;
    k.rptHead = 0;
    for (uint i = 0; i < XHCI_RPT_BUFS; i++)
        xhciRingPush(&k.intRing, d.dmaPhys + XHCI_KBD_BUF_OFF + cast(ulong)i * XHCI_RPT_STRIDE,
                     k.reportLen, (TRB_NORMAL << 10) | TRB_IOC | TRB_ISP);
    xhciRingDoorbell(d.slotId, dci);
    return true;
}

// Bring up the two bulk endpoints of a mass storage interface.
bool xhciSetupStorage(XhciUsbDevice* d) @nogc nothrow
{
    XhciMsc* m = &d.msc;

    if (!xhciEnsureConfigured(d))
        return false;

    if (!xhciRingInit(&m.inRing) || !xhciRingInit(&m.outRing))
        return false;

    // 64 KiB bounce buffer, 64 KiB aligned (16 pages): one TRB never crosses a 64 KiB boundary.
    ulong bp = pmmAllocContiguousZeroed(XHCI_MSC_BOUNCE_PAGES, XHCI_MSC_BOUNCE_PAGES, PMM_LIMIT_4G);
    if (bp == 0)
        return false;
    m.bounce = cast(ubyte*)pmmPhysToVirt(bp);
    m.bouncePhys = bp;

    uint inDci = (m.inAddr & 0x0F) * 2 + 1;
    uint outDci = (m.outAddr & 0x0F) * 2;
    m.inDci = cast(ubyte)inDci;
    m.outDci = cast(ubyte)outDci;
    uint maxDci = inDci > outDci ? inDci : outDci;

    memset(d.inCtx, 0, 4096);
    xhciCtxW32(d.inCtx, 0, 1, 1 | (1u << inDci) | (1u << outDci));
    xhciWriteSlotCtx(d, maxDci);
    xhciFillBulkCtx(d, inDci, 6 /* bulk IN */, m.inMps, &m.inRing);
    xhciFillBulkCtx(d, outDci, 2 /* bulk OUT */, m.outMps, &m.outRing);

    if (!xhciCommand(d.inCtxPhys, (TRB_CMD_CONFIGURE_EP << 10) | (cast(uint)d.slotId << 24), null))
        return false;

    m.active = true;
    return true;
}

// Endpoint context for a bulk endpoint (no interval, no max ESIT payload).
void xhciFillBulkCtx(XhciUsbDevice* d, uint dci, uint epType, uint mps, XhciRing* ring) @nogc nothrow
{
    uint ci = dci + 1;
    xhciCtxW32(d.inCtx, ci, 0, 0);
    xhciCtxW32(d.inCtx, ci, 1, (3 << 1) | (epType << 3) | (mps << 16));    // CErr=3, max burst 0
    xhciCtxW32(d.inCtx, ci, 2, cast(uint)(ring.phys) | 1);                 // DCS=1
    xhciCtxW32(d.inCtx, ci, 3, cast(uint)(ring.phys >> 32));
    xhciCtxW32(d.inCtx, ci, 4, 1024);                                      // average TRB length
}

/// Point the xHCI at controller `index` (see xhciControllers).
public void xhciSelect(uint index) @nogc nothrow
{
    if (index < XHCI_MAX_CONTROLLERS)
        xhci = &xhciControllers[index];
}

/// The nth storage device across all controllers (selects its controller). Null when there is none.
public XhciUsbDevice* xhciFindStorage(uint nth, uint* controller) @nogc nothrow
{
    uint seen = 0;
    for (uint c = 0; c < xhciCount; c++)
    {
        for (uint s = 1; s <= XHCI_MAX_SLOTS; s++)
        {
            XhciUsbDevice* d = &xhciControllers[c].devs[s];
            if (d.present && d.msc.active)
            {
                if (seen == nth)
                {
                    *controller = c;
                    xhciSelect(c);
                    return d;
                }
                seen++;
            }
        }
    }
    return null;
}

// After a failed or timed-out transfer: stop/reset the endpoint and move its ring's
// dequeue pointer to where we will enqueue next, so the ring is usable again.
void xhciRecoverEp(XhciUsbDevice* d, XhciRing* ring, uint dci, bool halted) @nogc nothrow
{
    uint ctl = (dci << 16) | (cast(uint)d.slotId << 24);
    xhciCommand(0, ((halted ? TRB_CMD_RESET_EP : TRB_CMD_STOP_EP) << 10) | ctl, null);
    ulong deq = ring.phys + cast(ulong)ring.enq * XhciTrb.sizeof;
    xhciCommand(deq | ring.cycle, (TRB_CMD_SET_TR_DEQ << 10) | ctl, null);
}

// Reset a halted interrupt endpoint and point its ring past everything queued so far
// (the unfinished buffers are dropped; the caller queues fresh ones).
bool xhciResetIntEp(XhciUsbDevice* d, XhciRing* ring, uint dci) @nogc nothrow
{
    uint ctl = (dci << 16) | (cast(uint)d.slotId << 24);
    if (!xhciCommand(0, (TRB_CMD_RESET_EP << 10) | ctl, null))
        return false;
    ulong deq = ring.phys + cast(ulong)ring.enq * XhciTrb.sizeof;
    return xhciCommand(deq | ring.cycle, (TRB_CMD_SET_TR_DEQ << 10) | ctl, null);
}

// Restart the mouse and keyboard endpoints that a transfer error halted. This runs from
// usbPoll(), never from the event handler: it issues commands, which wait for events.
void xhciRecoverInputs() @nogc nothrow
{
    for (uint s = 1; s <= XHCI_MAX_SLOTS; s++)
    {
        XhciUsbDevice* d = &xhci.devs[s];
        if (!d.present)
            continue;

        if (d.mouseRecover)
        {
            d.mouseRecover = false;
            if (d.mouseActive)
            {
                if (xhciResetIntEp(d, &d.intRing, d.intDci))
                {
                    d.rptHead = 0;
                    for (uint i = 0; i < XHCI_RPT_BUFS; i++)
                        xhciRingPush(&d.intRing, d.dmaPhys + 1024 + cast(ulong)i * XHCI_RPT_STRIDE,
                                     d.reportLen, (TRB_NORMAL << 10) | TRB_IOC | TRB_ISP);
                    xhciRingDoorbell(d.slotId, d.intDci);
                    kprintf("USB mouse: recovered from a transfer error\n");
                }
                else
                {
                    kprintf("USB mouse: could not recover from a transfer error, stopping\n");
                    d.mouseActive = false;
                }
            }
        }

        XhciKbd* k = &d.kbd;
        if (k.recover)
        {
            k.recover = false;
            if (k.active)
            {
                if (xhciResetIntEp(d, &k.intRing, k.intDci))
                {
                    k.rptHead = 0;
                    for (uint i = 0; i < XHCI_RPT_BUFS; i++)
                        xhciRingPush(&k.intRing, d.dmaPhys + XHCI_KBD_BUF_OFF + cast(ulong)i * XHCI_RPT_STRIDE,
                                     k.reportLen, (TRB_NORMAL << 10) | TRB_IOC | TRB_ISP);
                    xhciRingDoorbell(d.slotId, k.intDci);
                    kprintf("USB keyboard: recovered from a transfer error\n");
                }
                else
                {
                    kprintf("USB keyboard: could not recover from a transfer error, stopping\n");
                    k.active = false;
                }
            }
        }
    }
}

/// One synchronous bulk transfer of `len` bytes (<= 64 KiB, not crossing a 64 KiB
/// boundary) at `bufPhys`. Returns BULK_OK / BULK_STALL / BULK_ERROR / BULK_TIMEOUT;
/// on any failure the endpoint ring has already been recovered. `actual` gets the
/// number of bytes that were really transferred.
public int xhciBulkXfer(XhciUsbDevice* d, bool dirIn, ulong bufPhys, uint len, uint* actual) @nogc nothrow
{
    XhciMsc* m = &d.msc;
    XhciRing* ring = dirIn ? &m.inRing : &m.outRing;
    uint dci = dirIn ? m.inDci : m.outDci;

    *actual = 0;
    m.xferDone = false;
    m.xferWait = xhciRingPush(ring, bufPhys, len, (TRB_NORMAL << 10) | TRB_IOC | TRB_ISP);
    xhciRingDoorbell(d.slotId, dci);

    ulong dl = xhciDeadline(5000);
    while (!m.xferDone)
    {
        xhciPollEvents();
        if (clockNowNs() > dl)
        {
            kprintf("USB: bulk transfer timed out\n");
            xhciRecoverEp(d, ring, dci, false);
            return BULK_TIMEOUT;
        }
    }

    if (m.xferCode == CC_SUCCESS || m.xferCode == CC_SHORT_PACKET)
    {
        *actual = len - m.xferResidual;
        return BULK_OK;
    }

    bool stall = m.xferCode == CC_STALL;
    xhciRecoverEp(d, ring, dci, true);
    return stall ? BULK_STALL : BULK_ERROR;
}

/// CLEAR_FEATURE(ENDPOINT_HALT) on the device side.
public bool xhciClearHalt(XhciUsbDevice* d, bool dirIn) @nogc nothrow
{
    ubyte addr = dirIn ? d.msc.inAddr : d.msc.outAddr;
    return xhciControl(d, 0x02, 1, 0, addr, 0, 0);
}

// Free the DMA memory of a ring.
void xhciFreeRing(XhciRing* r) @nogc nothrow
{
    if (r.trbs !is null)
        pmmFreePages(r.phys, 1);
    r.trbs = null;
    r.phys = 0;
}

/// Take a device (and, for a hub, everything behind it) out of service: tell the
/// controller to drop its slot, then give the memory back.
void xhciRemoveSlot(uint slot) @nogc nothrow
{
    if (slot == 0 || slot > XHCI_MAX_SLOTS)
        return;
    XhciUsbDevice* d = &xhci.devs[slot];

    if (d.isHub)
    {
        d.isHub = false;                    // no more polling while we tear it down
        for (uint p = 1; p < 16; p++)
        {
            ubyte c = d.hubChild[p];
            d.hubChild[p] = 0;
            if (c != 0 && c != XHCI_PORT_FAILED)
                xhciRemoveSlot(c);
        }
    }

    // From here on the event handler and the drivers ignore the device.
    d.mouseActive = false;
    d.mouseRecover = false;
    d.kbd.active = false;
    d.kbd.recover = false;
    d.msc.active = false;
    d.present = false;
    usbKbdStop(&d.kbd.state);               // a key held down while the keyboard went away must not repeat

    bool released = true;
    if (xhci.running)
        released = xhciCommand(0, (TRB_CMD_DISABLE_SLOT << 10) | (slot << 24), null);
    volatileStore(&xhci.dcbaa[slot], 0UL);

    if (released)
    {
        if (d.devCtx !is null)
            pmmFreePages(d.devCtxPhys, 1);
        if (d.inCtx !is null)
            pmmFreePages(d.inCtxPhys, 1);
        if (d.dma !is null)
            pmmFreePages(d.dmaPhys, 1);
        xhciFreeRing(&d.ep0Ring);
        xhciFreeRing(&d.intRing);
        xhciFreeRing(&d.kbd.intRing);
        xhciFreeRing(&d.msc.inRing);
        xhciFreeRing(&d.msc.outRing);
        if (d.msc.bounce !is null)
            pmmFreePages(d.msc.bouncePhys, XHCI_MSC_BOUNCE_PAGES);
    }
    *d = XhciUsbDevice.init;
    xhciTopologyGen++;
}

// ---------------------------------------------------------------------------
// hubs
//
// A hub is driven only through control transfers on its EP0 (class requests for
// port status, reset and power); its status-change interrupt endpoint is not
// used. The port states are simply read again every 250 ms (xhciHubPoll).
// ---------------------------------------------------------------------------

bool xhciHubSetFeature(XhciUsbDevice* h, uint port, uint feature) @nogc nothrow
{
    return xhciControl(h, 0x23, 3, cast(ushort)feature, cast(ushort)port, 0, 0);
}

bool xhciHubClearFeature(XhciUsbDevice* h, uint port, uint feature) @nogc nothrow
{
    return xhciControl(h, 0x23, 1, cast(ushort)feature, cast(ushort)port, 0, 0);
}

// GET_STATUS of a hub port: wPortStatus and wPortChange.
bool xhciHubPortStatus(XhciUsbDevice* h, uint port, uint* status, uint* change) @nogc nothrow
{
    if (!xhciControl(h, 0xA3, 0, 0, cast(ushort)port, 4, h.dmaPhys))
        return false;
    *status = volatileLoad(h.dma) | (cast(uint)volatileLoad(h.dma + 1) << 8);
    *change = volatileLoad(h.dma + 2) | (cast(uint)volatileLoad(h.dma + 3) << 8);
    return true;
}

// Reset a hub port. Returns the speed id (xHCI numbering) of the device that is
// then enabled, or 0.
uint xhciHubResetPort(XhciUsbDevice* h, uint port) @nogc nothrow
{
    if (!xhciHubSetFeature(h, port, 4))                 // PORT_RESET
        return 0;
    uint status = 0, change = 0;
    bool done = false;
    for (uint i = 0; i < 60 && !done; i++)
    {
        clockDelayMs(10);
        if (!xhciHubPortStatus(h, port, &status, &change))
            return 0;
        done = (change & 0x10) != 0;                    // C_PORT_RESET
    }
    if (!done)
        return 0;
    xhciHubClearFeature(h, port, 20);                   // C_PORT_RESET
    xhciHubClearFeature(h, port, 16);                   // C_PORT_CONNECTION
    clockDelayMs(10);                                   // reset recovery time
    if (!xhciHubPortStatus(h, port, &status, &change))
        return 0;
    if ((status & 3) != 3)                              // connected and enabled
        return 0;
    if (h.speed >= 4)
        return 4;
    if (status & 0x200)
        return 2;                                       // low speed
    if (status & 0x400)
        return 3;                                       // high speed
    return 1;
}

// Compare every port of a hub with what we have brought up: new devices get
// enumerated, vanished ones are taken out of service.
void xhciHubScan(XhciUsbDevice* h) @nogc nothrow
{
    for (uint p = 1; p <= h.hubPorts; p++)
    {
        if (!h.present || !h.isHub)
            return;                                     // removed while we were busy

        uint status, change;
        if (!xhciHubPortStatus(h, p, &status, &change))
        {
            h.hubDead = true;                           // a failed control transfer leaves EP0 unusable
            kprintf("USB: hub on slot %u stopped answering\n", cast(uint)h.slotId);
            return;
        }
        for (uint b = 0; b < 5; b++)
            if (change & (1u << b))
                xhciHubClearFeature(h, p, 16 + b);

        bool connected = (status & 1) != 0;
        ubyte child = h.hubChild[p];
        if (child != 0 && (!connected || (change & 1)))
        {
            if (child != XHCI_PORT_FAILED)
            {
                kprintf("USB: device removed from hub slot %u port %u\n", cast(uint)h.slotId, p);
                xhciRemoveSlot(child);
            }
            child = 0;
            h.hubChild[p] = 0;
        }
        if (!connected || child != 0)
            continue;

        kprintf("USB: device connected to hub slot %u port %u\n", cast(uint)h.slotId, p);
        clockDelayMs(100);                              // let the connection settle
        uint speed = xhciHubResetPort(h, p);
        if (speed == 0)
        {
            kprintf("USB: hub port %u: reset failed\n", p);
            h.hubChild[p] = XHCI_PORT_FAILED;
            continue;
        }
        uint slot = xhciSetupDevice(h.port, speed, h, p);
        h.hubChild[p] = slot != 0 ? cast(ubyte)slot : XHCI_PORT_FAILED;
    }
}

// Called from xhciInitDevice() for a device with class 9 (hub).
bool xhciSetupHub(XhciUsbDevice* d) @nogc nothrow
{
    bool ss = d.speed >= 4;
    kprintf("  hub (%s)\n", ss ? "SuperSpeed".ptr : "USB 2.0".ptr);
    if (d.depth >= XHCI_MAX_HUB_DEPTH)
    {
        kprintf("  hubs nested too deep, ignoring it\n");
        return true;
    }

    if (!xhciControl(d, 0x80, 6, 0x0200, 0, 9, d.dmaPhys))
        return false;
    d.cfgValue = volatileLoad(d.dma + 5);
    if (!xhciEnsureConfigured(d))
        return false;
    if (ss && !xhciControl(d, 0x20, 12, d.depth, 0, 0, 0))      // SET_HUB_DEPTH
        kprintf("  hub: Set Hub Depth failed\n");

    // Hub descriptor (0x29 for USB 2.0 hubs, 0x2A for SuperSpeed ones).
    if (!xhciControl(d, 0xA0, 6, cast(ushort)(ss ? 0x2A00 : 0x2900), 0, 12, d.dmaPhys))
        return false;
    uint ports = volatileLoad(d.dma + 2);
    uint chars = volatileLoad(d.dma + 3) | (cast(uint)volatileLoad(d.dma + 4) << 8);
    uint powerGood = volatileLoad(d.dma + 5);
    if (ports == 0)
    {
        kprintf("  hub reports no ports, ignoring it\n");
        return true;
    }
    if (ports > 15)
    {
        kprintf("  hub has %u ports, only the first 15 can be used\n", ports);
        ports = 15;                                     // a route string nibble holds 1..15
    }
    d.hubPorts = cast(ubyte)ports;
    d.hubTtt = ss ? cast(ubyte)0 : cast(ubyte)((chars >> 5) & 3);
    d.hubPowerGood = cast(ubyte)powerGood;
    d.isHub = true;

    // Tell the controller it is a hub (port count, think time): a slot context update.
    memset(d.inCtx, 0, 4096);
    xhciCtxW32(d.inCtx, 0, 1, 1);                       // add A0 only
    xhciWriteSlotCtx(d, 1);
    if (!xhciCommand(d.inCtxPhys, (TRB_CMD_CONFIGURE_EP << 10) | (cast(uint)d.slotId << 24), null))
        kprintf("  hub: the controller refused the hub slot context\n");

    kprintf("  %u ports\n", ports);
    for (uint p = 1; p <= ports; p++)
        xhciHubSetFeature(d, p, 8);                     // PORT_POWER
    clockDelayMs(powerGood * 2 + 100);

    xhciHubScan(d);
    return true;
}

// ---------------------------------------------------------------------------
// device bring-up
// ---------------------------------------------------------------------------

// Everything after Enable Slot: address the device, read its descriptors and start
// the drivers (mouse, keyboard, storage, hub). `d` is already filled in with the
// slot id, port, speed and topology.
bool xhciInitDevice(XhciUsbDevice* d) @nogc nothrow
{
    uint slot = d.slotId;
    uint port = d.port;
    uint speed = d.speed;

    d.devCtx = cast(ubyte*)xhciDmaAlloc(1, &d.devCtxPhys);
    d.inCtx  = cast(ubyte*)xhciDmaAlloc(1, &d.inCtxPhys);
    d.dma    = cast(ubyte*)xhciDmaAlloc(1, &d.dmaPhys);
    if (d.devCtx is null || d.inCtx is null || d.dma is null || !xhciRingInit(&d.ep0Ring))
    {
        kprintf("xHCI: out of DMA memory\n");
        return false;
    }
    d.present = true;
    volatileStore(&xhci.dcbaa[slot], d.devCtxPhys);

    // Input context for Address Device: slot context + EP0.
    xhciCtxW32(d.inCtx, 0, 1, 0x3);                                    // add A0, A1
    xhciWriteSlotCtx(d, 1);                                            // route, root port, TT; 1 context entry
    xhciFillEpCtx(d, 1, 4 /* control */, d.ep0Mps, 0, &d.ep0Ring, 8);

    if (!xhciCommand(d.inCtxPhys, (TRB_CMD_ADDRESS_DEVICE << 10) | (slot << 24), null))
        return false;

    // GET_DESCRIPTOR(device), first 8 bytes only -> bMaxPacketSize0.
    if (!xhciControl(d, 0x80, 6, 0x0100, 0, 8, d.dmaPhys))
        return false;
    uint mps0 = volatileLoad(d.dma + 7);
    if (speed >= 4)
        mps0 = 1u << mps0;              // SuperSpeed encodes it as 2^n
    if (mps0 != d.ep0Mps && mps0 >= 8)
    {
        d.ep0Mps = mps0;
        xhciCtxW32(d.inCtx, 0, 1, 0x2); // add A1 only
        xhciFillEpCtx(d, 1, 4, mps0, 0, &d.ep0Ring, 8);
        // The ring dequeue pointer in this context is stale; the controller
        // ignores it on Evaluate Context, only MPS is taken.
        if (!xhciCommand(d.inCtxPhys, (TRB_CMD_EVALUATE_CTX << 10) | (slot << 24), null))
            return false;
    }

    // Full device descriptor.
    if (!xhciControl(d, 0x80, 6, 0x0100, 0, 18, d.dmaPhys))
        return false;
    uint vid = volatileLoad(d.dma + 8) | (volatileLoad(d.dma + 9) << 8);
    uint pid = volatileLoad(d.dma + 10) | (volatileLoad(d.dma + 11) << 8);
    uint devClass = volatileLoad(d.dma + 4);
    d.vid = cast(ushort)vid;
    d.pid = cast(ushort)pid;
    d.devClass = cast(ubyte)devClass;
    if (d.parentSlot != 0)
        kprintf("USB device on hub slot %u port %u: %x:%x class %u\n",
                cast(uint)d.parentSlot, cast(uint)d.parentPort, vid, pid, devClass);
    else
        kprintf("USB device on port %u: %x:%x class %u\n", port, vid, pid, devClass);
    if (devClass == 9)
        return xhciSetupHub(d);

    // Configuration descriptor: 9 bytes first to learn wTotalLength.
    if (!xhciControl(d, 0x80, 6, 0x0200, 0, 9, d.dmaPhys))
        return false;
    uint total = volatileLoad(d.dma + 2) | (volatileLoad(d.dma + 3) << 8);
    if (total > 1000) total = 1000;
    if (total < 9) total = 9;
    if (!xhciControl(d, 0x80, 6, 0x0200, 0, cast(ushort)total, d.dmaPhys))
        return false;
    xhciParseConfig(d, d.dma, total);

    if (d.msc.found)
    {
        kprintf("  USB mass storage (bulk-only): iface %u, in %x, out %x, mps %u/%u\n",
                cast(uint)d.msc.ifaceNum, cast(uint)d.msc.inAddr, cast(uint)d.msc.outAddr,
                d.msc.inMps, d.msc.outMps);
        if (xhciSetupStorage(d))
            kprintf("  storage endpoints running\n");
        else
            kprintf("  storage setup failed\n");
    }

    if (!d.hasMouse && !d.kbd.found)
    {
        if (!d.msc.found)
            kprintf("  not a HID boot mouse or keyboard or storage device, ignoring\n");
        return true;
    }

    bool ok = true;
    if (d.hasMouse)
    {
        kprintf(d.mouseNeedsDesc ? "  HID pointer candidate: iface %u, ep %x, mps %u, interval %u\n"
                                 : "  HID boot mouse: iface %u, ep %x, mps %u, interval %u\n",
                cast(uint)d.ifaceNum, cast(uint)d.intEpAddr, d.intMps, cast(uint)d.intInterval);
        if (xhciSetupMouse(d))
        {
            if (d.mouseActive)
                kprintf("  mouse running\n");
        }
        else
        {
            kprintf("  mouse setup failed\n");
            ok = false;
        }
    }
    if (d.kbd.found)
    {
        kprintf("  HID boot keyboard: iface %u, ep %x, mps %u, interval %u\n",
                cast(uint)d.kbd.ifaceNum, cast(uint)d.kbd.intEpAddr, d.kbd.intMps, cast(uint)d.kbd.intInterval);
        if (xhciSetupKeyboard(d))
            kprintf("  keyboard running\n");
        else
        {
            kprintf("  keyboard setup failed\n");
            ok = false;
        }
    }
    return ok || d.kbd.active || d.mouseActive || d.msc.active;
}


/// Bring up the device on `port` (root port number) at `speed`. `parent` is the hub it
/// is plugged into (null: the root port itself) and `parentPort` its port on that hub.
/// Returns the slot id, or 0 if nothing usable came out of it (the slot is released then).
uint xhciSetupDevice(uint port, uint speed, XhciUsbDevice* parent, uint parentPort) @nogc nothrow
{
    uint slot;
    if (!xhciCommand(0, TRB_CMD_ENABLE_SLOT << 10, &slot))
        return 0;
    if (slot == 0 || slot > XHCI_MAX_SLOTS)
    {
        kprintf("xHCI: unusable slot id %u\n", slot);
        return 0;
    }

    XhciUsbDevice* d = &xhci.devs[slot];
    *d = XhciUsbDevice.init;
    d.slotId = cast(ubyte)slot;
    d.port = cast(ubyte)port;
    d.speed = cast(ubyte)speed;
    d.ep0Mps = xhciDefaultEp0Mps(speed);
    d.serial = ++xhciDeviceSerial;

    if (parent !is null)
    {
        d.parentSlot = parent.slotId;
        d.parentPort = cast(ubyte)parentPort;
        d.depth = cast(ubyte)(parent.depth + 1);
        d.route = parent.route | (parentPort << (4 * parent.depth));
        if (speed <= 2)                                 // LS/FS: needs the transaction translator of a HS hub above
        {
            if (parent.speed == 3)
            {
                d.ttSlot = parent.slotId;
                d.ttPort = cast(ubyte)parentPort;
            }
            else
            {
                d.ttSlot = parent.ttSlot;
                d.ttPort = parent.ttPort;
            }
        }
    }

    if (!xhciInitDevice(d))
    {
        xhciRemoveSlot(slot);
        return 0;
    }
    xhciTopologyGen++;
    return slot;
}

// Reset a port and return its speed id, or 0 if no enabled device results.
uint xhciResetPort(uint port) @nogc nothrow
{
    size_t off = OP_PORTS + (port - 1) * 0x10;
    uint sc = xhciRd32(xhci.op, off);

    if (!(sc & PORT_PED))
    {
        xhciWr32(xhci.op, off, (sc & PORT_PRESERVE) | PORT_PR);
        if (!xhciWaitReg(xhci.op, off, PORT_PRC, PORT_PRC, 500))
            return 0;
        clockDelayMs(10);
        sc = xhciRd32(xhci.op, off);
        xhciWr32(xhci.op, off, (sc & PORT_PRESERVE) | PORT_CHANGE_BITS); // clear change bits
        sc = xhciRd32(xhci.op, off);
    }
    else
    {
        xhciWr32(xhci.op, off, (sc & PORT_PRESERVE) | PORT_CHANGE_BITS);
    }

    if (!(sc & PORT_PED))
        return 0;
    return (sc >> 10) & 0xF;
}

void xhciEnumeratePorts() @nogc nothrow
{
    // Power every port, then give devices time to show up.
    for (uint p = 1; p <= xhci.maxPorts; p++)
    {
        size_t off = OP_PORTS + (p - 1) * 0x10;
        uint sc = xhciRd32(xhci.op, off);
        if (!(sc & PORT_PP))
            xhciWr32(xhci.op, off, (sc & PORT_PRESERVE) | PORT_PP);
    }
    clockDelayMs(150);

    // Real hardware is slower than QEMU: if nothing is connected yet, wait
    // once more before giving up.
    uint connected = 0;
    for (uint pass = 0; pass < 2 && connected == 0; pass++)
    {
        if (pass == 1)
            clockDelayMs(400);
        for (uint p = 1; p <= xhci.maxPorts; p++)
            if (xhciRd32(xhci.op, OP_PORTS + (p - 1) * 0x10) & PORT_CCS)
                connected++;
    }
    kprintf("xHCI: %u of %u ports have a device\n", connected, xhci.maxPorts);

    for (uint p = 1; p <= xhci.maxPorts; p++)
    {
        uint sc = xhciRd32(xhci.op, OP_PORTS + (p - 1) * 0x10);
        if (!(sc & PORT_CCS))
            continue;
        kprintf("xHCI: port %u: PORTSC %x\n", p, sc);
        uint speed = xhciResetPort(p);
        if (speed == 0)
        {
            kprintf("xHCI: port %u: reset failed\n", p);
            xhci.rootChild[p] = XHCI_PORT_FAILED;
            continue;
        }
        uint slot = xhciSetupDevice(p, speed, null, 0);
        xhci.rootChild[p] = slot != 0 ? cast(ubyte)slot : XHCI_PORT_FAILED;
    }

    // Everything that happened up to now has been dealt with: forget the connect changes.
    for (uint p = 1; p <= xhci.maxPorts; p++)
    {
        size_t off = OP_PORTS + (p - 1) * 0x10;
        uint sc = xhciRd32(xhci.op, off);
        if (sc & PORT_CHANGE_BITS)
            xhciWr32(xhci.op, off, (sc & PORT_PRESERVE) | PORT_CHANGE_BITS);
    }
}

// ---------------------------------------------------------------------------
// hot-plug
// ---------------------------------------------------------------------------

// Root ports: a connect-status-change bit means something was plugged in or pulled out.
void xhciRootScan() @nogc nothrow
{
    for (uint p = 1; p <= xhci.maxPorts; p++)
    {
        size_t off = OP_PORTS + (p - 1) * 0x10;
        uint sc = xhciRd32(xhci.op, off);
        if (!(sc & PORT_CSC))
            continue;
        xhciWr32(xhci.op, off, (sc & PORT_PRESERVE) | PORT_CHANGE_BITS);   // acknowledge

        ubyte child = xhci.rootChild[p];
        if (child != 0 && child != XHCI_PORT_FAILED)
        {
            kprintf("USB: device removed from port %u\n", p);
            xhciRemoveSlot(child);
        }
        xhci.rootChild[p] = 0;

        sc = xhciRd32(xhci.op, off);
        if (!(sc & PORT_CCS))
            continue;
        kprintf("USB: device connected to port %u\n", p);
        clockDelayMs(100);                              // let the connection settle
        sc = xhciRd32(xhci.op, off);
        if (!(sc & PORT_CCS))
            continue;                                   // gone again; the next change event will say so
        xhciWr32(xhci.op, off, (sc & PORT_PRESERVE) | PORT_CHANGE_BITS);

        uint speed = xhciResetPort(p);
        if (speed == 0)
        {
            kprintf("USB: port %u: reset failed\n", p);
            xhci.rootChild[p] = XHCI_PORT_FAILED;
            continue;
        }
        uint slot = xhciSetupDevice(p, speed, null, 0);
        xhci.rootChild[p] = slot != 0 ? cast(ubyte)slot : XHCI_PORT_FAILED;
    }
}

void xhciHubPoll() @nogc nothrow
{
    for (uint s = 1; s <= XHCI_MAX_SLOTS; s++)
    {
        XhciUsbDevice* h = &xhci.devs[s];
        if (h.present && h.isHub && !h.hubDead)
            xhciHubScan(h);
    }
}

/// Look for devices that were plugged in or pulled out: root ports every 100 ms,
/// hub ports every 250 ms. This can take a while when something did change (reset,
/// descriptors), so it is called from the main loop and from blocking system calls,
/// never from an interrupt handler. xhciTopologyGen tells the caller that the set
/// of devices changed.
public void xhciHotplugTick() @nogc nothrow
{
    for (uint c = 0; c < xhciCount; c++)
    {
        XhciController* x = &xhciControllers[c];
        if (!x.running)
            continue;
        xhci = x;
        if (clockNowNs() >= x.nextRootScan)
        {
            xhciRootScan();
            x.nextRootScan = clockNowNs() + 100_000_000UL;
        }
        if (clockNowNs() >= x.nextHubScan)
        {
            xhciHubPoll();
            x.nextHubScan = clockNowNs() + 250_000_000UL;
        }
    }
}

/// Print the devices that are up (shell command `usb`).
public void xhciPrintTree() @nogc nothrow
{
    bool any = false;
    for (uint c = 0; c < xhciCount; c++)
    {
        for (uint s = 1; s <= XHCI_MAX_SLOTS; s++)
        {
            XhciUsbDevice* d = &xhciControllers[c].devs[s];
            if (!d.present)
                continue;
            any = true;
            cprintf("xhci%u ", c);
            for (uint i = 0; i < d.depth; i++)
                cprintf("  ");
            if (d.parentSlot != 0)
                cprintf("hub %u port %u", cast(uint)d.parentSlot, cast(uint)d.parentPort);
            else
                cprintf("port %u", cast(uint)d.port);
            const(char)* speed = d.speed == 1 ? "full".ptr : (d.speed == 2 ? "low".ptr : (d.speed == 3 ? "high".ptr : "super".ptr));
            cprintf(": %x:%x %s-speed, ", cast(uint)d.vid, cast(uint)d.pid, speed);
            if (d.isHub)
                cprintf("hub with %u ports", cast(uint)d.hubPorts);
            else if (d.msc.active)
                cprintf("mass storage");
            else if (d.kbd.active && d.mouseActive)
                cprintf("keyboard and mouse");
            else if (d.kbd.active)
                cprintf("keyboard");
            else if (d.mouseActive)
                cprintf("mouse");
            else
                cprintf("class %u (not used)", cast(uint)d.devClass);
            cprintf("\n");
        }
    }
    if (!any)
        cprintf("No USB devices.\n");
}


// Does the controller we are working on drive anything we use?
public bool xhciMouseRunning() @nogc nothrow
{
    for (uint s = 1; s <= XHCI_MAX_SLOTS; s++)
        if (xhci.devs[s].mouseActive)
            return true;
    return false;
}

public bool xhciKeyboardRunning() @nogc nothrow
{
    for (uint s = 1; s <= XHCI_MAX_SLOTS; s++)
        if (xhci.devs[s].kbd.active)
            return true;
    return false;
}

public bool xhciStorageRunning() @nogc nothrow
{
    for (uint s = 1; s <= XHCI_MAX_SLOTS; s++)
        if (xhci.devs[s].msc.active)
            return true;
    return false;
}

/// Is a USB keyboard running on any controller?
public bool xhciAnyKeyboard() @nogc nothrow
{
    for (uint c = 0; c < xhciCount; c++)
        for (uint s = 1; s <= XHCI_MAX_SLOTS; s++)
            if (xhciControllers[c].devs[s].kbd.active)
                return true;
    return false;
}

// Stop the controller (used when it has nothing useful so the next one can be tried).
public void xhciShutdown() @nogc nothrow
{
    if (!xhci.running)
        return;
    xhciWr32(xhci.op, OP_USBCMD, xhciRd32(xhci.op, OP_USBCMD) & ~CMD_RUN);
    xhciWaitReg(xhci.op, OP_USBSTS, STS_HCH, STS_HCH, 500);
    xhci.running = false;
    if (cast(uint)xhci.index + 1 == xhciCount)      // the most recently started one: forget it
        xhciCount--;
}

// controller bring-up

// Ask the BIOS to let go of the controller (USB Legacy Support capability).
void xhciLegacyHandoff() @nogc nothrow
{
    uint xecp = (xhci.hcc1 >> 16) & 0xFFFF;
    if (xecp == 0)
        return;
    ubyte* p = xhci.cap + xecp * 4;
    for (uint guard = 0; guard < 64; guard++)
    {
        uint v = xhciRd32(p, 0);
        if ((v & 0xFF) == 1)
        {
            if (v & (1u << 16)) // BIOS owns it
            {
                xhciWr32(p, 0, v | (1u << 24)); // set OS owned
                if (!xhciWaitReg(p, 0, 1u << 16, 0, 1000))
                    kprintf("xHCI: BIOS did not release the controller\n");
            }
            // Disable SMIs, clear pending SMI events.
            uint c = xhciRd32(p, 4);
            xhciWr32(p, 4, (c & 0xE1FE6) | (7u << 29));
        }
        uint next = (v >> 8) & 0xFF;
        if (next == 0)
            break;
        p += next * 4;
    }
}

// mmio: virtual address of the capability registers (BAR0).
public bool xhciInit(void* mmio) @nogc nothrow
{
    if (mmio is null || xhciCount >= XHCI_MAX_CONTROLLERS)
        return false;
    xhci = &xhciControllers[xhciCount];
    *xhci = XhciController.init;
    xhci.index = cast(ubyte)xhciCount;

    xhci.cap = cast(ubyte*)mmio;
    uint capLength = volatileLoad(xhci.cap) & 0xFF;
    uint hciVersion = volatileLoad(cast(ushort*)(xhci.cap + 2));
    xhci.hcs1 = xhciRd32(xhci.cap, 0x04);
    xhci.hcs2 = xhciRd32(xhci.cap, 0x08);
    xhci.hcc1 = xhciRd32(xhci.cap, 0x10);
    uint dboff = xhciRd32(xhci.cap, 0x14) & ~3u;
    uint rtsoff = xhciRd32(xhci.cap, 0x18) & ~0x1Fu;

    xhci.op = xhci.cap + capLength;
    xhci.rt = xhci.cap + rtsoff;
    xhci.db = xhci.cap + dboff;
    xhci.maxSlots = xhci.hcs1 & 0xFF;
    xhci.maxPorts = (xhci.hcs1 >> 24) & 0xFF;
    xhci.ctxSize = (xhci.hcc1 & (1 << 2)) ? 64 : 32;

    kprintf("xHCI: version %x, %u ports, %u slots, ctx size %u\n",
            hciVersion, xhci.maxPorts, xhci.maxSlots, xhci.ctxSize);

    xhciLegacyHandoff();

    // Stop (if running) and reset.
    uint cmd = xhciRd32(xhci.op, OP_USBCMD);
    if (cmd & CMD_RUN)
    {
        xhciWr32(xhci.op, OP_USBCMD, cmd & ~CMD_RUN);
        if (!xhciWaitReg(xhci.op, OP_USBSTS, STS_HCH, STS_HCH, 500))
            { kprintf("xHCI: would not halt\n"); return false; }
    }
    xhciWr32(xhci.op, OP_USBCMD, CMD_HCRST);
    if (!xhciWaitReg(xhci.op, OP_USBCMD, CMD_HCRST, 0, 1000) ||
        !xhciWaitReg(xhci.op, OP_USBSTS, STS_CNR, 0, 1000))
        { kprintf("xHCI: reset timed out\n"); return false; }

    if (!(xhciRd32(xhci.op, OP_PAGESIZE) & 1))
        { kprintf("xHCI: 4 KiB pages not supported\n"); return false; }

    uint slotsEn = xhci.maxSlots < XHCI_MAX_SLOTS ? xhci.maxSlots : XHCI_MAX_SLOTS;
    xhciWr32(xhci.op, OP_CONFIG, slotsEn);

    // Device Context Base Address Array (256 x 8 bytes).
    xhci.dcbaa = cast(ulong*)xhciDmaAlloc(1, &xhci.dcbaaPhys);
    if (xhci.dcbaa is null)
        return false;

    // Scratchpad buffers the controller wants for its own use.
    uint spb = (((xhci.hcs2 >> 21) & 0x1F) << 5) | ((xhci.hcs2 >> 27) & 0x1F);
    if (spb != 0)
    {
        ulong arrPhys;
        ulong* arr = cast(ulong*)xhciDmaAlloc((spb * 8 + 4095) / 4096, &arrPhys);
        if (arr is null)
            return false;
        for (uint i = 0; i < spb; i++)
        {
            ulong bp;
            if (xhciDmaAlloc(1, &bp) is null)
                return false;
            arr[i] = bp;
        }
        xhci.dcbaa[0] = arrPhys;
    }
    xhciWr64(xhci.op, OP_DCBAAP, xhci.dcbaaPhys);

    // Command ring (RCS = 1 matches our initial producer cycle state).
    if (!xhciRingInit(&xhci.cmdRing))
        return false;
    xhciWr64(xhci.op, OP_CRCR, xhci.cmdRing.phys | 1);

    // Event ring: one segment of 256 TRBs, described by a 1-entry ERST.
    ulong erstPhys;
    ulong* erst = cast(ulong*)xhciDmaAlloc(1, &erstPhys);
    void* evPage = xhciDmaAlloc(1, &xhci.evRing.phys);
    if (erst is null || evPage is null)
        return false;
    xhci.evRing.trbs = cast(XhciTrb*)evPage;
    xhci.evRing.deq = 0;
    xhci.evRing.cycle = 1;
    erst[0] = xhci.evRing.phys;
    erst[1] = XHCI_RING_TRBS;                   // size in low dword, rest reserved

    ubyte* ir = xhci.rt + 0x20;                 // interrupter 0
    xhciWr32(ir, 0x04, 0);                      // IMOD
    xhciWr32(ir, 0x08, 1);                      // ERSTSZ
    xhciWr64(ir, 0x18, xhci.evRing.phys);       // ERDP
    xhciWr64(ir, 0x10, erstPhys);               // ERSTBA - writing this enables the ring

    // Go. Interrupts stay off: we poll the event ring.
    xhciWr32(xhci.op, OP_USBCMD, CMD_RUN);
    if (!xhciWaitReg(xhci.op, OP_USBSTS, STS_HCH, 0, 500))
        { kprintf("xHCI: would not start\n"); return false; }
    xhci.running = true;

    // Smoke test of the command + event ring machinery.
    if (!xhciCommand(0, TRB_CMD_NOOP << 10, null))
        { kprintf("xHCI: No-Op command failed\n"); return false; }
    kprintf("xHCI: running\n");

    xhciCount++;                                // from here on usbPoll() services this controller
    xhciEnumeratePorts();
    return true;
}
