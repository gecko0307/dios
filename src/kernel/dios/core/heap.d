module dios.core.heap;

import dios.core.cpu;
import dios.core.mem: memset;

// This first-stage allocator manages a caller-supplied, contiguous virtual
// memory region. Page acquisition and heap growth will be added separately.

enum size_t HEAP_ALIGNMENT = 16;
enum size_t HEAP_MIN_BLOCK_SIZE = 96;
enum ulong HEAP_BLOCK_MAGIC = 0x48454150424C4F43UL; // "HEAPBLOC"

enum ulong HEAP_FREE_BIT = 1;
enum ulong HEAP_SIZE_MASK = ~cast(ulong)(HEAP_ALIGNMENT - 1);

// The structure is exactly 64 bytes on x86_64. The extra eight bytes before
// the payload hold a back-pointer to this header, including for 16-byte
// aligned allocations.
align(16) struct HeapBlock
{
    ulong sizeFlags;       // total block size, including header; bit 0 = free
    ulong prevSize;        // size of the physically preceding block
    HeapBlock* freePrev;
    HeapBlock* freeNext;
    ulong requestedSize;
    ulong payloadOffset;
    ulong magic;
}

static assert(HeapBlock.sizeof == 64);

struct HeapStats
{
    size_t totalBytes;
    size_t freeBytes;
    size_t usedBytes;
    size_t freeBlocks;
    size_t usedBlocks;
}

private struct HeapState
{
    ulong start;
    ulong end;
    HeapBlock* freeHead;
    bool ready;
}

__gshared private HeapState heap;

private ulong blockSize(const(HeapBlock)* block) @nogc nothrow
{
    return block.sizeFlags & HEAP_SIZE_MASK;
}

private bool blockIsFree(const(HeapBlock)* block) @nogc nothrow
{
    return (block.sizeFlags & HEAP_FREE_BIT) != 0;
}

private void blockSetSize(HeapBlock* block, ulong size, bool isFree) @nogc nothrow
{
    block.sizeFlags = size | (isFree ? HEAP_FREE_BIT : 0);
}

private void freeListRemove(HeapBlock* block) @nogc nothrow
{
    if (block.freePrev !is null)
        block.freePrev.freeNext = block.freeNext;
    else
        heap.freeHead = block.freeNext;

    if (block.freeNext !is null)
        block.freeNext.freePrev = block.freePrev;

    block.freePrev = null;
    block.freeNext = null;
}

private void freeListInsert(HeapBlock* block) @nogc nothrow
{
    block.freePrev = null;
    block.freeNext = heap.freeHead;
    if (heap.freeHead !is null)
        heap.freeHead.freePrev = block;
    heap.freeHead = block;
}

private bool isPowerOfTwo(size_t value) @nogc nothrow
{
    return value != 0 && (value & (value - 1)) == 0;
}

private bool addOverflow(ulong a, ulong b, ulong* result) @nogc nothrow
{
    if (a > ulong.max - b)
        return true;
    *result = a + b;
    return false;
}

private ulong alignAddressUp(ulong value, ulong alignment) @nogc nothrow
{
    return (value + alignment - 1) & ~(alignment - 1);
}

/// Initialize the heap over an existing, writable virtual memory region.
/// `base` need not be aligned; the usable range is rounded inward to 16 bytes.
/// Returns false if the range is invalid or too small.
extern(C) bool heapInit(void* base, size_t size) @nogc nothrow
{
    if (heap.ready || base is null || size < HEAP_MIN_BLOCK_SIZE)
        return false;

    ulong rawStart = cast(ulong)base;
    ulong rawEnd;
    if (addOverflow(rawStart, size, &rawEnd))
        return false;

    ulong start = alignAddressUp(rawStart, HEAP_ALIGNMENT);
    ulong end = rawEnd & ~(cast(ulong)(HEAP_ALIGNMENT - 1));
    if (end <= start || end - start < HEAP_MIN_BLOCK_SIZE)
        return false;

    heap.start = start;
    heap.end = end;
    heap.freeHead = cast(HeapBlock*)start;

    HeapBlock* first = heap.freeHead;
    first.sizeFlags = (end - start) | HEAP_FREE_BIT;
    first.prevSize = 0;
    first.freePrev = null;
    first.freeNext = null;
    first.requestedSize = 0;
    first.payloadOffset = 0;
    first.magic = HEAP_BLOCK_MAGIC;

    heap.ready = true;
    return true;
}

/// Allocate `size` bytes with the allocator's default 16-byte alignment.
extern(C) void* kmalloc(size_t size) @nogc nothrow
{
    return kmallocAligned(size, HEAP_ALIGNMENT);
}

/// Allocate `size` bytes aligned to `alignment` (a power of two, >= 16).
/// Returns null on invalid arguments or when the current heap is exhausted.
extern(C) void* kmallocAligned(size_t size, size_t alignment) @nogc nothrow
{
    if (!heap.ready || size == 0)
        return null;

    if (alignment < HEAP_ALIGNMENT)
        alignment = HEAP_ALIGNMENT;
    if (!isPowerOfTwo(alignment))
        return null;

    ulong flags = cpuIrqSave();

    HeapBlock* block = heap.freeHead;
    while (block !is null)
    {
        ulong originalSize = blockSize(block);
        ulong blockAddress = cast(ulong)block;
        ulong payloadAddress;
        ulong minPayloadAddress;

        if (addOverflow(blockAddress, HeapBlock.sizeof + ulong.sizeof, &minPayloadAddress))
        {
            block = block.freeNext;
            continue;
        }

        if (minPayloadAddress > ulong.max - (alignment - 1))
        {
            block = block.freeNext;
            continue;
        }
        payloadAddress = alignAddressUp(minPayloadAddress, alignment);
        ulong payloadOffset = payloadAddress - blockAddress;
        ulong needed;
        if (addOverflow(payloadOffset, size, &needed) ||
            needed > ulong.max - (HEAP_ALIGNMENT - 1))
        {
            block = block.freeNext;
            continue;
        }
        needed = alignAddressUp(needed, HEAP_ALIGNMENT);

        if (needed > originalSize)
        {
            block = block.freeNext;
            continue;
        }

        freeListRemove(block);

        ulong remainder = originalSize - needed;
        if (remainder >= HEAP_MIN_BLOCK_SIZE)
        {
            blockSetSize(block, needed, false);

            HeapBlock* split = cast(HeapBlock*)(blockAddress + needed);
            split.sizeFlags = remainder | HEAP_FREE_BIT;
            split.prevSize = needed;
            split.freePrev = null;
            split.freeNext = null;
            split.requestedSize = 0;
            split.payloadOffset = 0;
            split.magic = HEAP_BLOCK_MAGIC;

            ulong afterAddress = blockAddress + originalSize;
            if (afterAddress < heap.end)
                (cast(HeapBlock*)afterAddress).prevSize = remainder;

            freeListInsert(split);
        }
        else
        {
            needed = originalSize;
            blockSetSize(block, originalSize, false);

            ulong afterAddress = blockAddress + originalSize;
            if (afterAddress < heap.end)
                (cast(HeapBlock*)afterAddress).prevSize = originalSize;
        }

        block.requestedSize = size;
        block.payloadOffset = payloadOffset;
        block.magic = HEAP_BLOCK_MAGIC;
        block.freePrev = null;
        block.freeNext = null;

        void* result = cast(void*)payloadAddress;
        *(cast(HeapBlock**)(payloadAddress - ulong.sizeof)) = block;
        cpuIrqRestore(flags);
        return result;
    }

    cpuIrqRestore(flags);
    return null;
}

/// Allocate and zero `size` bytes.
extern(C) void* kzalloc(size_t size) @nogc nothrow
{
    void* ptr = kmalloc(size);
    if (ptr !is null)
        memset(ptr, 0, size);
    return ptr;
}

/// Release a pointer returned by kmalloc/kmallocAligned/kzalloc.
/// Invalid pointers and double frees are ignored in this initial version.
extern(C) void kfree(void* ptr) @nogc nothrow
{
    if (!heap.ready || ptr is null)
        return;

    ulong flags = cpuIrqSave();
    ulong address = cast(ulong)ptr;

    if (address < heap.start + HeapBlock.sizeof + ulong.sizeof || address >= heap.end)
    {
        cpuIrqRestore(flags);
        return;
    }

    HeapBlock* block = *(cast(HeapBlock**)(address - ulong.sizeof));
    ulong blockAddress = cast(ulong)block;
    if (blockAddress < heap.start || blockAddress >= heap.end ||
        (blockAddress & (HEAP_ALIGNMENT - 1)) != 0 ||
        block.magic != HEAP_BLOCK_MAGIC || blockIsFree(block) ||
        block.payloadOffset != address - blockAddress ||
        blockSize(block) < block.payloadOffset ||
        block.requestedSize > blockSize(block) - block.payloadOffset ||
        blockSize(block) > heap.end - blockAddress)
    {
        cpuIrqRestore(flags);
        return;
    }

    ulong size = blockSize(block);
    blockSetSize(block, size, true);
    block.requestedSize = 0;
    block.payloadOffset = 0;
    block.freePrev = null;
    block.freeNext = null;

    // Merge with the physically following block.
    ulong nextAddress = blockAddress + size;
    if (nextAddress < heap.end)
    {
        HeapBlock* next = cast(HeapBlock*)nextAddress;
        if (next.magic == HEAP_BLOCK_MAGIC && blockIsFree(next) &&
            blockSize(next) >= HEAP_MIN_BLOCK_SIZE &&
            blockSize(next) <= heap.end - nextAddress)
        {
            ulong nextSize = blockSize(next);
            freeListRemove(next);
            size += nextSize;
            blockSetSize(block, size, true);
            next.magic = 0;
        }
    }

    // Merge with the physically preceding block using the boundary tag.
    if (block.prevSize != 0 && block.prevSize <= blockAddress - heap.start)
    {
        HeapBlock* previous = cast(HeapBlock*)(blockAddress - block.prevSize);
        if (previous.magic == HEAP_BLOCK_MAGIC && blockIsFree(previous) &&
            blockSize(previous) == block.prevSize)
        {
            freeListRemove(previous);
            ulong mergedSize = blockSize(previous) + size;
            blockSetSize(previous, mergedSize, true);
            block.magic = 0;
            block = previous;
            blockAddress = cast(ulong)block;
            size = mergedSize;
        }
    }

    ulong afterAddress = blockAddress + size;
    if (afterAddress < heap.end)
        (cast(HeapBlock*)afterAddress).prevSize = size;

    freeListInsert(block);
    cpuIrqRestore(flags);
}

/// Return a snapshot of heap usage. Byte counts include allocator metadata.
extern(C) bool heapGetStats(HeapStats* outStats) @nogc nothrow
{
    if (!heap.ready || outStats is null)
        return false;

    ulong flags = cpuIrqSave();
    HeapStats stats;
    stats.totalBytes = heap.end - heap.start;

    ulong address = heap.start;
    while (address < heap.end)
    {
        HeapBlock* block = cast(HeapBlock*)address;
        ulong size = blockSize(block);
        if (block.magic != HEAP_BLOCK_MAGIC || size < HEAP_MIN_BLOCK_SIZE ||
            (size & (HEAP_ALIGNMENT - 1)) != 0 || size > heap.end - address)
        {
            cpuIrqRestore(flags);
            return false;
        }

        if (blockIsFree(block))
        {
            stats.freeBytes += size;
            stats.freeBlocks++;
        }
        else
        {
            stats.usedBytes += size;
            stats.usedBlocks++;
        }
        address += size;
    }

    *outStats = stats;
    cpuIrqRestore(flags);
    return true;
}

extern(C) bool heapIsReady() @nogc nothrow
{
    return heap.ready;
}
