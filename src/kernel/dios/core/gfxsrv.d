module dios.core.gfxsrv;

/**
 * Kernel support for a user-space graphics server.
 *
 * The kernel does NOT draw windows. It provides the pieces a graphics server (a normal
 * program, "gfxd") and its clients (normal programs) need, and it guarantees that the
 * machine can always get back to the shell:
 *
 *   Screen ownership. The screen belongs either to the console (the kernel shell) or to
 *   the server. Ctrl+F1 shows the shell, Ctrl+F2 shows the server, Ctrl+F3 kills it; they
 *   are caught in keyPush(), so no program can swallow them, and the main loop (task 0) is
 *   never starved by a runaway server. Whatever the server does - crash, hang, exit - the
 *   console comes back. While the server is on screen the console keeps drawing into its
 *   scene buffer (gfx.d), so the shell is exactly as it was when you return.
 *
 *   Surfaces. A client asks for a drawable pixel buffer of W x H (XRGB, 4 bytes per pixel).
 *   The kernel allocates the pages and maps them into the client, and into the server when
 *   it asks. The client draws, then "commits" (damage rectangle); the server sees that and
 *   composes. Pages are freed only when nobody can touch them any more: a surface whose
 *   owner is gone stays alive until the server has unmapped it.
 *
 *   Events. One queue for the server (surface lifecycle, damage, keyboard, mouse) and one
 *   per client (whatever the server forwards to it, plus "server started/stopped").
 *   Mouse motion is merged when it arrives faster than it is read; damage is merged per
 *   surface, so neither can flood a queue.
 *
 *   Presenting. The server draws into its own back buffer and asks the kernel to copy it
 *   (or a rectangle of it) to video memory. The kernel only does that while the server is
 *   on screen, so a server that does not know it was switched away can do no harm.
 *
 * Input goes to the server only while it is on screen; the server decides which client
 * gets what (GFX_SEND) and also draws the mouse cursor. The kernel never routes input to
 * clients itself.
 *
 * System calls (all fail with -1 for task 0; layouts are shared with ulib/gfx/proto.d):
 *   0  gfx_info(UserGfxInfo*)                        anybody
 *   1  gfx_server_begin()                            become THE graphics server, take the screen
 *   2  gfx_server_end()                              give up the server role
 *   3  gfx_server_present(pixels, rect*|0, pitch|0)  server: copy back buffer to the screen
 *   4  gfx_server_map(UserGfxSurface*)               server: map surface `id` into this program
 *   5  gfx_server_unmap(id)                          server: let go of a surface
 *   6  gfx_surface_create(UserGfxSurface*)           client: new drawable area
 *   7  gfx_surface_commit(id, rect*|0)               client: "I changed this part"
 *   8  gfx_surface_destroy(id)                       client: done with it
 *   9  gfx_send(surface id, UserGfxEvent*)           server -> owner of the surface, or client -> server
 *   10 gfx_poll(UserGfxEvent*, timeoutMs)            next event for this program (0: none, 1: got one)
 *
 * Everything runs in the kernel's single-threaded, non-preemptive context (see proc.d), so
 * there are no locks. The only place a task can be switched out inside this file is the
 * sleep in sysGfxPoll(), and it re-checks all state afterwards.
 */
import dios.core.clock;
import dios.core.framebuffer;
import dios.core.gfx;
import dios.core.keyboard;
import dios.core.mem;
import dios.core.mouse;
import dios.core.paging;
import dios.core.proc;
import dios.core.stdio;

enum ulong SYS_GFX_INFO            = 0;
enum ulong SYS_GFX_SERVER_BEGIN    = 1;
enum ulong SYS_GFX_SERVER_END      = 2;
enum ulong SYS_GFX_SERVER_PRESENT  = 3;
enum ulong SYS_GFX_SERVER_MAP      = 4;
enum ulong SYS_GFX_SERVER_UNMAP    = 5;
enum ulong SYS_GFX_SURFACE_CREATE  = 6;
enum ulong SYS_GFX_SURFACE_COMMIT  = 7;
enum ulong SYS_GFX_SURFACE_DESTROY = 8;
enum ulong SYS_GFX_SEND            = 9;
enum ulong SYS_GFX_POLL            = 10;

// Event types (UserGfxEvent.type). Meaning of the fields a, b, c, d:
enum uint GFX_EV_NONE           = 0;
// kernel -> server
enum uint GFX_EV_SURFACE_NEW    = 1;    // surface; a = width, b = height, c = owner task id
enum uint GFX_EV_SURFACE_DAMAGE = 2;    // surface; a, b, c, d = x, y, w, h that changed (merged)
enum uint GFX_EV_SURFACE_GONE   = 3;    // surface; the owner is gone. Drop it, then gfx_server_unmap it
enum uint GFX_EV_VISIBLE        = 4;    // a = 1: you own the screen now (repaint ALL), 0: you lost it
enum uint GFX_EV_KEY            = 16;   // a = set-1 scancode, b = ASCII (0: none), c = GFX_MOD_* . Presses only
enum uint GFX_EV_MOUSE          = 17;   // a = x, b = y, c = buttons (1 left, 2 right, 4 middle), d = wheel delta
// kernel -> client
enum uint GFX_EV_SERVER         = 32;   // surface; a = 1: a server is running now, 0: it stopped
// server -> client: conventions only, the kernel passes them on untouched
enum uint GFX_EV_FOCUS          = 33;   // a = 1 gained, 0 lost keyboard focus
enum uint GFX_EV_CLOSE          = 34;   // the user asked to close the window
// From here on: free for you. Clients may only send these (to the server); the server may send anything.
enum uint GFX_EV_USER           = 0x1000;

enum uint GFX_MOD_SHIFT = 1;
enum uint GFX_MOD_CTRL  = 2;
enum uint GFX_MOD_CAPS  = 4;
enum uint GFX_MOD_EXT   = 8;            // arrow keys, Home, End, Delete...

enum uint GFX_INFO_SERVER  = 1;         // a server is running
enum uint GFX_INFO_VISIBLE = 2;         // ... and it has the screen

enum uint GFX_QUEUE_SIZE = 128;         // events per queue, power of two
enum uint GFX_MAX_SURFACES = 32;
enum uint GFX_MAX_SIDE = 4096;          // pixels
enum ulong GFX_MAX_SURFACE_BYTES = 32UL * 1024 * 1024;
enum ulong GFX_MAX_TOTAL_BYTES = 128UL * 1024 * 1024;

// Layouts shared with user programs (see ulib/gfx/proto.d)
struct UserGfxInfo
{
    uint width;
    uint height;
    uint flags;         // GFX_INFO_*
    uint serverTask;    // task id of the server, 0 if none
}
static assert(UserGfxInfo.sizeof == 16);

struct UserGfxRect
{
    int x, y, w, h;
}
static assert(UserGfxRect.sizeof == 16);

struct UserGfxSurface
{
    uint id;            // create: out. map: in
    uint width;         // create: in. map: out
    uint height;        // create: in. map: out
    uint stride;        // out: bytes per row
    ulong pixels;       // out: address of the first pixel in the calling program
    uint owner;         // map: out: task id of the owner
    uint reserved;
}
static assert(UserGfxSurface.sizeof == 32);

struct UserGfxEvent
{
    uint type;          // GFX_EV_*
    uint surface;       // the surface it is about, 0 if none
    int a, b, c, d;
    uint time;          // milliseconds since boot (wraps after 49 days)
    uint reserved;
}
static assert(UserGfxEvent.sizeof == 32);

struct GfxSurface
{
    bool used;
    bool ownerGone;     // owner exited or destroyed it; lives on until the server unmaps it
    uint id;            // never reused
    uint ownerSlot;     // index into tasks[]
    uint ownerId;
    uint width;
    uint height;
    ulong phys;         // physically contiguous
    ulong pages;
    ulong ownerVa;      // where the owner sees it (0: not mapped)
    ulong serverVa;     // where the server sees it (0: not mapped)
    bool damaged;       // pending damage box (not yet reported to the server)
    int dx0, dy0, dx1, dy1;
}

struct GfxServerState
{
    uint taskId;        // 0: no server
    uint slot;
    bool visible;       // the server owns the screen
}

struct GfxEventQueue
{
    UserGfxEvent[GFX_QUEUE_SIZE] ev;
    uint head;
    uint tail;
    uint dropped;
}

__gshared GfxServerState gsrv;
__gshared GfxSurface[GFX_MAX_SURFACES] gsurf;
__gshared uint gsurfNextId = 1;
__gshared uint gsurfDamageNext;                 // round robin over surfaces with damage
__gshared GfxEventQueue gsrvQueue;              // events for the server
__gshared GfxEventQueue[TASK_MAX] gclientQueue; // events for each task, by slot

// What the server was last told about the mouse
__gshared int gMouseX, gMouseY, gMouseWheel;
__gshared ubyte gMouseButtons;
__gshared bool gMouseResync;

extern(C):

// Event queues

bool evqPush(GfxEventQueue* q, const(UserGfxEvent)* e) @nogc nothrow
{
    // Pointer motion is the one event that can arrive faster than it is read: merge it
    // into the previous one (unless a button changed in between: clicks must survive).
    if (e.type == GFX_EV_MOUSE && q.head != q.tail)
    {
        UserGfxEvent* last = &q.ev[(q.head - 1) & (GFX_QUEUE_SIZE - 1)];
        if (last.type == GFX_EV_MOUSE && last.surface == e.surface && last.c == e.c)
        {
            int wheel = last.d + e.d;
            *last = *e;
            last.d = wheel;
            return true;
        }
    }
    if (q.head - q.tail >= GFX_QUEUE_SIZE)
    {
        q.dropped++;
        return false;
    }
    q.ev[q.head & (GFX_QUEUE_SIZE - 1)] = *e;
    q.head++;
    return true;
}

bool evqPop(GfxEventQueue* q, UserGfxEvent* e) @nogc nothrow
{
    if (q.head == q.tail)
        return false;
    *e = q.ev[q.tail & (GFX_QUEUE_SIZE - 1)];
    q.tail++;
    return true;
}

void evqClear(GfxEventQueue* q) @nogc nothrow
{
    q.tail = q.head;
}

UserGfxEvent evMake(uint type, uint surface, int a, int b, int c, int d) @nogc nothrow
{
    UserGfxEvent e;
    e.type = type;
    e.surface = surface;
    e.a = a;
    e.b = b;
    e.c = c;
    e.d = d;
    e.time = cast(uint)(clockNowNs() / 1_000_000UL);
    e.reserved = 0;
    return e;
}

void postToServer(uint type, uint surface, int a, int b, int c, int d) @nogc nothrow
{
    if (gsrv.taskId == 0)
        return;
    UserGfxEvent e = evMake(type, surface, a, b, c, d);
    evqPush(&gsrvQueue, &e);
}

void postToOwner(const(GfxSurface)* s, uint type, int a, int b, int c, int d) @nogc nothrow
{
    UserGfxEvent e = evMake(type, s.id, a, b, c, d);
    evqPush(&gclientQueue[s.ownerSlot], &e);
}

// Tell every program that owns a surface whether a server is running.
void notifyClients(int running) @nogc nothrow
{
    for (uint i = 0; i < GFX_MAX_SURFACES; i++)
        if (gsurf[i].used && !gsurf[i].ownerGone)
            postToOwner(&gsurf[i], GFX_EV_SERVER, running, 0, 0, 0);
}

// Surfaces

uint slotOf(const(Task)* t) @nogc nothrow
{
    return cast(uint)(t - tasks.ptr);
}

bool callerIsServer() @nogc nothrow
{
    return gsrv.taskId != 0 && cur.id == gsrv.taskId;
}

// Any surface with this id, even one whose owner is gone.
GfxSurface* surfaceFind(uint id) @nogc nothrow
{
    if (id == 0)
        return null;
    for (uint i = 0; i < GFX_MAX_SURFACES; i++)
        if (gsurf[i].used && gsurf[i].id == id)
            return &gsurf[i];
    return null;
}

// A live surface owned by the running task.
GfxSurface* surfaceOwned(uint id) @nogc nothrow
{
    GfxSurface* s = surfaceFind(id);
    if (s is null || s.ownerGone || s.ownerId != cur.id)
        return null;
    return s;
}

// The last reference is gone: give the pages back.
void surfaceFree(GfxSurface* s) @nogc nothrow
{
    pmmFreePages(s.phys, s.pages);
    s.phys = 0;
    s.pages = 0;
    s.used = false;
}

// Lowest free stretch of `bytes` in task `taskId`'s shared window. The mappings it has are
// recorded in the surfaces themselves (as owner and/or as server), so no extra table.
// 0 if there is no room.
ulong shmFindVa(uint taskId, ulong bytes) @nogc nothrow
{
    ulong va = USER_SHM_BASE;
    bool moved = true;
    while (moved)
    {
        moved = false;
        if (va + bytes > USER_SHM_LIMIT)
            return 0;
        for (uint i = 0; i < GFX_MAX_SURFACES; i++)
        {
            GfxSurface* s = &gsurf[i];
            if (!s.used)
                continue;
            for (uint k = 0; k < 2; k++)
            {
                ulong base = 0;
                if (k == 0 && s.ownerId == taskId)
                    base = s.ownerVa;
                else if (k == 1 && gsrv.taskId == taskId)
                    base = s.serverVa;
                if (base == 0)
                    continue;
                ulong end = base + s.pages * MEM_PAGE_SIZE;
                if (va < end && base < va + bytes)
                {
                    va = end;
                    moved = true;
                }
            }
        }
    }
    return va;
}

// Map the surface into task `t`. Returns the address, 0 on failure (nothing stays mapped).
ulong surfaceMapInto(Task* t, GfxSurface* s) @nogc nothrow
{
    ulong va = shmFindVa(t.id, s.pages * MEM_PAGE_SIZE);
    if (va == 0)
        return 0;
    for (ulong p = 0; p < s.pages; p++)
    {
        if (!procMapShared(t.pml4Phys, va + p * MEM_PAGE_SIZE, s.phys + p * MEM_PAGE_SIZE))
        {
            for (ulong q = 0; q < p; q++)
                procUnmapShared(t.pml4Phys, va + q * MEM_PAGE_SIZE);
            return 0;
        }
    }
    return va;
}

// The server lets go of the surface (its address space must still exist).
void surfaceServerUnmap(GfxSurface* s) @nogc nothrow
{
    if (s.serverVa != 0 && gsrv.taskId != 0)
    {
        ulong pml4 = tasks[gsrv.slot].pml4Phys;
        for (ulong p = 0; p < s.pages; p++)
            procUnmapShared(pml4, s.serverVa + p * MEM_PAGE_SIZE);
    }
    s.serverVa = 0;
    if (s.ownerGone)
        surfaceFree(s);
}

// The owner lets go: it destroyed the surface (ownerAlive), or the task is gone.
void surfaceOwnerRelease(GfxSurface* s, bool ownerAlive) @nogc nothrow
{
    if (ownerAlive && s.ownerVa != 0)
    {
        ulong pml4 = tasks[s.ownerSlot].pml4Phys;
        for (ulong p = 0; p < s.pages; p++)
            procUnmapShared(pml4, s.ownerVa + p * MEM_PAGE_SIZE);
    }
    s.ownerVa = 0;
    s.ownerGone = true;
    s.damaged = false;

    // The server may be drawing from its mapping right now (it is a separate program and can
    // be preempted at any time): the pages must outlive that. It is told, and the surface
    // is freed when it unmaps it. If it never mapped it there is nothing to wait for.
    if (gsrv.taskId != 0)
        postToServer(GFX_EV_SURFACE_GONE, s.id, 0, 0, 0, 0);
    if (s.serverVa == 0 || gsrv.taskId == 0)
        surfaceFree(s);
}

// Next pending damage box as an event (one surface per call, round robin).
bool damagePop(UserGfxEvent* e) @nogc nothrow
{
    for (uint k = 0; k < GFX_MAX_SURFACES; k++)
    {
        uint i = (gsurfDamageNext + k) % GFX_MAX_SURFACES;
        GfxSurface* s = &gsurf[i];
        if (!s.used || s.ownerGone || !s.damaged)
            continue;
        *e = evMake(GFX_EV_SURFACE_DAMAGE, s.id, s.dx0, s.dy0, s.dx1 - s.dx0, s.dy1 - s.dy0);
        s.damaged = false;
        gsurfDamageNext = (i + 1) % GFX_MAX_SURFACES;
        return true;
    }
    return false;
}

// Clip a user rectangle (or the whole area when `rectPtr` is 0) to [0, w) x [0, h).
// Returns false if the pointer is bad. An empty result has x0 >= x1.
bool userRect(ulong rectPtr, int w, int h, int* x0, int* y0, int* x1, int* y1) @nogc nothrow
{
    long ax = 0, ay = 0, bx = w, by = h;
    if (rectPtr != 0)
    {
        if (!procUserOk(rectPtr, UserGfxRect.sizeof, false))
            return false;
        const(UserGfxRect)* r = cast(const(UserGfxRect)*)rectPtr;
        ax = r.x;
        ay = r.y;
        bx = cast(long)r.x + r.w;
        by = cast(long)r.y + r.h;
    }
    if (ax < 0) ax = 0;
    if (ay < 0) ay = 0;
    if (bx > w) bx = w;
    if (by > h) by = h;
    *x0 = cast(int)ax;
    *y0 = cast(int)ay;
    *x1 = cast(int)bx;
    *y1 = cast(int)by;
    return true;
}

// Server life cycle and screen ownership

bool gfxsrvRunning() @nogc nothrow
{
    return gsrv.taskId != 0;
}

/// Does the server own the screen (and therefore the keyboard and mouse)?
bool gfxsrvVisible() @nogc nothrow
{
    return gsrv.taskId != 0 && gsrv.visible;
}

uint gfxsrvTaskId() @nogc nothrow
{
    return gsrv.taskId;
}

/// Switch the screen to the graphics server (Ctrl+F2). Does nothing without a server.
void gfxsrvShow() @nogc nothrow
{
    if (gsrv.taskId == 0 || gsrv.visible)
        return;
    gsrv.visible = true;
    gfxSuspend();
    keyQueueClear();                    // what was typed for the shell is not for the server
    gMouseResync = true;                // tell it where the pointer is
    postToServer(GFX_EV_VISIBLE, 0, 1, 0, 0, 0);
}

/// Switch the screen back to the console / shell (Ctrl+F1).
void gfxsrvHide() @nogc nothrow
{
    if (gsrv.taskId == 0 || !gsrv.visible)
        return;
    gsrv.visible = false;
    gfxResume();
    keyQueueClear();
    postToServer(GFX_EV_VISIBLE, 0, 0, 0, 0, 0);
}

// There is no server any more. `alive`: its address space still exists (it called
// gfx_server_end) as opposed to already torn down (it died).
void serverRelease(bool alive) @nogc nothrow
{
    bool wasVisible = gsrv.visible;

    for (uint i = 0; i < GFX_MAX_SURFACES; i++)
    {
        GfxSurface* s = &gsurf[i];
        if (!s.used || s.serverVa == 0)
            continue;
        if (alive)
        {
            ulong pml4 = tasks[gsrv.slot].pml4Phys;
            for (ulong p = 0; p < s.pages; p++)
                procUnmapShared(pml4, s.serverVa + p * MEM_PAGE_SIZE);
        }
        s.serverVa = 0;
        if (s.ownerGone)
            surfaceFree(s);
    }

    gsrv.taskId = 0;
    gsrv.slot = 0;
    gsrv.visible = false;
    evqClear(&gsrvQueue);

    if (wasVisible)
    {
        gfxResume();                    // the console is back, repainted from the scene buffer
        keyQueueClear();
    }
    notifyClients(0);
}

/// Kill the graphics server (Ctrl+F3, `gfx stop`). False if there is none.
bool gfxsrvStop() @nogc nothrow
{
    uint id = gsrv.taskId;
    if (id == 0)
        return false;
    if (!procKillId(id))
        taskReap();                     // it had already crashed: finish the cleanup
    if (gsrv.taskId == id)
        serverRelease(false);           // not reachable; makes sure the screen comes back anyway
    return true;
}

// Called from taskReap() for every task that ended, after its address space is gone.
extern(C) void gfxsrvTaskDied(uint slot, uint id) @nogc nothrow
{
    if (gsrv.taskId != 0 && gsrv.taskId == id)
        serverRelease(false);
    for (uint i = 0; i < GFX_MAX_SURFACES; i++)
        if (gsurf[i].used && !gsurf[i].ownerGone && gsurf[i].ownerId == id)
            surfaceOwnerRelease(&gsurf[i], false);
    evqClear(&gclientQueue[slot]);
}

// Main loop interface

/// Kernel hotkeys. Call once per main loop round, before any input is looked at.
void gfxsrvPoll() @nogc nothrow
{
    ubyte hk = keyTakeHotkey();
    if (hk == KEY_HOTKEY_F1)
        gfxsrvHide();
    else if (hk == KEY_HOTKEY_F2)
        gfxsrvShow();
    else if (hk == KEY_HOTKEY_F3)
        gfxsrvStop();
}

/// While the server is on screen: keys and mouse go to it. Call once per main loop round.
void gfxsrvPumpInput() @nogc nothrow
{
    if (!gfxsrvVisible())
        return;

    KeyEvent ke;
    while (keyPopEvent(&ke))
    {
        int mods = 0;
        if (ke.shift)    mods |= GFX_MOD_SHIFT;
        if (ke.ctrl)     mods |= GFX_MOD_CTRL;
        if (ke.caps)     mods |= GFX_MOD_CAPS;
        if (ke.extended) mods |= GFX_MOD_EXT;
        char ch = keyEventChar(&ke);
        postToServer(GFX_EV_KEY, 0, cast(int)ke.scancode, cast(int)cast(ubyte)ch, mods, 0);
    }

    int mx = mouse.x;
    int my = mouse.y;
    int wheel = mouse.wheel;
    ubyte buttons = mouse.buttons;
    if (gMouseResync)
        gMouseWheel = wheel;
    if (gMouseResync || mx != gMouseX || my != gMouseY || buttons != gMouseButtons || wheel != gMouseWheel)
    {
        postToServer(GFX_EV_MOUSE, 0, mx, my, cast(int)buttons, wheel - gMouseWheel);
        gMouseX = mx;
        gMouseY = my;
        gMouseButtons = buttons;
        gMouseWheel = wheel;
        gMouseResync = false;
    }
}

/// `gfx status`
void gfxsrvPrintStatus() @nogc nothrow
{
    Framebuffer* fb = gfxFrontBuffer();
    if (fb !is null)
        cprintf("Screen: %ux%u\n", fb.width, fb.height);
    if (gsrv.taskId == 0)
        cprintf("Graphics server: not running (gfx start)\n");
    else
        cprintf("Graphics server: task %u, %s\n", gsrv.taskId,
                gsrv.visible ? "on screen".ptr : "running, shell on screen".ptr);

    uint n = 0;
    for (uint i = 0; i < GFX_MAX_SURFACES; i++)
    {
        GfxSurface* s = &gsurf[i];
        if (!s.used)
            continue;
        if (n == 0)
            cprintf("  SURFACE  OWNER  SIZE         STATE\n");
        cprintf("  %u  task %u  %ux%u  %s\n", s.id, s.ownerId, s.width, s.height,
                s.ownerGone ? "owner gone, waiting for the server".ptr :
                (s.serverVa != 0 ? "mapped by the server".ptr : "not mapped by the server".ptr));
        n++;
    }
    if (n == 0)
        cprintf("No surfaces.\n");
    cprintf("Queues: %u events dropped for the server\n", gsrvQueue.dropped);
    cprintf("Keys: Ctrl+F1 shell, Ctrl+F2 graphics, Ctrl+F3 stop the server\n");
}

/// Register the system calls and the cleanup hook. Call after procInit().
void gfxsrvInit() @nogc nothrow
{
    gsrv.taskId = 0;
    gsrv.slot = 0;
    gsrv.visible = false;
    syscallExtHook1 = &gfxsrvSyscall;
    taskDeathHook = &gfxsrvTaskDied;
}

// System calls

long sysGfxInfo(ulong out_) @nogc nothrow
{
    Framebuffer* fb = gfxFrontBuffer();
    if (fb is null || !procUserOk(out_, UserGfxInfo.sizeof, true))
        return -1;
    UserGfxInfo* info = cast(UserGfxInfo*)out_;
    info.width = fb.width;
    info.height = fb.height;
    info.flags = 0;
    if (gsrv.taskId != 0)
        info.flags |= GFX_INFO_SERVER;
    if (gsrv.taskId != 0 && gsrv.visible)
        info.flags |= GFX_INFO_VISIBLE;
    info.serverTask = gsrv.taskId;
    return 0;
}

long sysGfxServerBegin() @nogc nothrow
{
    if (gsrv.taskId != 0)
        return -1;                      // one server at a time
    gsrv.taskId = cur.id;
    gsrv.slot = slotOf(cur);
    gsrv.visible = false;
    evqClear(&gsrvQueue);

    // Programs that were already running show up as if they had just connected
    for (uint i = 0; i < GFX_MAX_SURFACES; i++)
    {
        GfxSurface* s = &gsurf[i];
        if (!s.used || s.ownerGone)
            continue;
        s.serverVa = 0;
        postToServer(GFX_EV_SURFACE_NEW, s.id, cast(int)s.width, cast(int)s.height, cast(int)s.ownerId, 0);
        s.damaged = true;
        s.dx0 = 0;
        s.dy0 = 0;
        s.dx1 = cast(int)s.width;
        s.dy1 = cast(int)s.height;
    }
    notifyClients(1);
    gfxsrvShow();                       // and it gets the screen
    return 0;
}

long sysGfxServerEnd() @nogc nothrow
{
    if (!callerIsServer())
        return -1;
    serverRelease(true);
    return 0;
}

long sysGfxServerPresent(ulong pixels, ulong rectPtr, ulong pitch) @nogc nothrow
{
    if (!callerIsServer())
        return -1;
    if (!gsrv.visible)
        return 0;                       // the shell has the screen: nothing to draw on
    Framebuffer* fb = gfxFrontBuffer();
    if (fb is null)
        return -1;

    int sw = cast(int)fb.width;
    int sh = cast(int)fb.height;
    int x0, y0, x1, y1;
    if (!userRect(rectPtr, sw, sh, &x0, &y0, &x1, &y1))
        return -1;
    if (x0 >= x1 || y0 >= y1)
        return 1;

    ulong srcPitch = (pitch == 0) ? cast(ulong)sw * 4 : pitch;
    if (srcPitch < cast(ulong)sw * 4 || (srcPitch & 3) != 0 || srcPitch > (1UL << 20) || (pixels & 3) != 0)
        return -1;

    // Only the rows and columns that are copied have to be readable
    ulong first = cast(ulong)y0 * srcPitch + cast(ulong)x0 * 4;
    ulong last = cast(ulong)(y1 - 1) * srcPitch + cast(ulong)x1 * 4;
    if (!procUserOk(pixels + first, last - first, false))
        return -1;

    size_t fstride = fb.pitch / fb.bytesPerPixel;
    if (x0 == 0 && x1 == sw && srcPitch == cast(ulong)sw * 4 && fb.pitch == cast(uint)sw * 4)
    {
        // Whole rows, no padding anywhere: one move
        fastMemcpyNT(fb.ptr + cast(size_t)y0 * fstride,
                     cast(const(void)*)(pixels + cast(ulong)y0 * srcPitch),
                     cast(size_t)(y1 - y0) * cast(size_t)sw * 4);
        return 1;
    }
    size_t rowBytes = cast(size_t)(x1 - x0) * 4;
    for (int y = y0; y < y1; y++)
        memcpy(fb.ptr + cast(size_t)y * fstride + cast(size_t)x0,
               cast(const(void)*)(pixels + cast(ulong)y * srcPitch + cast(ulong)x0 * 4), rowBytes);
    return 1;
}

long sysGfxServerMap(ulong descPtr) @nogc nothrow
{
    if (!callerIsServer() || !procUserOk(descPtr, UserGfxSurface.sizeof, true))
        return -1;
    UserGfxSurface* d = cast(UserGfxSurface*)descPtr;
    GfxSurface* s = surfaceFind(d.id);
    if (s is null || s.ownerGone)
        return -1;
    if (s.serverVa == 0)
    {
        ulong va = surfaceMapInto(cur, s);
        if (va == 0)
            return -1;
        s.serverVa = va;
    }
    d.width = s.width;
    d.height = s.height;
    d.stride = s.width * 4;
    d.pixels = s.serverVa;
    d.owner = s.ownerId;
    return 0;
}

long sysGfxServerUnmap(ulong id) @nogc nothrow
{
    if (!callerIsServer())
        return -1;
    GfxSurface* s = surfaceFind(cast(uint)id);
    if (s is null || s.serverVa == 0)
        return -1;
    surfaceServerUnmap(s);
    return 0;
}

long sysGfxSurfaceCreate(ulong descPtr) @nogc nothrow
{
    if (!procUserOk(descPtr, UserGfxSurface.sizeof, true))
        return -1;
    UserGfxSurface* d = cast(UserGfxSurface*)descPtr;
    uint w = d.width;
    uint h = d.height;
    if (w == 0 || h == 0 || w > GFX_MAX_SIDE || h > GFX_MAX_SIDE)
        return -1;
    ulong bytes = cast(ulong)w * h * 4;
    if (bytes > GFX_MAX_SURFACE_BYTES)
        return -1;
    ulong pages = (bytes + MEM_PAGE_SIZE - 1) / MEM_PAGE_SIZE;

    GfxSurface* s = null;
    ulong total = bytes;
    for (uint i = 0; i < GFX_MAX_SURFACES; i++)
    {
        if (!gsurf[i].used)
        {
            if (s is null)
                s = &gsurf[i];
        }
        else
            total += gsurf[i].pages * MEM_PAGE_SIZE;
    }
    if (s is null || total > GFX_MAX_TOTAL_BYTES)
        return -1;

    ulong phys = pmmAllocContiguousZeroed(pages, 1, 0);
    if (phys == 0)
        return -1;

    s.used = true;                      // claimed first: shmFindVa and the mapping see it
    s.ownerGone = false;
    s.id = gsurfNextId++;
    s.ownerSlot = slotOf(cur);
    s.ownerId = cur.id;
    s.width = w;
    s.height = h;
    s.phys = phys;
    s.pages = pages;
    s.ownerVa = 0;
    s.serverVa = 0;
    s.damaged = false;

    ulong va = surfaceMapInto(cur, s);
    if (va == 0)
    {
        surfaceFree(s);
        return -1;
    }
    s.ownerVa = va;

    d.id = s.id;
    d.stride = w * 4;
    d.pixels = va;
    d.owner = cur.id;
    d.reserved = 0;

    postToServer(GFX_EV_SURFACE_NEW, s.id, cast(int)w, cast(int)h, cast(int)cur.id, 0);
    postToOwner(s, GFX_EV_SERVER, gsrv.taskId != 0 ? 1 : 0, 0, 0, 0);
    return 0;
}

long sysGfxSurfaceCommit(ulong id, ulong rectPtr) @nogc nothrow
{
    GfxSurface* s = surfaceOwned(cast(uint)id);
    if (s is null)
        return -1;
    int x0, y0, x1, y1;
    if (!userRect(rectPtr, cast(int)s.width, cast(int)s.height, &x0, &y0, &x1, &y1))
        return -1;
    if (x0 >= x1 || y0 >= y1)
        return 0;
    if (!s.damaged)
    {
        s.damaged = true;
        s.dx0 = x0;
        s.dy0 = y0;
        s.dx1 = x1;
        s.dy1 = y1;
    }
    else
    {
        if (x0 < s.dx0) s.dx0 = x0;
        if (y0 < s.dy0) s.dy0 = y0;
        if (x1 > s.dx1) s.dx1 = x1;
        if (y1 > s.dy1) s.dy1 = y1;
    }
    return 0;
}

long sysGfxSurfaceDestroy(ulong id) @nogc nothrow
{
    GfxSurface* s = surfaceOwned(cast(uint)id);
    if (s is null)
        return -1;
    surfaceOwnerRelease(s, true);
    return 0;
}

long sysGfxSend(ulong id, ulong evPtr) @nogc nothrow
{
    if (!procUserOk(evPtr, UserGfxEvent.sizeof, false))
        return -1;
    UserGfxEvent e = *cast(const(UserGfxEvent)*)evPtr;
    e.time = cast(uint)(clockNowNs() / 1_000_000UL);

    if (callerIsServer())
    {
        // Server -> the program that owns the surface. The server is trusted: any type.
        GfxSurface* s = surfaceFind(cast(uint)id);
        if (s is null || s.ownerGone)
            return -1;
        e.surface = s.id;
        return evqPush(&gclientQueue[s.ownerSlot], &e) ? 0 : -1;
    }

    // Client -> server. Only types of the free range, so a client cannot fake input.
    if (gsrv.taskId == 0 || e.type < GFX_EV_USER)
        return -1;
    if (id != 0 && surfaceOwned(cast(uint)id) is null)
        return -1;
    e.surface = cast(uint)id;
    return evqPush(&gsrvQueue, &e) ? 0 : -1;
}

long sysGfxPoll(ulong evPtr, long timeoutMs) @nogc nothrow
{
    if (!procUserOk(evPtr, UserGfxEvent.sizeof, true))
        return -1;
    ulong deadline = 0;
    if (timeoutMs > 0)
        deadline = clockNowNs() + cast(ulong)timeoutMs * 1_000_000UL;

    for (;;)
    {
        bool server = callerIsServer();
        GfxEventQueue* q = server ? &gsrvQueue : &gclientQueue[slotOf(cur)];
        UserGfxEvent e;
        if (evqPop(q, &e) || (server && damagePop(&e)))
        {
            *cast(UserGfxEvent*)evPtr = e;
            return 1;
        }
        if (timeoutMs == 0)
            return 0;
        if (timeoutMs > 0 && clockNowNs() >= deadline)
            return 0;
        sysSleep(1);                    // other tasks run; everything is re-checked afterwards
    }
}

// Called from syscallDispatch() (proc.d) for numbers 16..31 through syscallExtHook.
extern(C) long gfxsrvSyscall(ulong nr, ulong a0, ulong a1, ulong a2) @nogc nothrow
{
    if (cur.pml4Phys == 0)
        return -1;                      // the kernel shell has no use for these
    switch (nr)
    {
        case SYS_GFX_INFO:            return sysGfxInfo(a0);
        case SYS_GFX_SERVER_BEGIN:    return sysGfxServerBegin();
        case SYS_GFX_SERVER_END:      return sysGfxServerEnd();
        case SYS_GFX_SERVER_PRESENT:  return sysGfxServerPresent(a0, a1, a2);
        case SYS_GFX_SERVER_MAP:      return sysGfxServerMap(a0);
        case SYS_GFX_SERVER_UNMAP:    return sysGfxServerUnmap(a0);
        case SYS_GFX_SURFACE_CREATE:  return sysGfxSurfaceCreate(a0);
        case SYS_GFX_SURFACE_COMMIT:  return sysGfxSurfaceCommit(a0, a1);
        case SYS_GFX_SURFACE_DESTROY: return sysGfxSurfaceDestroy(a0);
        case SYS_GFX_SEND:            return sysGfxSend(a0, a1);
        case SYS_GFX_POLL:            return sysGfxPoll(a0, cast(long)a1);
        default:                      return -1;
    }
}
