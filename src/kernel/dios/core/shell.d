/// Fixed-size input and history storage: the kernel shell must not allocate.
enum size_t SHELL_LINE_CAPACITY = 128;
enum size_t SHELL_HISTORY_CAPACITY = 16;

immutable string[30] SHELL_COMMANDS = [
    "help", "about", "mem", "time", "uptime", "clock",
    "irq", "pci", "history", "echo", "poweroff",
    "reboot", "clear", "cpuinfo", "acpi", "irqstat",
    "sleep", "hexdump", "crash", "version", "ls", "run", "memmap",
    "programs", "disk", "mount", "cd", "pwd", "cat", "dmesg"
];

__gshared char[SHELL_LINE_CAPACITY] shellLine;
__gshared char[SHELL_LINE_CAPACITY][SHELL_HISTORY_CAPACITY] shellHistory;
__gshared size_t shellLineLength;
__gshared size_t shellCursor;                       // insertion point, 0..shellLineLength
__gshared int shellHistPos = -1;                    // -1: editing a fresh line, k: showing the k-th newest entry
__gshared char[SHELL_LINE_CAPACITY] shellDraft;     // the fresh line, parked while browsing history
__gshared size_t shellHistoryCount;
__gshared size_t shellHistoryNext;

extern(C):

bool shellEquals(const(char)* value, string expected) @nogc nothrow
{
    size_t i = 0;
    while (i < expected.length)
    {
        if (value[i] == 0 || value[i] != expected[i])
            return false;
        i++;
    }
    return value[i] == 0;
}

bool shellStartsWith(const(char)* value, const(char)[] prefix) @nogc nothrow
{
    for (size_t i = 0; i < prefix.length; i++)
        if (value[i] == 0 || value[i] != prefix[i])
            return false;
    return true;
}

void shellCopy(char* dst, const(char)* src) @nogc nothrow
{
    size_t i = 0;
    while (i + 1 < SHELL_LINE_CAPACITY && src[i] != 0)
    {
        dst[i] = src[i];
        i++;
    }
    dst[i] = 0;
}

void shellPrompt() @nogc nothrow
{
    cprintf("dios> ");
}

void shellRememberCommand() @nogc nothrow
{
    if (shellLineLength == 0)
        return;

    // Do not add an identical command twice in a row.
    if (shellHistoryCount != 0)
    {
        size_t last = (shellHistoryNext + SHELL_HISTORY_CAPACITY - 1) % SHELL_HISTORY_CAPACITY;
        bool same = true;
        for (size_t i = 0; i < SHELL_LINE_CAPACITY; i++)
        {
            if (shellHistory[last][i] != shellLine[i])
            {
                same = false;
                break;
            }
            if (shellLine[i] == 0)
                break;
        }
        if (same)
            return;
    }

    shellCopy(shellHistory[shellHistoryNext].ptr, shellLine.ptr);
    shellHistoryNext = (shellHistoryNext + 1) % SHELL_HISTORY_CAPACITY;
    if (shellHistoryCount < SHELL_HISTORY_CAPACITY)
        shellHistoryCount++;
}

void shellShowHistory() @nogc nothrow
{
    if (shellHistoryCount == 0)
    {
        cprintf("Command history is empty.\n");
        return;
    }

    size_t first = (shellHistoryNext + SHELL_HISTORY_CAPACITY - shellHistoryCount) % SHELL_HISTORY_CAPACITY;
    for (size_t i = 0; i < shellHistoryCount; i++)
    {
        size_t index = (first + i) % SHELL_HISTORY_CAPACITY;
        cprintf("%u  %s\n", cast(uint)(i + 1), shellHistory[index].ptr);
    }
}

void shellShowPci() @nogc nothrow
{
    uint found = 0;
    for (uint bus = 0; bus < 256; bus++)
    {
        for (uint device = 0; device < 32; device++)
        {
            if (pciReadVendorID(bus, device, 0) == 0xFFFF)
                continue;

            uint functions = (pciReadHeaderType(bus, device, 0) & 0x80) ? 8 : 1;
            for (uint func = 0; func < functions; func++)
            {
                ushort vendor = pciReadVendorID(bus, device, func);
                if (vendor == 0xFFFF)
                    continue;

                ushort dev = pciReadDeviceID(bus, device, func);
                ubyte cls = pciReadClass(bus, device, func);
                ubyte sub = pciReadSubclass(bus, device, func);
                cprintf("%u:%u.%u  %k:%k  class %X/%X\n",
                    bus, device, func, vendor, dev, cls, sub);
                found++;
            }
        }
    }
    cprintf("%u PCI function(s) found.\n", found);
}

// Start program `index` and report how it ended.
void shellRunProgram(uint index, const(char)* args) @nogc nothrow
{
    long code = 0;
    if (!procLaunch(index, args, &code))
    {
        cprintf("Could not start '%s'.\n", programs[index].name.ptr);
        return;
    }
    if (console.print_x != 0)
        consoleNewline(); // the program's last line had no newline
    if (code != 0)
        cprintf("[%s exited with code %llu]\n", programs[index].name.ptr, cast(ulong)code);
}

void shellListPrograms() @nogc nothrow
{
    if (programCount == 0)
    {
        cprintf("No programs found.\n");
        return;
    }
    for (uint i = 0; i < programCount; i++)
        cprintf("  %s  (%llu bytes)\n", programs[i].name.ptr, programs[i].size);
}

// disks and files

__gshared ubyte[4096] shellIo;
__gshared ExfatEntry shellProbe;

void shellPad(ulong v, uint width) @nogc nothrow
{
    char[20] d;
    uint n = 0;
    do
    {
        d[n++] = cast(char)('0' + v % 10);
        v /= 10;
    }
    while (v != 0);
    for (uint i = n; i < width; i++)
        consolePrintChar(' ');
    while (n > 0)
        consolePrintChar(d[--n]);
}

void shellPad2(uint v) @nogc nothrow
{
    consolePrintChar(cast(char)('0' + (v / 10) % 10));
    consolePrintChar(cast(char)('0' + v % 10));
}

struct ShellListCtx
{
    uint files, dirs;
    ulong bytes;
}

extern(C) bool shellListCb(const(ExfatEntry)* e, void* ctx) @nogc nothrow
{
    ShellListCtx* c = cast(ShellListCtx*)ctx;
    uint t = e.mtime;
    shellPad(1980 + (t >> 25), 4);
    consolePrintChar('-');
    shellPad2((t >> 21) & 0xF);
    consolePrintChar('-');
    shellPad2((t >> 16) & 0x1F);
    consolePrintChar(' ');
    shellPad2((t >> 11) & 0x1F);
    consolePrintChar(':');
    shellPad2((t >> 5) & 0x3F);
    consolePrintString("  ");
    if (e.isDir)
    {
        consolePrintString("     <DIR>  ");
        c.dirs++;
    }
    else
    {
        shellPad(e.size, 10);
        consolePrintString("  ");
        c.files++;
        c.bytes += e.size;
    }
    cprintf("%s\n", e.name.ptr);
    return true;
}

bool shellNeedVolume() @nogc nothrow
{
    if (!rootMount.mounted)
    {
        cprintf("No volume mounted. 'disk' shows what was found, 'mount N' mounts a partition.\n");
        return false;
    }
    return true;
}

void shellLs(const(char)* path) @nogc nothrow
{
    if (!shellNeedVolume())
        return;
    if (path[0] == 0)
        path = ".";

    ExfatEntry e;
    if (!fsStat(path, &e))
    {
        cprintf("Not found: %s\n", path);
        return;
    }

    ShellListCtx ctx;
    if (e.isDir)
    {
        if (!exfatIterate(&rootMount.vol, &e, &shellListCb, &ctx))
            cprintf("Read error while listing the directory.\n");
    }
    else
    {
        shellListCb(&e, &ctx);
    }
    cprintf("%u file(s), %llu bytes, %u director%s\n", ctx.files, ctx.bytes, ctx.dirs,
            ctx.dirs == 1 ? "y".ptr : "ies".ptr);
}

void shellCat(const(char)* path) @nogc nothrow
{
    if (!shellNeedVolume())
        return;
    ExfatEntry e;
    if (path[0] == 0)
    {
        cprintf("Usage: cat FILE\n");
        return;
    }
    if (!fsStat(path, &e) || e.isDir)
    {
        cprintf("Not a file: %s\n", path);
        return;
    }

    enum ulong LIMIT = 65536;
    ExfatFile f;
    exfatOpen(&f, &e);
    ulong off = 0;
    while (off < e.size && off < LIMIT)
    {
        ulong want = e.size - off;
        if (want > shellIo.length)
            want = shellIo.length;
        if (off + want > LIMIT)
            want = LIMIT - off;
        ulong got = exfatRead(&rootMount.vol, &f, off, shellIo.ptr, want);
        if (got == 0)
        {
            cprintf("\n[read error]\n");
            return;
        }
        for (ulong i = 0; i < got; i++)
        {
            ubyte c = shellIo[i];
            if (c == '\n' || (c >= 32 && c < 127))
                consolePrintChar(cast(char)c);
            else if (c == '\t')
                consolePrintString("    ");
            else if (c != '\r')
                consolePrintChar('.');
        }
        off += got;
    }
    if (console.print_x != 0)
        consoleNewline();
    if (off < e.size)
        cprintf("[output stopped after %llu of %llu bytes]\n", off, e.size);
}

void shellDisk() @nogc nothrow
{
    if (blockDevCount == 0)
    {
        cprintf("No disks. Only USB mass storage is supported, and the stick has to be plugged in at boot.\n");
        return;
    }
    for (uint d = 0; d < blockDevCount; d++)
    {
        BlockDev* b = &blockDevs[d];
        cprintf("%s: %s, %llu MiB, %u-byte sectors\n", b.name.ptr, b.model.ptr,
                (b.sectors * b.sectorSize) >> 20, b.sectorSize);
        uint shown = 0;
        for (uint i = 0; i < partitionCount; i++)
        {
            Partition* p = &partitions[i];
            if (p.dev != d)
                continue;
            cprintf("  [%u] partition %u: start %llu, %llu MiB, %s%s\n", i, cast(uint)p.number,
                    p.startLba, (p.sectors * b.sectorSize) >> 20, p.kind.ptr,
                    (rootMount.mounted && rootMount.partition == i) ? "   <- mounted as /".ptr : "".ptr);
            shown++;
        }
        if (shown == 0)
            cprintf("  no partitions found\n");
    }
}

void shellMount(const(char)* args) @nogc nothrow
{
    if (args[0] == 0)
    {
        if (!fsAutoMount())
            cprintf("No exFAT or FAT32 volume found ('disk' lists the partitions).\n");
        return;
    }
    ulong n;
    if (diagParseNumber(args, &n) is null || n >= partitionCount)
    {
        cprintf("Usage: mount [PARTITION-NUMBER]   (numbers in brackets in 'disk')\n");
        return;
    }
    if (!fsMountPartition(cast(uint)n))
        cprintf("Partition %llu is not a readable exFAT or FAT32 volume.\n", n);
    else
        cprintf("Mounted %s volume '%s' as /\n", rootMount.vol.fat32 ? "FAT32".ptr : "exFAT".ptr, rootMount.vol.label.ptr);
}

// Run an ELF file from the mounted volume. Tries `path`, then `path.elf`.
void shellRunFile(const(char)* path, const(char)* args) @nogc nothrow
{
    ExfatEntry e;
    char[FS_PATH_MAX + 8] withExt;

    bool found = fsStat(path, &e) && !e.isDir;
    if (!found)
    {
        uint n = 0;
        while (path[n] != 0 && n < FS_PATH_MAX)
        {
            withExt[n] = path[n];
            n++;
        }
        const(char)* ext = ".elf";
        for (uint i = 0; i < 5; i++)
            withExt[n + i] = ext[i];
        found = fsStat(withExt.ptr, &e) && !e.isDir;
        if (found)
            path = withExt.ptr;
    }
    if (!found)
    {
        cprintf("No such program: %s\n", path);
        return;
    }

    enum ulong MAX_IMAGE = 4UL * 1024 * 1024;
    if (e.size == 0 || e.size > MAX_IMAGE)
    {
        cprintf("%s: size %llu is not acceptable for a program (max 4 MiB)\n", path, e.size);
        return;
    }

    ulong pages = (e.size + 4095) / 4096;
    ulong phys = pmmAllocContiguousZeroed(pages, 1, 0);
    if (phys == 0)
    {
        cprintf("Out of memory.\n");
        return;
    }
    ubyte* image = cast(ubyte*)pmmPhysToVirt(phys);

    ExfatFile f;
    exfatOpen(&f, &e);
    ulong off = 0;
    while (off < e.size)
    {
        ulong want = e.size - off;
        if (want > 65536)
            want = 65536;
        ulong got = exfatRead(&rootMount.vol, &f, off, image + off, want);
        if (got == 0)
            break;
        off += got;
    }

    if (off != e.size)
    {
        cprintf("Read error while loading %s\n", path);
    }
    else
    {
        char[PROC_NAME_MAX] name;
        procMakeName(path, name.ptr);
        long code = 0;
        if (!procLaunchImage(name.ptr, image, e.size, args, &code))
        {
            cprintf("Could not start '%s'.\n", name.ptr);
        }
        else
        {
            if (console.print_x != 0)
                consoleNewline();
            if (code != 0)
                cprintf("[%s exited with code %llu]\n", name.ptr, cast(ulong)code);
        }
    }
    pmmFreePages(phys, pages);
}

// dmesg [LINES [SKIP]]: LINES lines of the kernel log (default: one screenful),
// ending SKIP lines before the newest one.
void shellDmesg(const(char)* args) @nogc nothrow
{
    ulong length = klogLength();
    ulong total = 0;
    for (ulong i = 0; i < length; i++)
        if (klogAt(i) == '\n')
            total++;
    if (length != 0 && klogAt(length - 1) != '\n')
        total++;

    ulong rows = console.v_stride != 0 ? console.height / console.v_stride : 25;
    ulong lines = rows > 3 ? rows - 3 : 1;
    ulong skip = 0;
    const(char)* p = args;
    if (*p != 0)
    {
        p = diagParseNumber(p, &lines);
        if (p is null || lines == 0)
        {
            cprintf("Usage: dmesg [LINES [SKIP]]\n");
            return;
        }
        while (*p == ' ' || *p == '\t')
            p++;
        if (*p != 0 && diagParseNumber(p, &skip) is null)
        {
            cprintf("Usage: dmesg [LINES [SKIP]]\n");
            return;
        }
    }
    if (skip > total)
        skip = total;
    ulong end = total - skip;
    ulong start = end > lines ? end - lines : 0;

    ulong line = 0;
    for (ulong i = 0; i < length && line < end; i++)
    {
        ubyte c = klogAt(i);
        if (line >= start)
        {
            if (c == '\n')
                consoleNewline();
            else if (c >= 32 && c < 127)
                consolePrintChar(cast(char)c);
            else if (c == '\t')
                consolePrintString("    ");
        }
        if (c == '\n')
            line++;
    }
    if (console.print_x != 0)
        consoleNewline();
    cprintf("[log lines %llu-%llu of %llu%s]\n", start + 1, end, total,
            klogWrapped() ? ", older text was overwritten".ptr : "".ptr);
}

void shellExecute() @nogc nothrow
{
    // Split command and arguments in-place. Quoting is intentionally not
    // supported yet; these first built-ins only need a simple argument tail.
    size_t commandLength = 0;
    while (commandLength < shellLineLength && shellLine[commandLength] != ' ' && shellLine[commandLength] != '\t')
        commandLength++;

    char separator = shellLine[commandLength];
    shellLine[commandLength] = 0;
    const(char)* args = shellLine.ptr + commandLength + (separator != 0 ? 1 : 0);
    while (*args == ' ' || *args == '\t')
        args++;

    if (shellEquals(shellLine.ptr, "help"))
    {
        cprintf("DIOS kernel shell\n");
        cprintf("  help             Show this command list\n");
        cprintf("  about            Kernel version information\n");
        cprintf("  mem              Physical memory statistics\n");
        cprintf("  memmap           Show the physical memory map\n");
        cprintf("  time             Print current date and time\n");
        cprintf("  uptime           Time since boot\n");
        cprintf("  clock            Clock source and timer status\n");
        cprintf("  irq              Interrupt controller status\n");
        cprintf("  irqstat          Interrupt counts per vector\n");
        cprintf("  pci              Enumerate PCI functions\n");
        cprintf("  cpuinfo          CPU identification and features\n");
        cprintf("  acpi             ACPI tables, MADT, FADT summary\n");
        cprintf("  hexdump [-p] ADDR [LEN]  Dump memory (-p: physical address)\n");
        cprintf("  history          Show recent commands\n");
        cprintf("  echo TEXT        Print TEXT\n");
        cprintf("  sleep SECONDS    Wait (Ctrl+C aborts)\n");
        cprintf("  programs         List programs on the boot media\n");
        cprintf("  dmesg [N [SKIP]] Kernel log (last N lines, SKIP lines before the end)\n");
        cprintf("  disk             Show USB disks and partitions\n");
        cprintf("  mount [N]        Mount an exFAT or FAT32 partition as /\n");
        cprintf("  ls [PATH]        List a directory on the mounted volume\n");
        cprintf("  cat FILE         Print a text file\n");
        cprintf("  cd [DIR], pwd    Change the current directory\n");
        cprintf("  pwd              Show the current directory\n");
        cprintf("  run NAME [ARGS]  Run a boot program or an ELF from the disk\n");
        cprintf("  clear            Clear the screen\n");
        cprintf("  crash pf|ud|div|gp  Trigger a CPU exception (kernel halts)\n");
        cprintf("  reboot           Restart the computer\n");
        cprintf("  poweroff         Shut down the computer\n");
        cprintf("Keys: arrows/Home/End/Del edit, Up/Down history, Tab completes,\n");
        cprintf("      Ctrl+A/E start/end, Ctrl+U clear line, Ctrl+L redraw, Ctrl+C cancel\n");
    }
    else if (shellEquals(shellLine.ptr, "about"))
    {
        cprintf(diosVersionInfo);
    }
    else if (shellEquals(shellLine.ptr, "mem"))
    {
        ulong freePages = pmmFreeCount();
        ulong totalPages = pmmTotalCount();
        ulong usedPages = totalPages - freePages;
        cprintf("Physical memory (4 KiB pages):\n");
        cprintf("  Total: %llu MiB (%llu pages)\n",
            totalPages * MEM_PAGE_SIZE / (1024 * 1024), totalPages);
        cprintf("  Used:  %llu MiB (%llu pages)\n",
            usedPages * MEM_PAGE_SIZE / (1024 * 1024), usedPages);
        cprintf("  Free:  %llu MiB (%llu pages)\n",
            freePages * MEM_PAGE_SIZE / (1024 * 1024), freePages);
    }
    else if (shellEquals(shellLine.ptr, "memmap"))
    {
        immutable string[8] types = [
            "usable", "reserved", "ACPI reclaimable", "ACPI NVS",
            "bad memory", "bootloader reclaimable", "kernel/modules", "framebuffer"
        ];
        cprintf("Physical memory map (%u entr%s):\n",
            cast(uint)memMapCount, memMapCount == 1 ? "y".ptr : "ies".ptr);
        cprintf("  Base                Length              Type\n");
        for (size_t i = 0; i < memMapCount; i++)
        {
            auto entry = memMapEntries[i];
            const(char)* typeName = "unknown".ptr;
            if (entry.type < types.length)
                typeName = types[entry.type].ptr;
            cprintf("  %llx  %llx  %s\n",
                entry.base, entry.length, typeName);
        }
        if (memMapTruncated)
            cprintf("  (map truncated at %u entries)\n", cast(uint)MEMMAP_MAX_ENTRIES);
    }
    else if (shellEquals(shellLine.ptr, "time"))
    {
        DateTime t;
        datetimeNow(&t);
        cprintf("UTC %02d.%02d.%d %02d:%02d:%02d\n",
            t.day, t.month, t.year,
            t.hour, t.minute, t.second);
    }
    else if (shellEquals(shellLine.ptr, "uptime"))
    {
        ulong ms = clockNowNs() / 1_000_000;
        ulong seconds = ms / 1000;
        ulong days = seconds / 86400;
        ulong hours = (seconds / 3600) % 24;
        ulong minutes = (seconds / 60) % 60;
        ulong secs = seconds % 60;
        cprintf("Uptime: %llu day(s), %llu hour(s), %llu minute(s), %llu second(s)\n",
            days, hours, minutes, secs);
    }
    else if (shellEquals(shellLine.ptr, "clock"))
    {
        cprintf("Clock source: %s\n", clockHasHpet() ? "HPET".ptr : "PIT".ptr);
        if (clockHasHpet())
            cprintf("  HPET frequency: %llu Hz\n", hpetFreq);
        cprintf("  LAPIC tick: %s\n", clockTickActive() ? "active".ptr : "inactive".ptr);
        if (clockTickActive())
            cprintf("  Tick count: %llu\n", clockTickMs());
    }
    else if (shellEquals(shellLine.ptr, "irq"))
    {
        interruptsPrintStatus();
    }
    else if (shellEquals(shellLine.ptr, "pci"))
    {
        shellShowPci();
    }
    else if (shellEquals(shellLine.ptr, "history"))
    {
        shellShowHistory();
    }
    else if (shellEquals(shellLine.ptr, "echo"))
    {
        cprintf("%s\n", cast(char*)args);
    }
    else if (shellEquals(shellLine.ptr, "version"))
    {
        cprintf(diosVersion);
    }
    else if (shellEquals(shellLine.ptr, "clear"))
    {
        consoleClear();
    }
    else if (shellEquals(shellLine.ptr, "cpuinfo"))
    {
        diagCpuInfo();
    }
    else if (shellEquals(shellLine.ptr, "acpi"))
    {
        diagAcpi();
    }
    else if (shellEquals(shellLine.ptr, "irqstat"))
    {
        diagIrqStat();
    }
    else if (shellEquals(shellLine.ptr, "reboot"))
    {
        systemReboot();
    }
    else if (shellEquals(shellLine.ptr, "sleep"))
    {
        ulong secs;
        if (diagParseNumber(args, &secs) is null || secs > 3600)
        {
            cprintf("Usage: sleep SECONDS (0-3600)\n");
        }
        else if (!diagSleep(secs * 1000))
        {
            cprintf("^C\n");
        }
    }
    else if (shellEquals(shellLine.ptr, "hexdump"))
    {
        const(char)* p = args;
        bool physical = false;
        if (p[0] == '-' && p[1] == 'p' && (p[2] == ' ' || p[2] == 0))
        {
            physical = true;
            p += 2;
        }
        ulong addr, len = 64;
        p = diagParseNumber(p, &addr);
        if (p is null)
        {
            cprintf("Usage: hexdump [-p] ADDR [LEN]   (numbers: 0x1F or decimal, LEN max 1024)\n");
        }
        else
        {
            const(char)* q = diagParseNumber(p, &len);
            if (q is null)
                len = 64;
            diagHexdump(addr, len, physical);
        }
    }
    else if (shellEquals(shellLine.ptr, "crash"))
    {
        if (shellEquals(args, "pf"))
            diagCrash(0);
        else if (shellEquals(args, "ud"))
            diagCrash(1);
        else if (shellEquals(args, "div"))
            diagCrash(2);
        else if (shellEquals(args, "gp"))
            diagCrash(3);
        else
            cprintf("Usage: crash pf|ud|div|gp\n");
    }
    else if (shellEquals(shellLine.ptr, "ls"))
    {
        shellLs(args);
    }
    else if (shellEquals(shellLine.ptr, "dmesg"))
    {
        shellDmesg(args);
    }
    else if (shellEquals(shellLine.ptr, "programs"))
    {
        shellListPrograms();
    }
    else if (shellEquals(shellLine.ptr, "disk"))
    {
        shellDisk();
    }
    else if (shellEquals(shellLine.ptr, "mount"))
    {
        shellMount(args);
    }
    else if (shellEquals(shellLine.ptr, "cat"))
    {
        shellCat(args);
    }
    else if (shellEquals(shellLine.ptr, "pwd"))
    {
        if (shellNeedVolume())
            cprintf("%s\n", fsCwd.ptr);
    }
    else if (shellEquals(shellLine.ptr, "cd"))
    {
        if (shellNeedVolume() && !fsChdir(args[0] == 0 ? "/".ptr : args))
            cprintf("Not a directory: %s\n", args);
    }
    else if (shellEquals(shellLine.ptr, "run"))
    {
        // First word of the arguments is the program name, the rest is passed on.
        char[FS_PATH_MAX] name;
        uint n = 0;
        const(char)* p = args;
        while (*p != 0 && *p != ' ' && *p != '\t' && n + 1 < FS_PATH_MAX)
            name[n++] = *p++;
        name[n] = 0;
        while (*p == ' ' || *p == '\t')
            p++;

        if (n == 0)
            cprintf("Usage: run NAME [ARGS]  (see 'programs')\n");
        else
        {
            int index = procFind(name.ptr);
            if (index >= 0)
                shellRunProgram(cast(uint)index, p);
            else if (rootMount.mounted)
                shellRunFile(name.ptr, p);          // a path on the mounted volume
            else
                cprintf("No such program: %s\n", name.ptr);
        }
    }
    else if (shellEquals(shellLine.ptr, "poweroff"))
    {
        cprintf("Powering off...\n");
        if (!acpiPoweroff())
            cprintf("ACPI shutdown is unavailable (missing FADT/DSDT _S5_ or PM1a control block).\n");
    }
    else if (shellLine[0] != 0)
    {
        int index = procFind(shellLine.ptr);
        if (index >= 0)
        {
            shellRunProgram(cast(uint)index, args);
        }
        else if (rootMount.mounted && (fsStat(shellLine.ptr, &shellProbe) && !shellProbe.isDir))
        {
            shellRunFile(shellLine.ptr, args);          // "./hello" or "/bin/hello" on the disk
        }
        else
        {
            cprintf("Unknown command: %s\n", shellLine.ptr);
            cprintf("Type 'help' for available commands.\n");
        }
    }

    shellClearLine();
    shellPrompt();
}

void shellComplete() @nogc nothrow
{
    string match;
    uint matches = 0;
    size_t commonLength = 0;

    for (size_t i = 0; i < SHELL_COMMANDS.length; i++)
    {
        if (!shellStartsWith(SHELL_COMMANDS[i].ptr, shellLine[0 .. shellLineLength]))
            continue;

        if (matches == 0)
        {
            match = SHELL_COMMANDS[i];
            commonLength = match.length;
        }
        else
        {
            size_t j = shellLineLength;
            while (j < commonLength && j < SHELL_COMMANDS[i].length && match[j] == SHELL_COMMANDS[i][j])
                j++;
            commonLength = j;
        }
        matches++;
    }

    if (matches == 0)
        return;

    if (commonLength > shellLineLength)
    {
        for (size_t i = shellLineLength; i < commonLength && i + 1 < SHELL_LINE_CAPACITY; i++)
        {
            shellLine[i] = match[i];
            consolePrintChar(match[i]);
        }
        shellLineLength = commonLength;
        shellLine[shellLineLength] = 0;
        shellCursor = shellLineLength;
    }

    if (matches > 1 && commonLength == shellLineLength)
    {
        consoleNewline();
        for (size_t i = 0; i < SHELL_COMMANDS.length; i++)
            if (shellStartsWith(SHELL_COMMANDS[i].ptr, shellLine[0 .. shellLineLength]))
                cprintf("%s  ", SHELL_COMMANDS[i].ptr);
        consoleNewline();
        shellPrompt();
        for (size_t j = 0; j < shellLineLength; j++)
            consolePrintChar(shellLine[j]);
    }
}

void shellInit() @nogc nothrow
{
    shellClearLine();
    shellHistoryCount = 0;
    shellHistoryNext = 0;
    cprintf("\nWelcome to the kernel shell! Type 'help' for available commands.\n");
    shellPrompt();
}

// Line editing. The console cursor and shellCursor always move together; the
// helpers below keep them in step (the console follows soft-wrapped rows).

void shellClearLine() @nogc nothrow
{
    for (size_t i = 0; i < SHELL_LINE_CAPACITY; i++)
        shellLine[i] = 0;
    shellLineLength = 0;
    shellCursor = 0;
    shellHistPos = -1;
}

void shellMoveLeftN(size_t n) @nogc nothrow
{
    while (n-- != 0)
        consoleMoveLeft();
}

void shellMoveRightN(size_t n) @nogc nothrow
{
    while (n-- != 0)
        consoleMoveRight();
}

void shellCursorLeft() @nogc nothrow
{
    if (shellCursor == 0)
        return;
    consoleMoveLeft();
    shellCursor--;
}

void shellCursorRight() @nogc nothrow
{
    if (shellCursor >= shellLineLength)
        return;
    consoleMoveRight();
    shellCursor++;
}

void shellCursorHome() @nogc nothrow
{
    shellMoveLeftN(shellCursor);
    shellCursor = 0;
}

void shellCursorEnd() @nogc nothrow
{
    shellMoveRightN(shellLineLength - shellCursor);
    shellCursor = shellLineLength;
}

void shellPrintTail(size_t from) @nogc nothrow
{
    for (size_t i = from; i < shellLineLength; i++)
        consolePrintChar(shellLine[i]);
}

void shellInsertChar(char c) @nogc nothrow
{
    if (shellLineLength + 1 >= SHELL_LINE_CAPACITY)
        return;

    if (shellCursor == shellLineLength)
    {
        shellLine[shellLineLength++] = c;
        shellLine[shellLineLength] = 0;
        shellCursor = shellLineLength;
        consolePrintChar(c);
        return;
    }

    for (size_t i = shellLineLength; i > shellCursor; i--)
        shellLine[i] = shellLine[i - 1];
    shellLine[shellCursor] = c;
    shellLineLength++;
    shellLine[shellLineLength] = 0;

    shellPrintTail(shellCursor);            // console cursor ends up at the line end
    shellCursor++;
    shellMoveLeftN(shellLineLength - shellCursor);
}

// Delete the character under the cursor.
void shellDeleteAtCursor() @nogc nothrow
{
    if (shellCursor >= shellLineLength)
        return;

    for (size_t i = shellCursor; i + 1 < shellLineLength; i++)
        shellLine[i] = shellLine[i + 1];
    shellLineLength--;
    shellLine[shellLineLength] = 0;

    shellPrintTail(shellCursor);            // console cursor ends up at the new line end
    consoleEraseHere();                     // the old last cell
    shellMoveLeftN(shellLineLength - shellCursor);
}

void shellBackspace() @nogc nothrow
{
    if (shellCursor == 0)
        return;

    if (shellCursor == shellLineLength)
    {
        shellLineLength--;
        shellCursor--;
        shellLine[shellLineLength] = 0;
        consoleBack();
        return;
    }

    shellCursorLeft();
    shellDeleteAtCursor();
}

// Replace the whole input line (history recall, Esc, Ctrl+U).
void shellReplaceLine(const(char)* text) @nogc nothrow
{
    shellCursorEnd();
    while (shellLineLength != 0)
    {
        shellLineLength--;
        shellLine[shellLineLength] = 0;
        consoleBack();
    }
    shellCursor = 0;

    size_t i = 0;
    while (text[i] != 0 && i + 1 < SHELL_LINE_CAPACITY)
    {
        shellLine[i] = text[i];
        consolePrintChar(text[i]);
        i++;
    }
    shellLine[i] = 0;
    shellLineLength = i;
    shellCursor = i;
}

// k-th newest history entry (0 = newest).
const(char)* shellHistoryEntry(size_t k) @nogc nothrow
{
    size_t index = (shellHistoryNext + SHELL_HISTORY_CAPACITY * 2 - 1 - k) % SHELL_HISTORY_CAPACITY;
    return shellHistory[index].ptr;
}

void shellHistoryUp() @nogc nothrow
{
    if (cast(size_t)(shellHistPos + 1) >= shellHistoryCount)
        return;
    if (shellHistPos < 0)
        shellCopy(shellDraft.ptr, shellLine.ptr);       // park what was being typed
    shellHistPos++;
    shellReplaceLine(shellHistoryEntry(cast(size_t)shellHistPos));
}

void shellHistoryDown() @nogc nothrow
{
    if (shellHistPos < 0)
        return;
    shellHistPos--;
    if (shellHistPos < 0)
        shellReplaceLine(shellDraft.ptr);
    else
        shellReplaceLine(shellHistoryEntry(cast(size_t)shellHistPos));
}

// Ctrl+L: wipe the screen, redraw prompt and the current input.
void shellRedraw() @nogc nothrow
{
    size_t cursor = shellCursor;
    consoleClear();
    shellPrompt();
    shellPrintTail(0);
    shellMoveLeftN(shellLineLength - cursor);
    shellCursor = cursor;
}

void shellAbortLine() @nogc nothrow
{
    shellCursorEnd();
    consolePrintString("^C");
    consoleNewline();
    shellClearLine();
    shellPrompt();
}

/// Feed one key press (from the shared key queue) to the shell.
void shellHandleKey(const(KeyEvent)* ev) @nogc nothrow
{
    if (ev.extended)
    {
        switch (ev.scancode)
        {
            case 0x4B: shellCursorLeft(); break;        // Left
            case 0x4D: shellCursorRight(); break;       // Right
            case 0x48: shellHistoryUp(); break;         // Up
            case 0x50: shellHistoryDown(); break;       // Down
            case 0x47: shellCursorHome(); break;        // Home
            case 0x4F: shellCursorEnd(); break;         // End
            case 0x53: shellDeleteAtCursor(); break;    // Delete
            default: break;
        }
        return;
    }

    if (ev.ctrl)
    {
        switch (keyEventChar(ev))
        {
            case 1:  shellCursorHome(); break;          // Ctrl+A
            case 5:  shellCursorEnd(); break;           // Ctrl+E
            case 3:  shellAbortLine(); break;           // Ctrl+C
            case 12: shellRedraw(); break;              // Ctrl+L
            case 21: shellReplaceLine(""); break;       // Ctrl+U
            default: break;
        }
        return;
    }

    switch (ev.scancode)
    {
        case 0x0E:                                      // Backspace
            shellBackspace();
            return;
        case 0x1C:                                      // Enter
            shellCursorEnd();
            consoleNewline();
            shellLine[shellLineLength] = 0;
            shellRememberCommand();
            shellHistPos = -1;
            shellExecute();
            return;
        case 0x0F:                                      // Tab
            shellCursorEnd();
            shellComplete();
            return;
        case 0x01:                                      // Escape: clear current input
            shellReplaceLine("");
            return;
        default:
            break;
    }

    char c = keyEventChar(ev);
    if (c >= 32 && c < 127)
        shellInsertChar(c);
}
