module dios.core.sysfile;

/**
 * File system calls for user programs (read-only): a small table of open files
 * and directories on the mounted volume.
 *
 * Everything here works on kernel pointers; proc.d validates the user pointers
 * and copies the path strings before calling in.
 */
import dios.core.exfat;
import dios.core.fs;

enum uint SYSFILE_MAX_OPEN = 8;
enum long SYSFILE_EOF_ERR = -1;

// Layouts shared with user programs (see ulib.d)
struct UserStat
{
    ulong size;
    uint mtime; // DOS timestamp
    uint isDir;
}

struct UserDirent
{
    ulong size;
    uint mtime;
    uint isDir;
    char[EXFAT_NAME_MAX] name;
}

struct OpenFile
{
    bool used;
    bool isDir;
    int mount; // mount slot the file lives on, or FS_ROOT for the virtual root directory
    uint generation; // mounts[mount].generation when opened; stale after that volume went away
    ExfatEntry entry;
    ExfatFile file;
    ulong pos; // file offset, or the next directory index
}

/// Every task owns an OpenFile[SYSFILE_MAX_OPEN] table; the scheduler points this at the
/// running task's table (sysfileBind). Task 0 (the shell) has one too, but never uses it.
__gshared OpenFile* openFiles;

struct DirPick
{
    ulong want;
    ulong seen;
    bool found;
    ExfatEntry entry;
}

extern(C):

/// Close everything in a fresh task's table.
void sysfileClear(OpenFile* table) @nogc nothrow
{
    for (uint i = 0; i < SYSFILE_MAX_OPEN; i++)
        table[i].used = false;
}

/// Make `table` the one the file syscalls work on (called on every task switch).
void sysfileBind(OpenFile* table) @nogc nothrow
{
    openFiles = table;
}

/// A descriptor is live while its volume is still mounted and was not remounted since.
/// Descriptors on other volumes are not affected when one volume goes away.
bool sysfileLive(const(OpenFile)* f) @nogc nothrow
{
    if (!f.used)
        return false;
    if (f.mount == FS_ROOT)
        return true;
    if (f.mount < 0 || f.mount >= cast(int)FS_MAX_MOUNTS)
        return false;
    return mounts[f.mount].mounted && mounts[f.mount].generation == f.generation;
}

OpenFile* sysfileGet(ulong fd) @nogc nothrow
{
    if (openFiles is null || fd >= SYSFILE_MAX_OPEN || !sysfileLive(&openFiles[fd]))
        return null;
    return &openFiles[fd];
}

/// Open a file or directory. Returns the descriptor, or -1.
long sysfileOpen(const(char)* path) @nogc nothrow
{
    if (openFiles is null)
        return -1;
    uint fd = 0;
    while (fd < SYSFILE_MAX_OPEN && sysfileLive(&openFiles[fd]))
        fd++;
    if (fd == SYSFILE_MAX_OPEN)
        return -1;

    OpenFile* f = &openFiles[fd];
    int slot;
    if (!fsStat(path, &f.entry, &slot))
        return -1;
    f.isDir = f.entry.isDir;
    f.pos = 0;
    if (!f.isDir && !exfatOpen(&f.file, &f.entry))
        return -1;
    f.mount = slot;
    f.generation = (slot == FS_ROOT) ? 0 : mounts[slot].generation;
    f.used = true;
    return fd;
}

long sysfileClose(ulong fd) @nogc nothrow
{
    OpenFile* f = sysfileGet(fd);
    if (f is null)
        return -1;
    f.used = false;
    return 0;
}

/// Read up to `len` bytes into `dst` (kernel or already validated user memory).
/// Returns the byte count, 0 at the end of the file, -1 on error.
long sysfileRead(ulong fd, void* dst, ulong len) @nogc nothrow
{
    OpenFile* f = sysfileGet(fd);
    if (f is null || f.isDir)
        return -1;
    if (f.pos >= f.entry.size || len == 0)
        return 0;
    if (len > f.entry.size - f.pos)
        len = f.entry.size - f.pos;
    if (len > 1024 * 1024)
        len = 1024 * 1024;

    ulong got = fsRead(f.mount, &f.file, f.pos, dst, len);
    if (got == 0)
        return -1;
    f.pos += got;
    return cast(long)got;
}

/// whence: 0 = from the start, 1 = from the current position, 2 = from the end.
/// Returns the new position or -1. Seeking past the end is allowed (reads return 0).
long sysfileSeek(ulong fd, long offset, ulong whence) @nogc nothrow
{
    OpenFile* f = sysfileGet(fd);
    if (f is null || f.isDir)
        return -1;
    long base;
    if (whence == 0)
        base = 0;
    else if (whence == 1)
        base = cast(long)f.pos;
    else if (whence == 2)
        base = cast(long)f.entry.size;
    else
        return -1;
    long target = base + offset;
    if (target < 0)
        return -1;
    f.pos = cast(ulong)target;
    return target;
}

bool sysfileStat(const(char)* path, UserStat* st) @nogc nothrow
{
    ExfatEntry e;
    if (!fsStat(path, &e))
        return false;
    st.size = e.size;
    st.mtime = e.mtime;
    st.isDir = e.isDir ? 1 : 0;
    return true;
}

extern(C) bool sysfilePickCb(const(ExfatEntry)* e, void* ctx) @nogc nothrow
{
    DirPick* p = cast(DirPick*)ctx;
    if (p.seen == p.want)
    {
        p.entry = *e;
        p.found = true;
        return false;
    }
    p.seen++;
    return true;
}

/// Next entry of an open directory. 1 = filled in, 0 = no more, -1 = error.
long sysfileReaddir(ulong fd, UserDirent* out_) @nogc nothrow
{
    OpenFile* f = sysfileGet(fd);
    if (f is null || !f.isDir)
        return -1;

    DirPick pick;
    pick.want = f.pos;
    if (!fsIterate(f.mount, &f.entry, &sysfilePickCb, &pick))
        return -1;
    if (!pick.found)
        return 0;

    f.pos++;
    out_.size = pick.entry.size;
    out_.mtime = pick.entry.mtime;
    out_.isDir = pick.entry.isDir ? 1 : 0;
    for (uint i = 0; i < EXFAT_NAME_MAX; i++)
        out_.name[i] = pick.entry.name[i];
    return 1;
}
