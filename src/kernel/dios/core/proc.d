enum ulong USER_IMAGE_MIN = 0x400000;
enum ulong USER_IMAGE_MAX = 0x40000000;
enum ulong USER_STACK_TOP = 0x80000000;
enum uint  USER_STACK_PAGES = 16;
enum ulong USER_ARGS_MAX = 256;

enum uint PROC_MAX_PROGRAMS = 16;
enum uint PROC_NAME_MAX = 32;

enum ulong USER_HEAP_BASE  = USER_IMAGE_MAX;
enum ulong USER_SHM_BASE   = 0x70000000;                                    // shared memory window
enum ulong USER_SHM_LIMIT  = USER_STACK_TOP - USER_STACK_PAGES * 4096;
enum ulong USER_HEAP_LIMIT = USER_SHM_BASE;                                 // the heap stops where it starts

enum ulong SYS_EXIT = 0;
enum ulong SYS_WRITE = 1;
enum ulong SYS_GETKEY = 2;
enum ulong SYS_SLEEP = 3;
enum ulong SYS_TICKS = 4;
enum ulong SYS_CLEAR = 5;
enum ulong SYS_OPEN = 6;
enum ulong SYS_READ = 7;
enum ulong SYS_CLOSE = 8;
enum ulong SYS_SEEK = 9;
enum ulong SYS_STAT = 10;
enum ulong SYS_READDIR = 11;
enum ulong SYS_GETCWD = 12;
enum ulong SYS_BRK = 13;
enum ulong SYS_YIELD = 14;
enum ulong SYS_GETPID = 15;
enum ulong SYS_DATETIME = 16;
enum ulong SYS_RANDOM = 17;

// Extended syscall functions, handled by corresponding syscallExtHook*
enum ulong SYS_EXT1 = 1000; // [1000..1999 - SYS_EXT1]
enum ulong SYS_EXT2 = 2000; // [2000..2999 - SYS_EXT2]
enum ulong SYS_EXT3 = 3000; // [3000..3999 - SYS_EXT3]
enum ulong SYS_EXT4 = 4000; // [4000..4999 - SYS_EXT4]

enum uint MSR_EFER = 0xC0000080;
enum uint MSR_STAR = 0xC0000081;
enum uint MSR_LSTAR = 0xC0000082;
enum uint MSR_SFMASK = 0xC0000084;

struct Elf64Ehdr
{
    ubyte[16] ident;
    ushort type;
    ushort machine;
    uint version_;
    ulong entry;
    ulong phoff;
    ulong shoff;
    uint flags;
    ushort ehsize;
    ushort phentsize;
    ushort phnum;
    ushort shentsize;
    ushort shnum;
    ushort shstrndx;
}
static assert(Elf64Ehdr.sizeof == 64);

struct Elf64Phdr
{
    uint type;
    uint flags;
    ulong offset;
    ulong vaddr;
    ulong paddr;
    ulong filesz;
    ulong memsz;
    ulong align_;
}
static assert(Elf64Phdr.sizeof == 56);

struct Program
{
    char[PROC_NAME_MAX] name;
    const(ubyte)* image;
    ulong size;
}

enum uint TASK_MAX = 8;                 // slot 0 is the kernel, so 7 programs at a time
enum ulong TASK_STACK_SIZE = 32768;     // kernel stack per task
enum uint TASK_SLICE_TICKS = 5;         // ms (1 kHz tick)

enum TaskState : ubyte
{
    Free,
    Ready,          // running or waiting for its turn
    Sleep,          // until wakeNs
    WaitKey,        // for a key; only woken while it is the foreground task
    Zombie          // finished, waiting for task 0 to clean up
}

struct Task
{
    TaskState state;
    uint id;                    // shown by ps, used by kill/fg; 0 is the kernel
    ulong pml4Phys;             // 0 for task 0 (kernel page tables)
    ulong entry;
    ulong stackPointer;         // initial user stack pointer
    ulong argsAddr;
    ulong heapBreak;
    ulong savedSp;              // kernel stack pointer while switched out
    ulong wakeNs;
    ulong startMs;
    long exitCode;
    char[PROC_NAME_MAX] name;
    OpenFile[SYSFILE_MAX_OPEN] files;
}

/// Reports a reaped task: id, name, exit code, was it the foreground task. Set by the shell.
alias TaskExitHook = extern(C) void function(uint id, const(char)* name, long code, bool wasForeground) @nogc nothrow;
/// Bracket the output of a background task when the shell is sitting at its prompt.
alias TaskOutHook = extern(C) void function() @nogc nothrow;
/// Extended system calls. Runs on the calling task's kernel stack.
alias SyscallExtHook = extern(C) long function(ulong nr, ulong a0, ulong a1, ulong a2) @nogc nothrow;
/// A task has been reaped: its slot, its id. Its address space is already gone.
alias TaskDeathHook = extern(C) void function(uint slot, uint id) @nogc nothrow;

__gshared Program[PROC_MAX_PROGRAMS] programs;
__gshared uint programCount;
__gshared Task[TASK_MAX] tasks;
__gshared Task* cur;                    // the running task
__gshared Task* fgTask;                 // owns the keyboard (null: the shell does)
__gshared uint nextTaskId = 1;
__gshared uint sliceTicks;
__gshared TaskExitHook taskExitHook;
__gshared TaskOutHook taskOutBegin;
__gshared TaskOutHook taskOutEnd;
__gshared SyscallExtHook syscallExtHook1;
__gshared SyscallExtHook syscallExtHook2;
__gshared SyscallExtHook syscallExtHook3;
__gshared SyscallExtHook syscallExtHook4;
__gshared TaskDeathHook taskDeathHook;
align(16) __gshared ubyte[TASK_STACK_SIZE][TASK_MAX] taskStacks;

