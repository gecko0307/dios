// Program table

// "boot():/dir/hello.elf" -> "hello"
void procMakeName(const(char)* path, char* dst) @nogc nothrow
{
    const(char)* base = path;
    for (const(char)* p = path; *p != 0; p++)
        if (*p == '/' || *p == ':')
            base = p + 1;

    uint n = 0;
    while (base[n] != 0 && base[n] != '.' && n + 1 < PROC_NAME_MAX)
    {
        dst[n] = base[n];
        n++;
    }
    dst[n] = 0;
}

void procCopyName(char* dst, const(char)* src) @nogc nothrow
{
    uint i = 0;
    while (src[i] != 0 && i + 1 < PROC_NAME_MAX)
    {
        dst[i] = src[i];
        i++;
    }
    dst[i] = 0;
}

bool procNameEq(const(char)* a, const(char)* b) @nogc nothrow
{
    uint i = 0;
    while (a[i] != 0 && a[i] == b[i])
        i++;
    return a[i] == b[i];
}

/// Set up SYSCALL/SYSRET and collect the programs the bootloader loaded.
void procInit() @nogc nothrow
{
    // SYSRET64: CS = STAR[63:48] + 16, SS = STAR[63:48] + 8  -> 0x20 / 0x18 (our user selectors)
    // SYSCALL:  CS = STAR[47:32],      SS = STAR[47:32] + 8  -> 0x08 / 0x10
    cpuWriteMsr(MSR_EFER, cpuReadMsr(MSR_EFER) | 1);                 // SCE
    cpuWriteMsr(MSR_STAR, (0x10UL << 48) | (0x08UL << 32));
    cpuWriteMsr(MSR_LSTAR, cast(ulong)syscallEntryAddress());
    cpuWriteMsr(MSR_SFMASK, 0x40700);                                // clear IF, TF, DF, AC on entry
    syscallSetStack(cast(ulong)ring0Stack.ptr + IST_STACK_SIZE);

    userFaultHook = &procUserFault;
    userTickHook = &procUserTick;

    // The code running right now becomes task 0.
    tasks[0].state = TaskState.Ready;
    tasks[0].id = 0;
    procCopyName(tasks[0].name.ptr, "shell");
    cur = &tasks[0];
    sysfileClear(tasks[0].files.ptr);
    sysfileBind(tasks[0].files.ptr);

    programCount = 0;
    if (moduleRequest.response is null)
        return;

    ulong n = moduleRequest.response.module_count;
    for (ulong i = 0; i < n && programCount < PROC_MAX_PROGRAMS; i++)
    {
        LimineFile* f = moduleRequest.response.modules[i];
        if (f is null || f.address is null || f.path is null)
            continue;
        Program* p = &programs[programCount++];
        procMakeName(f.path, p.name.ptr);
        p.image = cast(const(ubyte)*)f.address;
        p.size = f.size;
    }
}

int procFind(const(char)* name) @nogc nothrow
{
    for (uint i = 0; i < programCount; i++)
        if (procNameEq(programs[i].name.ptr, name))
            return cast(int)i;
    return -1;
}

// Address space

// Find (and with `create`, build the path to) the 4 KiB page-table entry for a
// user address. Intermediate tables get the USER bit; only slot 0 of the PML4 is
// ever touched, so the kernel's shared tables are never modified.
ulong* procPte(ulong pml4Phys, ulong vaddr, bool create) @nogc nothrow
{
    ulong* table = cast(ulong*)vmemPhysToVirt(pml4Phys);
    for (uint lvl = 0; lvl < 3; lvl++)
    {
        size_t ix = cast(size_t)((vaddr >> (39 - 9 * lvl)) & 0x1FF);
        ulong e = table[ix];
        if (!(e & PTE_PRESENT))
        {
            if (!create)
                return null;
            ulong phys;
            if (vmemAllocTable(&phys) is null)
                return null;
            e = phys | PTE_PRESENT | PTE_RW | PTE_USER;
            table[ix] = e;
        }
        table = cast(ulong*)vmemPhysToVirt(e & PTE_ADDR_MASK);
    }
    return &table[idx_pt(vaddr)];
}

// Give back every page of a program: data pages, tables, and the PML4 itself.
void procFreeSpace(ulong pml4Phys) @nogc nothrow
{
    if (pml4Phys == 0)
        return;

    ulong* pml4 = cast(ulong*)vmemPhysToVirt(pml4Phys);
    ulong e0 = pml4[0];
    if (e0 & PTE_PRESENT)
    {
        ulong* pdpt = cast(ulong*)vmemPhysToVirt(e0 & PTE_ADDR_MASK);
        for (uint i = 0; i < 512; i++)
        {
            ulong e1 = pdpt[i];
            if (!(e1 & PTE_PRESENT))
                continue;
            ulong* pd = cast(ulong*)vmemPhysToVirt(e1 & PTE_ADDR_MASK);
            for (uint j = 0; j < 512; j++)
            {
                ulong e2 = pd[j];
                if (!(e2 & PTE_PRESENT))
                    continue;
                ulong* pt = cast(ulong*)vmemPhysToVirt(e2 & PTE_ADDR_MASK);
                for (uint k = 0; k < 512; k++)
                    if ((pt[k] & PTE_PRESENT) && !(pt[k] & PTE_SHARED))     // shared pages have an owner
                        pmmFreePage(pt[k] & PTE_ADDR_MASK);
                pmmFreePage(e2 & PTE_ADDR_MASK);
            }
            pmmFreePage(e1 & PTE_ADDR_MASK);
        }
        pmmFreePage(e0 & PTE_ADDR_MASK);
    }
    pmmFreePage(pml4Phys);
}

// Map one fresh zeroed page at `vaddr` (or reuse the page already there, which
// happens when two segments share a page). Returns its kernel-visible address.
ubyte* procMapPage(ulong pml4Phys, ulong vaddr, bool writable) @nogc nothrow
{
    ulong* pte = procPte(pml4Phys, vaddr, true);
    if (pte is null)
        return null;

    if (*pte & PTE_PRESENT)
    {
        if (writable)
            *pte |= PTE_RW;
        return cast(ubyte*)vmemPhysToVirt(*pte & PTE_ADDR_MASK);
    }

    ulong phys = pmmAllocPage();
    if (phys == 0)
        return null;
    ubyte* page = cast(ubyte*)vmemPhysToVirt(phys);
    memset(page, 0, 4096);
    *pte = phys | PTE_PRESENT | PTE_USER | (writable ? PTE_RW : 0);
    return page;
}

// Unmap one user page and return its physical page to PMM.
bool procUnmapUserPage(ulong vaddr) @nogc nothrow
{
    ulong* pte = procPte(cur.pml4Phys, vaddr, false);
    if (pte is null || !(*pte & PTE_PRESENT))
        return false;

    ulong phys = *pte & PTE_ADDR_MASK;

    *pte = 0;
    vmemInvalidatePage(vaddr);

    return pmmFreePage(phys);
}

// Map a physical page that somebody else owns (a graphics surface) at `vaddr` of ANY
// address space (not just the running one). The page is marked PTE_SHARED, so tearing the
// address space down leaves it alone. False if `vaddr` is taken or there is no memory
// for a page table.
bool procMapShared(ulong pml4Phys, ulong vaddr, ulong phys) @nogc nothrow
{
    ulong* pte = procPte(pml4Phys, vaddr, true);
    if (pte is null || (*pte & PTE_PRESENT))
        return false;
    *pte = phys | PTE_PRESENT | PTE_USER | PTE_RW | PTE_SHARED;
    return true;
}

// Undo procMapShared for one page. Only touches pages marked PTE_SHARED. (The TLB of another
// address space is flushed when that task is switched to: every switch reloads CR3.)
void procUnmapShared(ulong pml4Phys, ulong vaddr) @nogc nothrow
{
    ulong* pte = procPte(pml4Phys, vaddr, false);
    if (pte is null || !(*pte & PTE_PRESENT) || !(*pte & PTE_SHARED))
        return;
    *pte = 0;
    vmemInvalidatePage(vaddr);
}

// Change the current process' heap break.
// requested == 0: query current break.
// Returns the new/current break, or -1 on failure.
long procSetBreak(ulong requested) @nogc nothrow
{
    if (cur.pml4Phys == 0)
        return -1;

    if (requested == 0)
        return cast(long)cur.heapBreak;

    if (requested < USER_HEAP_BASE || requested > USER_HEAP_LIMIT)
        return -1;

    ulong oldBreak = cur.heapBreak;
    ulong oldEnd = (oldBreak + 4095) & ~4095UL;
    ulong newEnd = (requested + 4095) & ~4095UL;

    // Expand heap.
    if (newEnd > oldEnd)
    {
        ulong va = oldEnd;

        while (va < newEnd)
        {
            // Do not overwrite an existing mapping.
            ulong* pte = procPte(cur.pml4Phys, va, false);
            if (pte !is null && (*pte & PTE_PRESENT))
                goto rollback;

            if (procMapPage(cur.pml4Phys, va, true) is null)
                goto rollback;

            va += 4096;
        }

        cur.heapBreak = requested;
        return cast(long)requested;

    rollback:
        // Roll back every page mapped during this expansion.
        for (ulong undo = oldEnd; undo < va; undo += 4096)
            procUnmapUserPage(undo);

        return -1;
    }

    // Shrink heap. First validate all pages that are about to be released.
    if (newEnd < oldEnd)
    {
        for (ulong va = newEnd; va < oldEnd; va += 4096)
        {
            ulong* pte = procPte(cur.pml4Phys, va, false);
            if (pte is null || !(*pte & PTE_PRESENT) || !(*pte & PTE_USER))
                return -1;
        }

        for (ulong va = newEnd; va < oldEnd; va += 4096)
        {
            if (!procUnmapUserPage(va))
                return -1;
        }
    }

    cur.heapBreak = requested;
    return cast(long)requested;
}

bool procLoadElf(Program* prog, ulong pml4Phys, ulong* entry) @nogc nothrow
{
    if (prog.size < Elf64Ehdr.sizeof)
    {
        kprintf("run: '%s' is too small to be an ELF file\n", prog.name.ptr);
        return false;
    }

    const(Elf64Ehdr)* eh = cast(const(Elf64Ehdr)*)prog.image;
    if (eh.ident[0] != 0x7F || eh.ident[1] != 'E' || eh.ident[2] != 'L' || eh.ident[3] != 'F' ||
        eh.ident[4] != 2 || eh.ident[5] != 1 || eh.type != 2 || eh.machine != 0x3E)
    {
        kprintf("run: '%s' is not an x86_64 ELF executable\n", prog.name.ptr);
        return false;
    }
    if (eh.phentsize != Elf64Phdr.sizeof || eh.phnum == 0 || eh.phnum > 16 ||
        eh.phoff > prog.size || prog.size - eh.phoff < cast(ulong)eh.phnum * Elf64Phdr.sizeof)
    {
        kprintf("run: '%s' has a bad program header table\n", prog.name.ptr);
        return false;
    }
    if (eh.entry < USER_IMAGE_MIN || eh.entry >= USER_IMAGE_MAX)
    {
        kprintf("run: '%s' entry point %llx is outside the user range\n", prog.name.ptr, eh.entry);
        return false;
    }

    uint loaded = 0;
    for (uint i = 0; i < eh.phnum; i++)
    {
        const(Elf64Phdr)* ph = cast(const(Elf64Phdr)*)(prog.image + eh.phoff + i * Elf64Phdr.sizeof);
        if (ph.type != 1 || ph.memsz == 0) // PT_LOAD only
            continue;

        bool ok = ph.filesz <= ph.memsz &&
                  ph.vaddr >= USER_IMAGE_MIN && ph.memsz <= USER_IMAGE_MAX &&
                  ph.vaddr <= USER_IMAGE_MAX - ph.memsz &&
                  ph.offset <= prog.size && ph.filesz <= prog.size - ph.offset;
        if (!ok)
        {
            kprintf("run: '%s' has a segment outside the allowed range\n", prog.name.ptr);
            return false;
        }

        bool writable = (ph.flags & 2) != 0;
        ulong first = ph.vaddr & ~0xFFFUL;
        ulong last = (ph.vaddr + ph.memsz - 1) & ~0xFFFUL;
        for (ulong page = first; page <= last; page += 4096)
        {
            ubyte* dst = procMapPage(pml4Phys, page, writable);
            if (dst is null)
            {
                kprintf("run: out of memory while loading '%s'\n", prog.name.ptr);
                return false;
            }

            // File bytes that land in this page: [vaddr, vaddr + filesz) intersected with it.
            ulong lo = (ph.vaddr > page) ? ph.vaddr : page;
            ulong fileEnd = ph.vaddr + ph.filesz;
            ulong hi = (fileEnd < page + 4096) ? fileEnd : page + 4096;
            if (hi > lo)
                memcpy(dst + (lo - page), prog.image + ph.offset + (lo - ph.vaddr), cast(size_t)(hi - lo));
        }
        loaded++;
    }

    if (loaded == 0)
    {
        kprintf("run: '%s' has nothing to load\n", prog.name.ptr);
        return false;
    }
    *entry = eh.entry;
    return true;
}

bool procBuildSpace(Task* t, Program* prog, const(char)* args) @nogc nothrow
{
    ulong pml4Phys;
    void* pml4 = vmemAllocTable(&pml4Phys);
    if (pml4 is null)
    {
        kprintf("run: out of memory\n");
        return false;
    }

    // Share the kernel half; slot 0 (low half) is the program's own.
    memcpy(pml4, cast(void*)vmemPhysToVirt(PML4_PHYS), 4096);
    (cast(ulong*)pml4)[0] = 0;
    t.pml4Phys = pml4Phys;
    t.heapBreak = USER_HEAP_BASE;

    if (!procLoadElf(prog, pml4Phys, &t.entry))
        return false;

    for (uint i = 0; i < USER_STACK_PAGES; i++)
    {
        ulong va = USER_STACK_TOP - cast(ulong)(i + 1) * 4096;
        if (procMapPage(pml4Phys, va, true) is null)
        {
            kprintf("run: out of memory for the stack\n");
            return false;
        }
    }

    // Arguments: a NUL-terminated copy at the very top of the stack.
    ulong n = 0;
    while (args[n] != 0 && n + 1 < USER_ARGS_MAX)
        n++;
    ulong argsVa = USER_STACK_TOP - USER_ARGS_MAX;
    ubyte* top = cast(ubyte*)vmemPhysToVirt((*procPte(pml4Phys, USER_STACK_TOP - 4096, false)) & PTE_ADDR_MASK);
    ubyte* dst = top + (4096 - USER_ARGS_MAX);
    for (ulong i = 0; i < n; i++)
        dst[i] = cast(ubyte)args[i];
    dst[n] = 0;

    t.argsAddr = argsVa;
    t.stackPointer = argsVa - 64;        // some headroom below the arguments
    return true;
}

// Tasks

ulong taskStackTop(const(Task)* t) @nogc nothrow
{
    size_t i = cast(size_t)(t - tasks.ptr);
    return cast(ulong)taskStacks[i].ptr + TASK_STACK_SIZE;
}

// Could this task run right now?
bool taskRunnable(const(Task)* t, ulong nowNs) @nogc nothrow
{
    switch (t.state)
    {
        case TaskState.Ready:
            return true;
        case TaskState.Sleep:
            return nowNs >= t.wakeNs;
        case TaskState.WaitKey:
            return t is fgTask && keyQueueHasKey();
        default:
            return false;
    }
}

// Round robin, starting after the current task; the current task comes last. Task 0 is
// always Ready, so something is always found.
Task* taskPick() @nogc nothrow
{
    ulong now = clockNowNs();
    size_t start = cast(size_t)(cur - tasks.ptr);
    for (size_t k = 1; k <= TASK_MAX; k++)
    {
        Task* t = &tasks[(start + k) % TASK_MAX];
        if (taskRunnable(t, now))
        {
            t.state = TaskState.Ready;
            return t;
        }
    }
    return &tasks[0];
}

/// Is any task besides task 0 ready to run? (The main loop only sleeps when none is.)
bool procOthersReady() @nogc nothrow
{
    ulong now = clockNowNs();
    for (uint i = 1; i < TASK_MAX; i++)
        if (taskRunnable(&tasks[i], now))
            return true;
    return false;
}

/// Give the CPU to the next runnable task; returns when this task is picked again. The
/// caller sets its own state first (Ready to just yield, Sleep/WaitKey to block). Interrupts
/// are off during the switch and restored to this task's own setting afterwards.
void taskSchedule() @nogc nothrow
{
    ulong flags = cpuIrqSave();
    Task* prev = cur;
    Task* next = taskPick();
    if (next !is prev)
    {
        cur = next;
        ulong want = (next.pml4Phys != 0) ? next.pml4Phys : PML4_PHYS;
        if ((getCR3() & PTE_ADDR_MASK) != want)
            setCR3(want);
        if (next.pml4Phys != 0)
        {
            // The next ring 3 -> ring 0 transition (interrupt or syscall) lands on its stack.
            ulong top = taskStackTop(next);
            tss.rsp0 = top;
            syscallSetStack(top);
        }
        sysfileBind(next.files.ptr);
        sliceTicks = 0;
        taskSwitch(&prev.savedSp, next.savedSp);
        // ... and we are back: somebody switched to this task again.
    }
    cpuIrqRestore(flags);
}

/// Task 0: let the others run for a while.
void procYield() @nogc nothrow
{
    taskSchedule();
}

// First code a new task runs, on its own kernel stack (reached through taskTrampoline).
extern(C) void taskFirstRun() @nogc nothrow
{
    Task* t = cur;
    userJump(t.entry, t.stackPointer, t.argsAddr);
    for (;;)
        cpuHlt();
}

/// End the running task. Never returns.
void taskExit(long code) @nogc nothrow
{
    if (cur is &tasks[0])
        hcf();
    cur.exitCode = code;
    cur.state = TaskState.Zombie;
    taskSchedule();
    for (;;)
        cpuHlt();
}

/// End another task (or the running one). Its resources are freed by procPoll().
void taskKill(Task* t, long code) @nogc nothrow
{
    if (t is cur)
        taskExit(code);
    if (t is &tasks[0] || t.state == TaskState.Free || t.state == TaskState.Zombie)
        return;
    t.exitCode = code;
    t.state = TaskState.Zombie;
}

// Free the zombies: address space and slot. Runs in task 0 on the kernel page tables.
void taskReap() @nogc nothrow
{
    for (uint i = 1; i < TASK_MAX; i++)
    {
        Task* t = &tasks[i];
        if (t.state != TaskState.Zombie)
            continue;

        bool wasFg = (t is fgTask);
        if (wasFg)
            fgTask = null;
        char[PROC_NAME_MAX] name;
        procCopyName(name.ptr, t.name.ptr);
        uint id = t.id;
        long code = t.exitCode;

        procFreeSpace(t.pml4Phys);
        t.pml4Phys = 0;
        if (taskDeathHook !is null)
            taskDeathHook(i, id);               // shared resources (gfxsrv.d) go back now
        t.state = TaskState.Free;

        if (taskExitHook !is null)
            taskExitHook(id, name.ptr, code, wasFg);
    }
}

/// Called from the main loop: clean up finished tasks, and Ctrl+C kills the foreground task.
void procPoll() @nogc nothrow
{
    taskReap();
    if (fgTask !is null && keyQueueHasCtrlC())
    {
        keyQueueClear();
        kprintf("^C\n");
        taskKill(fgTask, 130);
        taskReap();
    }
}

bool procHasForeground() @nogc nothrow
{
    return fgTask !is null;
}

Task* procFindId(uint id) @nogc nothrow
{
    if (id == 0)
        return null;
    for (uint i = 1; i < TASK_MAX; i++)
        if (tasks[i].state != TaskState.Free && tasks[i].state != TaskState.Zombie && tasks[i].id == id)
            return &tasks[i];
    return null;
}

/// kill ID. False if there is no such running task.
bool procKillId(uint id) @nogc nothrow
{
    Task* t = procFindId(id);
    if (t is null)
        return false;
    taskKill(t, 137);
    taskReap();
    return true;
}

/// fg [ID]: give the keyboard to a task (the newest one when id == 0). Returns its id or 0.
uint procForeground(uint id) @nogc nothrow
{
    Task* t = null;
    if (id != 0)
        t = procFindId(id);
    else
        for (uint i = 1; i < TASK_MAX; i++)
            if (tasks[i].state != TaskState.Free && tasks[i].state != TaskState.Zombie &&
                (t is null || tasks[i].id > t.id))
                t = &tasks[i];
    if (t is null)
        return 0;
    keyQueueClear();
    fgTask = t;
    return t.id;
}

void procPrintTasks() @nogc nothrow
{
    cprintf("  ID  STATE   TIME  NAME\n");
    ulong nowMs = clockNowNs() / 1_000_000UL;
    for (uint i = 1; i < TASK_MAX; i++)
    {
        Task* t = &tasks[i];
        if (t.state == TaskState.Free)
            continue;
        const(char)* st = "run";
        if (t.state == TaskState.Sleep)
            st = "sleep";
        else if (t.state == TaskState.WaitKey)
            st = "key";
        else if (t.state == TaskState.Zombie)
            st = "zombie";
        cprintf("%c %u  %s  %llu s  %s\n", t is fgTask ? '*' : ' ', t.id, st,
            (nowMs - t.startMs) / 1000, t.name.ptr);
    }
    cprintf("(* = foreground; the shell waits for it)\n");
}

extern(C) void procUserFault(InterruptFrame* f) @nogc nothrow
{
    uint v = cast(uint)f.vector;
    kprintf("\nProgram '%s' (%u) crashed: %s (vector %u) at %llx",
        cur.name.ptr, cur.id, exceptionNames[v & 31].ptr, v, f.rip);
    if (v == 14)
        kprintf(", address %llx", cpuReadCr2());
    kprintf("\n");
    taskExit(128 + v);
}

// Timer tick that interrupted ring 3 (already acknowledged): end of a time slice?
extern(C) void procUserTick(InterruptFrame* f) @nogc nothrow
{
    if (cur.pml4Phys == 0)
        return;
    if (++sliceTicks < TASK_SLICE_TICKS)
        return;
    sliceTicks = 0;
    taskSchedule();
}

/// Create a task for `prog`: address space, kernel stack, ready to run. 0 on failure.
/// The image only has to stay around until this returns (it is copied).
uint procSpawn(Program* prog, const(char)* args, bool foreground) @nogc nothrow
{
    Task* t = null;
    for (uint i = 1; i < TASK_MAX; i++)
        if (tasks[i].state == TaskState.Free)
        {
            t = &tasks[i];
            break;
        }
    if (t is null)
    {
        cprintf("run: too many running programs (max %u)\n", TASK_MAX - 1);
        return 0;
    }

    procCopyName(t.name.ptr, prog.name.ptr);
    t.pml4Phys = 0;
    if (!procBuildSpace(t, prog, args))
    {
        procFreeSpace(t.pml4Phys);
        t.pml4Phys = 0;
        return 0;
    }
    sysfileClear(t.files.ptr);

    // First switch to this task "returns" from taskSwitch into taskTrampoline.
    ulong top = taskStackTop(t);
    ulong* sp = cast(ulong*)top;
    sp[-2] = cast(ulong)taskTrampolineAddress();
    for (uint i = 3; i <= 8; i++)
        sp[-cast(int)i] = 0;                // rbx, rbp, r12..r15
    t.savedSp = top - 64;

    t.id = nextTaskId++;
    t.startMs = clockNowNs() / 1_000_000UL;
    t.exitCode = 0;
    if (foreground)
    {
        keyQueueClear();                    // keys typed before the program started are not its input
        fgTask = t;
    }
    t.state = TaskState.Ready;
    return t.id;
}

/// Start boot module `index`. Returns its task id, 0 if it could not be started.
uint procLaunch(uint index, const(char)* args, bool foreground) @nogc nothrow
{
    if (index >= programCount)
        return 0;
    return procSpawn(&programs[index], args, foreground);
}

/// Start an ELF image that is already in memory (for example read from a disk).
uint procLaunchImage(const(char)* name, const(ubyte)* image, ulong size, const(char)* args, bool foreground) @nogc nothrow
{
    Program p;
    procCopyName(p.name.ptr, name);
    p.image = image;
    p.size = size;
    return procSpawn(&p, args, foreground);
}

// System calls

// May the program read (or write) [addr, addr + len)?
bool procUserOk(ulong addr, ulong len, bool write) @nogc nothrow
{
    if (len == 0)
        return true;
    if (addr < USER_IMAGE_MIN || addr + len < addr || addr + len > USER_STACK_TOP)
        return false;

    for (ulong page = addr & ~0xFFFUL; page < addr + len; page += 4096)
    {
        ulong* pte = procPte(cur.pml4Phys, page, false);
        if (pte is null)
            return false;
        ulong e = *pte;
        if (!(e & PTE_PRESENT) || !(e & PTE_USER) || (write && !(e & PTE_RW)))
            return false;
    }
    return true;
}

// Key press -> value for the program: ASCII for text keys (Enter = 10), 0x101..0x107
// for Up, Down, Left, Right, Home, End, Delete. -1: nothing useful.
long procKeyCode(const(KeyEvent)* ev) @nogc nothrow
{
    if (ev.extended)
    {
        switch (ev.scancode)
        {
            case 0x48: return 0x101;
            case 0x50: return 0x102;
            case 0x4B: return 0x103;
            case 0x4D: return 0x104;
            case 0x47: return 0x105;
            case 0x4F: return 0x106;
            case 0x53: return 0x107;
            default: return -1;
        }
    }
    char c = keyEventChar(ev);
    if (c == 13)
        return 10;
    return (c != 0) ? c : -1;
}

long sysGetKey(bool block) @nogc nothrow
{
    for (;;)
    {
        if (cur is fgTask)
        {
            KeyEvent ev;
            while (keyPopEvent(&ev))
            {
                if (ev.ctrl && keyEventChar(&ev) == 3)
                {
                    kprintf("^C\n");
                    taskExit(130);
                }
                long k = procKeyCode(&ev);
                if (k >= 0)
                    return k;
            }
        }
        if (!block)
            return -1;
        cur.state = TaskState.WaitKey;      // woken when we are the foreground task and a key is queued
        taskSchedule();
    }
}

long sysSleep(ulong ms) @nogc nothrow
{
    ulong deadline = clockNowNs() + ms * 1_000_000UL;
    while (clockNowNs() < deadline)
    {
        cur.wakeNs = deadline;
        cur.state = TaskState.Sleep;
        taskSchedule();
    }
    return 0;
}

long sysWrite(ulong buf, ulong len) @nogc nothrow
{
    if (len > 65536)
        len = 65536;
    if (!procUserOk(buf, len, false))
        return -1;

    // A background task prints while the shell is waiting at its prompt: get the input
    // line out of the way first and bring it back afterwards.
    bool park = (cur !is fgTask) && fgTask is null && taskOutBegin !is null;
    if (park)
        taskOutBegin();

    const(ubyte)* p = cast(const(ubyte)*)buf;
    for (ulong i = 0; i < len; i++)
    {
        ubyte c = p[i];
        if (c == 8)
            consoleBack();
        else if (c == 9)
            consolePrintString("    ");
        else if (c == '\n' || c == '\r' || (c >= 32 && c < 127))
            consolePrintChar(cast(char)c);
        else
            consolePrintChar('?');
    }
    if (park)
        taskOutEnd();
    gfxPresent();
    return cast(long)len;
}

// Copy a NUL terminated string out of user memory. False if it is not mapped or too long.
bool procCopyPath(ulong addr, char* dst, uint cap) @nogc nothrow
{
    for (uint i = 0; i < cap; i++)
    {
        if (!procUserOk(addr + i, 1, false))
            return false;
        char c = *cast(const(char)*)(addr + i);
        dst[i] = c;
        if (c == 0)
            return true;
    }
    return false;
}

long sysOpen(ulong path) @nogc nothrow
{
    char[FS_PATH_MAX] p;
    if (!procCopyPath(path, p.ptr, p.length))
        return -1;
    return sysfileOpen(p.ptr);
}

long sysRead(ulong fd, ulong buf, ulong len) @nogc nothrow
{
    if (len > 1024 * 1024)
        len = 1024 * 1024;
    if (!procUserOk(buf, len, true))
        return -1;
    return sysfileRead(fd, cast(void*)buf, len);
}

long sysStat(ulong path, ulong out_) @nogc nothrow
{
    char[FS_PATH_MAX] p;
    UserStat st;
    if (!procCopyPath(path, p.ptr, p.length) || !procUserOk(out_, UserStat.sizeof, true))
        return -1;
    if (!sysfileStat(p.ptr, &st))
        return -1;
    *cast(UserStat*)out_ = st;
    return 0;
}

long sysReaddir(ulong fd, ulong out_) @nogc nothrow
{
    if (!procUserOk(out_, UserDirent.sizeof, true))
        return -1;
    return sysfileReaddir(fd, cast(UserDirent*)out_);
}

long sysGetCwd(ulong buf, ulong len) @nogc nothrow
{
    fsInitCwd();
    ulong n = 0;
    while (fsCwd[n] != 0)
        n++;
    if (n + 1 > len || !procUserOk(buf, n + 1, true))
        return -1;
    char* out_ = cast(char*)buf;
    for (ulong i = 0; i <= n; i++)
        out_[i] = fsCwd[i];
    return cast(long)n;
}

long sysDateTime(ulong out_dt) @nogc nothrow
{
    datetimeNow(cast(DateTime*)out_dt);
    return 0;
}

long sysRandom(void* buffer, size_t size) @nogc nothrow
{
    if (size == 0)
        return 0;

    if (buffer is null)
        return -1;

    auto dst = cast(ubyte*)buffer;
    size_t remaining = size;

    while (remaining >= 8)
    {
        ulong value;
        if (!rdrand64(&value))
            return cast(long)(size - remaining);
        *cast(ulong*)dst = value;
        dst += 8;
        remaining -= 8;
    }

    if (remaining > 0)
    {
        ulong value;
        if (!rdrand64(&value))
            return cast(long)(size - remaining);
        auto src = cast(ubyte*)&value;
        for (size_t i = 0; i < remaining; i++)
            dst[i] = src[i];
    }

    return cast(long)size;
}

// Called from the SYSCALL entry stub (cpu.s) on the task's kernel stack, interrupts off.
long syscallDispatch(ulong nr, ulong a0, ulong a1, ulong a2) @nogc nothrow
{
    switch (nr)
    {
        case SYS_EXIT:
            taskExit(cast(long)a0);
            return 0;
        case SYS_WRITE:
            return sysWrite(a0, a1);
        case SYS_GETKEY:
            return sysGetKey(a0 != 0);
        case SYS_SLEEP:
            return sysSleep(a0);
        case SYS_TICKS:
            return cast(long)(clockNowNs() / 1_000_000UL);
        case SYS_CLEAR:
            consoleClear();
            gfxPresent();
            return 0;
        case SYS_OPEN:
            return sysOpen(a0);
        case SYS_READ:
            return sysRead(a0, a1, a2);
        case SYS_CLOSE:
            return sysfileClose(a0);
        case SYS_SEEK:
            return sysfileSeek(a0, cast(long)a1, a2);
        case SYS_STAT:
            return sysStat(a0, a1);
        case SYS_READDIR:
            return sysReaddir(a0, a1);
        case SYS_GETCWD:
            return sysGetCwd(a0, a1);
        case SYS_BRK:
            return procSetBreak(a0);
        case SYS_YIELD:
            cur.state = TaskState.Ready;
            taskSchedule();
            return 0;
        case SYS_GETPID:
            return cur.id;
        case SYS_DATETIME:
            return sysDateTime(a0);
        case SYS_RANDOM:
            return sysRandom(cast(void*)a0, a1);
        default:
            if (nr >= SYS_EXT1 && nr < SYS_EXT1 + 1000 && syscallExtHook1 !is null)
                return syscallExtHook1(nr - SYS_EXT1, a0, a1, a2);
            if (nr >= SYS_EXT2 && nr < SYS_EXT2 + 1000 && syscallExtHook2 !is null)
                return syscallExtHook2(nr - SYS_EXT2, a0, a1, a2);
            if (nr >= SYS_EXT3 && nr < SYS_EXT3 + 1000 && syscallExtHook3 !is null)
                return syscallExtHook3(nr - SYS_EXT3, a0, a1, a2);
            if (nr >= SYS_EXT4 && nr < SYS_EXT4 + 1000 && syscallExtHook4 !is null)
                return syscallExtHook4(nr - SYS_EXT4, a0, a1, a2);
            return -1;
    }
}
