module dios.core.cmos;

import dios.core.port;

enum CMOS_ADDRESS = 0x70;
enum CMOS_DATA = 0x71;

struct CMOS
{
    ubyte[128] data;
}

enum CMOSRegister: ubyte
{
    Seconds       = 0x00,
    SecondsAlarm  = 0x01,
    Minutes       = 0x02,
    MinutesAlarm  = 0x03,
    Hours         = 0x04,
    HoursAlarm    = 0x05,
    Weekday       = 0x06,
    DayOfMonth    = 0x07,
    Month         = 0x08,
    Year          = 0x09,
    StatusA       = 0x0A,
    StatusB       = 0x0B,
    StatusC       = 0x0C,
    StatusD       = 0x0D,
    DiagStatus    = 0x0E,
    ShutdownCode  = 0x0F,
    FloppyTypes   = 0x10,
    ChecksumHigh  = 0x2E,
    ChecksumLow   = 0x2F,
    Century       = 0x32 // Standard ACPI default (verify via ACPI FADT if available)
}

struct DateTime
{
    ushort year;
    ubyte month;
    ubyte day;
    ubyte weekday;
    ubyte hour;
    ubyte minute;
    ubyte second;
}

extern(C):

void cmosRead(CMOS* cmos) @nogc nothrow
{
    size_t flags;
    asm @nogc nothrow
    {
        pushfq;
        pop flags;
        cli;
    }

    // Wait for RTC update to end
    do
    {
        kPortWriteByte(CMOS_ADDRESS, 0x0A);
    }
    while (kPortReadByte(CMOS_DATA) & 0x80);

    foreach (ubyte index; 0..128)
    {
        kPortWriteByte(CMOS_ADDRESS, index); // Bit 7 is 0, so NMI remains active
        kPortWriteByte(0x80, 0); // I/O bus delay
        cmos.data[index] = kPortReadByte(CMOS_DATA);
    }

    asm @nogc nothrow
    {
        push flags;
        popfq;
    }
}

ubyte bcdToBin(ubyte val) pure @nogc nothrow
{
    return cast(ubyte)((val & 0x0F) + ((val >> 4) * 10));
}

DateTime cmosGetDateTime(const(CMOS)* cmos) pure @nogc nothrow
{
    DateTime dt;

    ubyte sec   = cmos.data[CMOSRegister.Seconds];
    ubyte min   = cmos.data[CMOSRegister.Minutes];
    ubyte hour  = cmos.data[CMOSRegister.Hours];
    ubyte wday  = cmos.data[CMOSRegister.Weekday];
    ubyte day   = cmos.data[CMOSRegister.DayOfMonth];
    ubyte month = cmos.data[CMOSRegister.Month];
    ubyte year  = cmos.data[CMOSRegister.Year];
    ubyte century = cmos.data[CMOSRegister.Century];

    ubyte regB  = cmos.data[CMOSRegister.StatusB];
    bool isBinary = (regB & 0x04) != 0;
    bool is24Hour = (regB & 0x02) != 0;

    // Extract PM flag before converting hours from BCD
    bool isPM = !is24Hour && ((hour & 0x80) != 0);
    if (!is24Hour)
    {
        hour &= 0x7F; // Clear PM bit
    }

    if (!isBinary)
    {
        sec   = bcdToBin(sec);
        min   = bcdToBin(min);
        hour  = bcdToBin(hour);
        wday  = bcdToBin(wday);
        day   = bcdToBin(day);
        month = bcdToBin(month);
        year  = bcdToBin(year);
        century = bcdToBin(century);
    }

    // Convert 12-hour clock to 24-hour clock
    if (!is24Hour)
    {
        if (isPM && hour < 12)
            hour += 12;
        else if (!isPM && hour == 12)
            hour = 0;
    }

    dt.second  = sec;
    dt.minute  = min;
    dt.hour    = hour;
    dt.weekday = wday;
    dt.day     = day;
    dt.month   = month;

    // Fallback to 2000s if century register (0x32) is unpopulated (0 or 0xFF)
    if (century >= 19 && century <= 21)
        dt.year = cast(ushort)(century * 100 + year);
    else
        dt.year = cast(ushort)(2000 + year);

    return dt;
}
