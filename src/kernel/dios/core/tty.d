module dios.core.tty;

/**
 * Output channels ("ttys") for the standard output of user programs.
 *
 * Every task has a stdout target (Task.stdoutId in proc.d):
 *   0            the kernel console - what the kernel shell shows. This is the default.
 *   N > 0        the channel N: bytes go into a ring buffer owned by a user program (a
 *                terminal), which reads them with SYS_TTY_READ and shows them however it likes.
 *
 * The kernel never interprets the bytes of a channel: what 8 (backspace), 12 (clear screen),
 * '\n' and the like mean is up to the terminal. (SYS_CLEAR on a channel writes a 12.)
 *
 * This module is only the buffers and the bookkeeping; it knows nothing about tasks apart
 * from their ids, so it imports nothing. Waiting for room in a full buffer is done by the
 * caller (proc.d), which can sleep.
 *
 * A channel goes away when its reader closes it or exits. Writers that are still around
 * then get -1 from every write, and their output is dropped. Ids are never reused, so a
 * stale id can never reach somebody else's channel.
 *
 * All of this runs in the kernel's single-threaded, non-preemptive context: no locks.
 */

enum uint TTY_MAX = 4;                  // channels at the same time
enum uint TTY_BUF_SIZE = 4096;          // bytes per channel, power of two
enum uint TTY_CONSOLE = 0;              // stdoutId of the kernel console

struct Tty
{
    bool used;
    uint id;                            // never reused, > 0
    uint readerId;                      // id of the task that reads it (and may close it)
    uint writers;                       // live tasks whose stdout is this channel
    uint head;                          // free-running indexes: head - tail bytes are waiting
    uint tail;
    ubyte[TTY_BUF_SIZE] buf;
}

__gshared Tty[TTY_MAX] ttys;
__gshared uint ttyNextId = 1;

extern(C):

Tty* ttyFind(uint id) @nogc nothrow
{
    if (id == TTY_CONSOLE)
        return null;
    for (uint i = 0; i < TTY_MAX; i++)
        if (ttys[i].used && ttys[i].id == id)
            return &ttys[i];
    return null;
}

/// New channel read by task `readerId`. Returns its id, 0 if there is no room.
uint ttyCreate(uint readerId) @nogc nothrow
{
    for (uint i = 0; i < TTY_MAX; i++)
    {
        if (ttys[i].used)
            continue;
        Tty* t = &ttys[i];
        t.used = true;
        t.id = ttyNextId++;
        t.readerId = readerId;
        t.writers = 0;
        t.head = 0;
        t.tail = 0;
        return t.id;
    }
    return 0;
}

/// Is `taskId` the reader of channel `id`?
bool ttyIsReader(uint id, uint taskId) @nogc nothrow
{
    Tty* t = ttyFind(id);
    return t !is null && t.readerId == taskId;
}

bool ttyExists(uint id) @nogc nothrow
{
    return ttyFind(id) !is null;
}

/// Close channel `id`. Whatever is in it is dropped.
void ttyClose(uint id) @nogc nothrow
{
    Tty* t = ttyFind(id);
    if (t !is null)
        t.used = false;
}

/// A task died: close the channels it was reading.
void ttyReaderGone(uint taskId) @nogc nothrow
{
    for (uint i = 0; i < TTY_MAX; i++)
        if (ttys[i].used && ttys[i].readerId == taskId)
            ttys[i].used = false;
}

/// A task whose stdout is `id` was started / has ended. (No-ops for the console and for
/// channels that are already closed.)
void ttyAddWriter(uint id) @nogc nothrow
{
    Tty* t = ttyFind(id);
    if (t !is null)
        t.writers++;
}

void ttyDropWriter(uint id) @nogc nothrow
{
    Tty* t = ttyFind(id);
    if (t !is null && t.writers != 0)
        t.writers--;
}

/// Number of live tasks writing to the channel, -1 if there is no such channel.
long ttyWriters(uint id) @nogc nothrow
{
    Tty* t = ttyFind(id);
    return (t is null) ? -1 : cast(long)t.writers;
}

/// Bytes waiting to be read, -1 if there is no such channel.
long ttyPending(uint id) @nogc nothrow
{
    Tty* t = ttyFind(id);
    return (t is null) ? -1 : cast(long)(t.head - t.tail);
}

/// Append as much of src[0 .. n] as fits. Returns the number of bytes taken (0: full),
/// -1 if the channel does not exist (any more).
long ttyPut(uint id, const(ubyte)* src, ulong n) @nogc nothrow
{
    Tty* t = ttyFind(id);
    if (t is null)
        return -1;
    ulong room = TTY_BUF_SIZE - (t.head - t.tail);
    if (n > room)
        n = room;
    for (ulong i = 0; i < n; i++)
        t.buf[(t.head + cast(uint)i) & (TTY_BUF_SIZE - 1)] = src[i];
    t.head += cast(uint)n;
    return cast(long)n;
}

/// Take up to n bytes out of the channel. Returns the count (0: nothing waiting), -1 if the
/// channel does not exist.
long ttyGet(uint id, ubyte* dst, ulong n) @nogc nothrow
{
    Tty* t = ttyFind(id);
    if (t is null)
        return -1;
    ulong have = t.head - t.tail;
    if (n > have)
        n = have;
    for (ulong i = 0; i < n; i++)
        dst[i] = t.buf[(t.tail + cast(uint)i) & (TTY_BUF_SIZE - 1)];
    t.tail += cast(uint)n;
    return cast(long)n;
}
