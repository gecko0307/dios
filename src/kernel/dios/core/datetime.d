module dios.core.datetime;

import dios.core.cmos;
import dios.core.clock;

struct DateTime
{
    ushort year;
    ubyte month;
    ubyte day;
    ubyte weekday;
    ubyte hour;
    ubyte minute;
    ubyte second;
}

__gshared
{
    CMOS cmos;
    DateTime startTime;
    ulong startTicks;
}

extern(C):

void datetimeInit() @nogc nothrow
{
    cmosRead(&cmos);
    startTime = datetimeGetFromCMOS(&cmos);
    startTicks = clockNowNs();
}

void datetimeNow(DateTime* outDateTime) @nogc nothrow
{
    ulong elapsed = (clockNowNs() - startTicks) / 1_000_000_000;

    // Seconds since midnight at system startup
    ulong startSeconds =
        startTime.hour * 3600UL +
        startTime.minute * 60UL +
        startTime.second;

    // Total seconds since midnight
    ulong totalSeconds = startSeconds + elapsed;

    ulong days = totalSeconds / 86400;

    outDateTime.hour = cast(ubyte)((totalSeconds / 3600) % 24);
    outDateTime.minute = cast(ubyte)((totalSeconds / 60) % 60);
    outDateTime.second = cast(ubyte)(totalSeconds % 60);

    // Weekday
    outDateTime.weekday = cast(ubyte)(
        ((startTime.weekday - 1 + days) % 7) + 1
    );

    // Calendar date
    outDateTime.year = startTime.year;
    outDateTime.month = startTime.month;
    outDateTime.day = startTime.day;

    while (days > 0)
    {
        ubyte remaining = cast(ubyte)(
            daysInMonth(outDateTime.year, outDateTime.month)
            - outDateTime.day + 1
        );

        if (days < remaining)
        {
            outDateTime.day += cast(ubyte)days;
            break;
        }

        days -= remaining;
        outDateTime.day = 1;

        outDateTime.month++;

        if (outDateTime.month > 12)
        {
            outDateTime.month = 1;
            outDateTime.year++;
        }
    }
}

bool isLeapYear(ushort year) pure @nogc nothrow
{
    return (year % 4 == 0) &&
           ((year % 100 != 0) || (year % 400 == 0));
}

private static immutable(ubyte)[12] days = [
    31, 28, 31, 30, 31, 30,
    31, 31, 30, 31, 30, 31
];

ubyte daysInMonth(ushort year, ubyte month) pure @nogc nothrow
{
    if (month == 2 && isLeapYear(year))
        return 29;

    if (month >= 1 && month <= 12)
        return days[month - 1];

    return 0;
}

DateTime datetimeGetFromCMOS(const(CMOS)* cmos) pure @nogc nothrow
{
    DateTime dt;

    ubyte sec   = cmos.data[CMOSRegister.Seconds];
    ubyte min   = cmos.data[CMOSRegister.Minutes];
    ubyte hour  = cmos.data[CMOSRegister.Hours];
    ubyte wday  = cmos.data[CMOSRegister.Weekday];
    ubyte day   = cmos.data[CMOSRegister.DayOfMonth];
    ubyte month = cmos.data[CMOSRegister.Month];
    ubyte year  = cmos.data[CMOSRegister.Year];
    ubyte century = cmos.data[CMOSRegister.Century];

    ubyte regB  = cmos.data[CMOSRegister.StatusB];
    bool isBinary = (regB & 0x04) != 0;
    bool is24Hour = (regB & 0x02) != 0;

    // Extract PM flag before converting hours from BCD
    bool isPM = !is24Hour && ((hour & 0x80) != 0);
    if (!is24Hour)
    {
        hour &= 0x7F; // Clear PM bit
    }

    if (!isBinary)
    {
        sec   = bcdToBin(sec);
        min   = bcdToBin(min);
        hour  = bcdToBin(hour);
        wday  = bcdToBin(wday);
        day   = bcdToBin(day);
        month = bcdToBin(month);
        year  = bcdToBin(year);
        century = bcdToBin(century);
    }

    // Convert 12-hour clock to 24-hour clock
    if (!is24Hour)
    {
        if (isPM && hour < 12)
            hour += 12;
        else if (!isPM && hour == 12)
            hour = 0;
    }

    dt.second  = sec;
    dt.minute  = min;
    dt.hour    = hour;
    dt.weekday = wday;
    dt.day     = day;
    dt.month   = month;

    // Fallback to 2000s if century register (0x32) is unpopulated (0 or 0xFF)
    if (century >= 19 && century <= 21)
        dt.year = cast(ushort)(century * 100 + year);
    else
        dt.year = cast(ushort)(2000 + year);

    return dt;
}

ubyte bcdToBin(ubyte val) pure @nogc nothrow
{
    return cast(ubyte)((val & 0x0F) + ((val >> 4) * 10));
}
