{
    "name": "hello",
    "description": "Simple DIOS application",
    "homepage": "",
    "license": "Unlicense",
    "authors": [
        "Timur Gafarov"
    ],
    
    "importPaths": [
        "src", "../../src/ulib"
    ],
    
    "sourcePaths": [
        "src", "../../src/ulib"
    ],
    
    "buildRequirements": [
        "allowWarnings"
    ],
    
    "targetType": "executable",
    "targetName": "hello.elf",
    
    "dflags-ldc": [
        "-mtriple=x86_64-none-elf",
        "-nodefaultlib",
        "--boundscheck=off",
        "--disable-red-zone",
        "--use-ctors=0",
        "--fno-exceptions",
        "--nogc",
        "-O0",
        "-link-internally",
        "-defaultlib="
    ],

    "lflags": [
        "-m", "elf_x86_64",
        "-T", "linker.ld",
        "-z", "max-page-size=0x1000",
        "-static",
        "--gc-sections",
        "-u", "_start",
        "../../libulib.a"
    ],
    
    "postBuildCommands-windows": [
        "move /Y hello.elf.exe hello.elf",
        "if not exist ..\\..\\usbstick mkdir ..\\..\\usbstick",
        "copy /Y hello.elf ..\\..\\usbstick\\hello.elf"
    ]
}
